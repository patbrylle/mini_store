@model IEnumerable<mini_store.Models.Sale>

@{
ViewData["Title"] = "Sales";

var sales = Model?.ToList() ?? new List<mini_store.Models.Sale>();

var utangsBySaleId = ViewBag.UtangsBySaleId as Dictionary<int, mini_store.Models.Utang>
    ?? new Dictionary<int, mini_store.Models.Utang>();

string StatusKey(mini_store.Models.Sale s) =>
    s.Status?.ToLower() switch
    {
        "paid" => "paid",
        "partial" => "partial",
        _ => "unpaid"
    };

decimal totalSales = sales.Sum(s => s.TotalAmount);
int totalTransactions = sales.Count;

// Cap paid amount at the sale total so change does not count as sales income.
decimal paidSales = sales.Sum(s => Math.Min(s.AmountPaid, s.TotalAmount));

decimal outstanding = sales.Sum(
    s => Math.Max(0, s.TotalAmount - s.AmountPaid)
);

int paidCount = sales.Count(s => StatusKey(s) == "paid");
int partialCount = sales.Count(s => StatusKey(s) == "partial");
int unpaidCount = sales.Count(s => StatusKey(s) == "unpaid");

var transactionType = Context.Request.Query["transactionType"].ToString();

bool openUtang = string.Equals(
    transactionType,
    "Utang",
    StringComparison.OrdinalIgnoreCase
);

}

@section Styles { <link rel="stylesheet"
       href="~/css/sales.css"
       asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/utang.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/sales-modern.css"
      asp-append-version="true" />

}

<div class="sales-page">

<!-- =========================================================
     HEADER
========================================================== -->

<div class="sales-header">

    <div class="sales-title-area">

        <div class="sales-page-icon">
            <i class="bi bi-receipt"></i>
        </div>

        <div>
            <h1>Sales</h1>
            <p>Manage your store sales and transactions.</p>
        </div>

    </div>

    <button type="button"
            class="btn sales-new-btn"
            data-bs-toggle="modal"
            data-bs-target="#newSaleModal">

        <i class="bi bi-plus-lg me-1"></i>
        New Transaction

    </button>

</div>


<!-- =========================================================
     SUMMARY CARDS
========================================================== -->

<div class="row g-3 mb-4">

    <!-- Total Sales -->
    <div class="col-xl-3 col-md-6">

        <div class="sales-summary-card is-primary"
             style="--i:0">

            <div class="sales-summary-icon">
                <i class="bi bi-cash-stack"></i>
            </div>

            <div>
                <span>Total Sales</span>

                <h3>
                    ₱@totalSales.ToString("N2")
                </h3>
            </div>

        </div>

    </div>


    <!-- Transactions -->
    <div class="col-xl-3 col-md-6">

        <div class="sales-summary-card is-gold"
             style="--i:1">

            <div class="sales-summary-icon">
                <i class="bi bi-receipt-cutoff"></i>
            </div>

            <div>
                <span>Transactions</span>

                <h3>
                    @totalTransactions
                </h3>
            </div>

        </div>

    </div>


    <!-- Paid Sales -->
    <div class="col-xl-3 col-md-6">

        <div class="sales-summary-card is-success"
             style="--i:2">

            <div class="sales-summary-icon">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <span>Paid Sales</span>

                <h3>
                    ₱@paidSales.ToString("N2")
                </h3>
            </div>

        </div>

    </div>


    <!-- Outstanding -->
    <div class="col-xl-3 col-md-6">

        <div class="sales-summary-card is-danger"
             style="--i:3">

            <div class="sales-summary-icon">
                <i class="bi bi-wallet2"></i>
            </div>

            <div>
                <span>Outstanding</span>

                <h3>
                    ₱@outstanding.ToString("N2")
                </h3>
            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     SALES TABLE
========================================================== -->

<div class="sales-table-card">

    <div class="sales-table-header">

        <div>
            <h5>Sales Transactions</h5>
            <p>View and manage your completed transactions.</p>
        </div>

        <div class="sales-search">

            <i class="bi bi-search"></i>

            <input type="text"
                   id="salesSearch"
                   placeholder="Search sales..."
                   aria-label="Search sales"
                   autocomplete="off" />

        </div>

    </div>


    <!-- STATUS FILTERS -->

    <div class="sales-filters"
         id="statusFilters"
         role="group"
         aria-label="Filter by status">

        <button type="button"
                class="filter-chip active"
                data-filter="all"
                aria-pressed="true">

            All
            <span>@totalTransactions</span>

        </button>

        <button type="button"
                class="filter-chip"
                data-filter="paid"
                aria-pressed="false">

            Paid
            <span>@paidCount</span>

        </button>

        <button type="button"
                class="filter-chip"
                data-filter="partial"
                aria-pressed="false">

            Partial
            <span>@partialCount</span>

        </button>

        <button type="button"
                class="filter-chip"
                data-filter="unpaid"
                aria-pressed="false">

            Unpaid
            <span>@unpaidCount</span>

        </button>

    </div>


    <!-- TABLE -->

    <div class="table-responsive">

        <table class="table sales-table"
               id="salesTable">

            <thead>

                <tr>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Paid</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>

            </thead>


            <tbody>

                @if (sales.Any())
                {
                    foreach (var sale in sales)
                    {
                        string statusClass = StatusKey(sale);

                        int itemCount =
                            sale.SaleItems?.Sum(i => i.Quantity) ?? 0;

                        decimal rowBalance =
                            Math.Max(
                                0,
                                sale.TotalAmount - sale.AmountPaid
                            );

                        bool isWalkIn =
                            sale.Customer == null;

                        string customerName =
                            sale.Customer?.CustomerName
                            ?? "Walk-in Customer";

                        string initial =
                            !isWalkIn && customerName.Length > 0
                                ? customerName.Substring(0, 1).ToUpper()
                                : "";

                        <tr data-status="@statusClass">

                            <!-- DATE -->

                            <td>

                                <strong>
                                    @sale.SaleDate.ToString("MMM dd, yyyy")
                                </strong>

                                <small>
                                    @sale.SaleDate.ToString("hh:mm tt")
                                </small>

                            </td>


                            <!-- CUSTOMER -->

                            <td>

                                <div class="sales-customer">

                                    <div class="sales-customer-icon @(isWalkIn ? "walkin" : "")">

                                        @if (isWalkIn)
                                        {
                                            <i class="bi bi-person"></i>
                                        }
                                        else
                                        {
                                            <span>@initial</span>
                                        }

                                    </div>

                                    <div>
                                        <strong>
                                            @customerName
                                        </strong>
                                    </div>

                                </div>

                            </td>


                            <!-- ITEMS -->

                            <td>

                                <span class="items-count">

                                    @itemCount
                                    item@(itemCount != 1 ? "s" : "")

                                </span>

                            </td>


                            <!-- TOTAL -->

                            <td>

                                <strong>
                                    ₱@sale.TotalAmount.ToString("N2")
                                </strong>

                            </td>


                            <!-- PAID -->

                            <td>

                                <strong>
                                    ₱@sale.AmountPaid.ToString("N2")
                                </strong>

                                @if (rowBalance > 0)
                                {
                                    <small class="balance-hint">
                                        ₱@rowBalance.ToString("N2") due
                                    </small>
                                }

                            </td>


                            <!-- STATUS -->

                            <td>

                                <span class="sale-status @statusClass">

                                    <span></span>

                                    @(string.IsNullOrWhiteSpace(sale.Status)
                                        ? "Unpaid"
                                        : sale.Status)

                                </span>

                            </td>


                            <!-- ACTIONS -->

                            <td>

                                <div class="sales-actions">

                                    @if (
                                        sale.Status?.Equals(
                                            "Unpaid",
                                            StringComparison.OrdinalIgnoreCase
                                        ) == true
                                        &&
                                        utangsBySaleId.TryGetValue(
                                            sale.SaleId,
                                            out var matchingUtang
                                        )
                                    )
                                    {
                                        <button type="button"
                                                class="btn view-utang-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#utangDetailsModal-@matchingUtang.UtangId">

                                            <i class="bi bi-eye me-1"></i>
                                            View

                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn sales-view-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#saleDetailsModal-@sale.SaleId">

                                            <i class="bi bi-eye me-1"></i>
                                            View

                                        </button>
                                    }


                                    @if (statusClass == "paid")
                                    {
                                        <button type="button"
                                                class="btn sales-delete-btn"
                                                title="Delete sale"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteSaleModal-@sale.SaleId">

                                            <i class="bi bi-trash"></i>

                                        </button>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7">

                            <div class="sales-empty">

                                <i class="bi bi-receipt"></i>

                                <strong>
                                    No sales transactions yet.
                                </strong>

                                <span>
                                    Completed sales will show up here.
                                </span>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- NO SEARCH/FILTER RESULTS -->

    <div class="sales-empty"
         id="noResults"
         hidden>

        <i class="bi bi-search"></i>

        <strong>
            No matching sales.
        </strong>

        <span>
            Try a different search or filter.
        </span>

    </div>

</div>
```

</div>

