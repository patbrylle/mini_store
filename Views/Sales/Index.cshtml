@using mini_store.Models
@model IEnumerable<mini_store.Models.Sale>

@{
    ViewData["Title"] = "Sales";

    var sales = Model?.ToList() ?? new List<Sale>();

    decimal totalSales = sales.Sum(s => s.TotalAmount);
    decimal paidSales = sales.Sum(s => Math.Min(s.AmountPaid, s.TotalAmount));
    decimal outstanding = sales.Sum(s => Math.Max(0, s.TotalAmount - s.AmountPaid));

    int paidCount = sales.Count(s => TxStatus.Key(s.Status) == "paid");
    int partialCount = sales.Count(s => TxStatus.Key(s.Status) == "partial");
    int unpaidCount = sales.Count(s => TxStatus.Key(s.Status) == "unpaid");

    bool openUtang = string.Equals(
        Context.Request.Query["transactionType"].ToString(), "Utang",
        StringComparison.OrdinalIgnoreCase);
}

@section Styles {
    <link rel="stylesheet" href="~/css/sales.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sales-modern.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/transactions.css" asp-append-version="true" />
}

<div class="sales-page">

    <div class="sales-header">
        <div class="sales-title-area">
            <div class="sales-page-icon"><i class="bi bi-receipt"></i></div>
            <div>
                <h1>Sales</h1>
                <p>Manage your store sales and transactions.</p>
            </div>
        </div>

        <button type="button" class="btn sales-new-btn" data-bs-toggle="modal" data-bs-target="#newSaleModal">
            <i class="bi bi-plus-lg me-1"></i> New Transaction
        </button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="sales-summary-card is-primary" style="--i:0">
                <div class="sales-summary-icon"><i class="bi bi-cash-stack"></i></div>
                <div><span>Total Sales</span><h3>₱@totalSales.ToString("N2")</h3></div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sales-summary-card is-gold" style="--i:1">
                <div class="sales-summary-icon"><i class="bi bi-receipt-cutoff"></i></div>
                <div><span>Transactions</span><h3>@sales.Count</h3></div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sales-summary-card is-success" style="--i:2">
                <div class="sales-summary-icon"><i class="bi bi-check-circle"></i></div>
                <div><span>Collected</span><h3>₱@paidSales.ToString("N2")</h3></div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sales-summary-card is-danger" style="--i:3">
                <div class="sales-summary-icon"><i class="bi bi-wallet2"></i></div>
                <div><span>Outstanding</span><h3>₱@outstanding.ToString("N2")</h3></div>
            </div>
        </div>
    </div>

    <div class="sales-table-card">

        <div class="sales-table-header">
            <div>
                <h5>Sales Transactions</h5>
                <p>Open a row to see items, payments and receipts.</p>
            </div>
            <div class="sales-search">
                <i class="bi bi-search"></i>
                <input type="text" id="salesSearch" placeholder="Search sales or TXN no…" aria-label="Search sales" autocomplete="off" />
            </div>
        </div>

        <div class="sales-filters" id="statusFilters" role="group" aria-label="Filter by status">
            <button type="button" class="filter-chip active" data-filter="all" aria-pressed="true">All <span>@sales.Count</span></button>
            <button type="button" class="filter-chip" data-filter="paid" aria-pressed="false">Paid <span>@paidCount</span></button>
            <button type="button" class="filter-chip" data-filter="partial" aria-pressed="false">Partial <span>@partialCount</span></button>
            <button type="button" class="filter-chip" data-filter="unpaid" aria-pressed="false">Unpaid <span>@unpaidCount</span></button>
        </div>

        <div class="table-responsive">
            <table class="table sales-table" id="salesTable">
                <thead>
                    <tr>
                        <th>Date</th><th>Customer</th><th>Items</th><th>Total</th><th>Paid</th><th>Status</th><th>Action</th>
                    </tr>
                </thead>
                <tbody>
                @if (sales.Any())
                {
                    foreach (var sale in sales)
                    {
                        var key = TxStatus.Key(sale.Status);
                        var itemCount = sale.SaleItems.Sum(i => i.Quantity);
                        var balance = Math.Max(0, sale.TotalAmount - sale.AmountPaid);
                        var isWalkIn = sale.Customer == null;
                        var customerName = sale.Customer?.CustomerName ?? "Walk-in Customer";

                        <tr data-status="@key">
                            <td>
                                <strong>@sale.SaleDate.ToString("MMM dd, yyyy")</strong>
                                <small>@sale.SaleDate.ToString("hh:mm tt") · @sale.TransactionNo</small>
                            </td>
                            <td>
                                <div class="sales-customer">
                                    <div class="sales-customer-icon @(isWalkIn ? "walkin" : "")">
                                        @if (isWalkIn) { <i class="bi bi-person"></i> }
                                        else { <span>@customerName.Substring(0, 1).ToUpper()</span> }
                                    </div>
                                    <strong>@customerName</strong>
                                </div>
                            </td>
                            <td><span class="items-count">@itemCount item@(itemCount != 1 ? "s" : "")</span></td>
                            <td><strong>₱@sale.TotalAmount.ToString("N2")</strong></td>
                            <td>
                                <strong>₱@Math.Min(sale.AmountPaid, sale.TotalAmount).ToString("N2")</strong>
                                @if (balance > 0) { <small class="balance-hint">₱@balance.ToString("N2") due</small> }
                            </td>
                            <td>
                                <span class="sale-status @key"><span></span>@(string.IsNullOrWhiteSpace(sale.Status) ? "Unpaid" : sale.Status)</span>
                            </td>
                            <td>
                                <div class="sales-actions">
                                    <button type="button" class="btn @(balance > 0 ? "view-utang-btn" : "sales-view-btn")" data-tx-view="@sale.SaleId">
                                        <i class="bi @(balance > 0 ? "bi-cash-coin" : "bi-eye") me-1"></i>@(balance > 0 ? "Pay" : "View")
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="sales-empty">
                                <i class="bi bi-receipt"></i>
                                <strong>No sales transactions yet.</strong>
                                <span>Completed sales will show up here.</span>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="sales-empty" id="noResults" hidden>
            <i class="bi bi-search"></i>
            <strong>No matching sales.</strong>
            <span>Try a different search or filter.</span>
        </div>
    </div>
</div>

@{
    ViewData["ReturnTo"] = "Sales";
    ViewData["DefaultTransactionType"] = openUtang ? "Utang" : "Cash";
}
<partial name="_TransactionModal" model="(mini_store.Models.TransactionFormData)ViewBag.Form" />

@section Scripts {
    <script src="~/js/transactions.js" asp-append-version="true"></script>

    <script>
        // Open the modal when ?new=true is present
        document.addEventListener("DOMContentLoaded", function () {
            var params = new URLSearchParams(window.location.search);
            if (params.get("new") === "true") {
                var el = document.getElementById("newSaleModal");
                if (el && window.bootstrap) bootstrap.Modal.getOrCreateInstance(el).show();
                params.delete("new");
                var qs = params.toString();
                history.replaceState({}, "", window.location.pathname + (qs ? "?" + qs : ""));
            }
        });

        // Search + status filter
        (function () {
            var table = document.getElementById("salesTable");
            if (!table) return;

            var rows = Array.from(table.querySelectorAll("tbody tr[data-status]"));
            var chips = document.querySelectorAll("#statusFilters .filter-chip");
            var noResults = document.getElementById("noResults");
            var search = document.getElementById("salesSearch");
            var filter = "all", term = "";

            function refresh() {
                var visible = 0;
                rows.forEach(function (row) {
                    var ok = (filter === "all" || row.dataset.status === filter) &&
                             row.textContent.toLowerCase().includes(term);
                    row.classList.toggle("is-filtered-out", !ok);
                    if (ok) visible++;
                });
                if (noResults) noResults.hidden = visible !== 0 || rows.length === 0;
            }

            chips.forEach(function (chip) {
                chip.addEventListener("click", function () {
                    filter = chip.dataset.filter || "all";
                    chips.forEach(function (c) {
                        c.classList.toggle("active", c === chip);
                        c.setAttribute("aria-pressed", c === chip ? "true" : "false");
                    });
                    refresh();
                });
            });

            if (search) search.addEventListener("input", function () {
                term = search.value.trim().toLowerCase();
                refresh();
            });
        })();
    </script>
}