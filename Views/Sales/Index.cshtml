{ <partial name="UtangDetailsModal"
              model="matchingUtang" />
}
}

@section Scripts {

<script src="~/js/sales.js"
        asp-append-version="true">
</script>


<script>

    // ========================================================
    // STATUS FILTERS
    // ========================================================

    (function () {

        var table =
            document.getElementById('salesTable');

        if (!table) {
            return;
        }


        var rows =
            Array.prototype.slice.call(
                table.querySelectorAll(
                    'tbody tr[data-status]'
                )
            );

        if (!rows.length) {
            return;
        }


        var chips =
            document.querySelectorAll(
                '#statusFilters .filter-chip'
            );


        var noResults =
            document.getElementById('noResults');


        var search =
            document.getElementById('salesSearch');


        function refresh() {

            var visible =
                rows.filter(function (row) {

                    return window.getComputedStyle(row).display !== 'none';

                }).length;


            if (noResults) {

                noResults.hidden =
                    visible !== 0;

            }

        }


        chips.forEach(function (chip) {

            chip.addEventListener(
                'click',
                function () {

                    var filter =
                        chip.dataset.filter;


                    chips.forEach(function (currentChip) {

                        var active =
                            currentChip === chip;


                        currentChip.classList.toggle(
                            'active',
                            active
                        );


                        currentChip.setAttribute(
                            'aria-pressed',
                            active ? 'true' : 'false'
                        );

                    });


                    rows.forEach(function (row) {

                        row.classList.toggle(
                            'is-filtered-out',
                            filter !== 'all'
                            &&
                            row.dataset.status !== filter
                        );

                    });


                    refresh();

                }
            );

        });


        if (search) {

            search.addEventListener(
                'input',
                function () {

                    setTimeout(
                        refresh,
                        0
                    );

                }
            );

        }

    })();

</script>

}
