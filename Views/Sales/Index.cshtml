@model IEnumerable<mini_store.Models.Sale>

@{
    ViewData["Title"] = "Sales";

    var sales = Model?.ToList() ?? new List<mini_store.Models.Sale>();
    var utangsBySaleId = ViewBag.UtangsBySaleId as Dictionary<int, mini_store.Models.Utang>
        ?? new Dictionary<int, mini_store.Models.Utang>();

    decimal totalSales = sales.Sum(s => s.TotalAmount);
    int totalTransactions = sales.Count;
    decimal paidSales = sales.Sum(s => s.AmountPaid);
    decimal outstanding = sales.Sum(s => Math.Max(0, s.TotalAmount - s.AmountPaid));

    var transactionType = Context.Request.Query["transactionType"].ToString();
    bool openUtang = string.Equals(transactionType, "Utang", StringComparison.OrdinalIgnoreCase);
}

@section Styles {
    <link rel="stylesheet" href="~/css/sales.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/utang.css" asp-append-version="true" />
}

<div class="sales-page">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="sales-header">

        <div class="sales-title-area">

            <div class="sales-page-icon">
                <i class="bi bi-receipt"></i>
            </div>

            <div>
                <h1>Sales</h1>
                <p>Manage your store sales and transactions.</p>
            </div>

        </div>

        <button type="button"
                class="btn sales-new-btn"
                data-bs-toggle="modal"
                data-bs-target="#newSaleModal">

            <i class="bi bi-plus-lg me-1"></i>
            New Transaction

        </button>

    </div>


    <!-- =====================================================
         SUMMARY CARDS
    ====================================================== -->

    <div class="row g-3 mb-4">

        <!-- Total Sales -->
        <div class="col-xl-3 col-md-6">

            <div class="sales-summary-card">

                <div class="sales-summary-icon sales-icon-blue">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <div>
                    <span>Total Sales</span>
                    <h3>₱@totalSales.ToString("N2")</h3>
                </div>

            </div>

        </div>


        <!-- Transactions -->
        <div class="col-xl-3 col-md-6">

            <div class="sales-summary-card">

                <div class="sales-summary-icon sales-icon-purple">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>

                <div>
                    <span>Transactions</span>
                    <h3>@totalTransactions</h3>
                </div>

            </div>

        </div>


        <!-- Paid Sales -->
        <div class="col-xl-3 col-md-6">

            <div class="sales-summary-card">

                <div class="sales-summary-icon sales-icon-green">
                    <i class="bi bi-check-circle"></i>
                </div>

                <div>
                    <span>Paid Sales</span>
                    <h3>₱@paidSales.ToString("N2")</h3>
                </div>

            </div>

        </div>


        <!-- Outstanding -->
        <div class="col-xl-3 col-md-6">

            <div class="sales-summary-card">

                <div class="sales-summary-icon sales-icon-red">
                    <i class="bi bi-wallet2"></i>
                </div>

                <div>
                    <span>Outstanding</span>
                    <h3>₱@outstanding.ToString("N2")</h3>
                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         SALES TABLE
    ====================================================== -->

    <div class="sales-table-card">

        <div class="sales-table-header">

            <div>
                <h5>Sales Transactions</h5>
                <p>View and manage your completed transactions.</p>
            </div>

            <div class="sales-search">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="salesSearch"
                       placeholder="Search sales..." />

            </div>

        </div>


        <div class="table-responsive">

            <table class="table sales-table"
                   id="salesTable">

                <thead>

                    <tr>

                        <th>Date</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Paid</th>
                        <th>Status</th>
                        <th>Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (sales.Any())
                    {
                        foreach (var sale in sales)
                        {
                            string statusClass =
                                sale.Status?.ToLower() switch
                                {
                                    "paid" => "paid",
                                    "partial" => "partial",
                                    "unpaid" => "unpaid",
                                    _ => "unpaid"
                                };

                            int itemCount =
                                sale.SaleItems?.Sum(i => i.Quantity) ?? 0;

                            <tr>

                                <!-- Date -->

                                <td>

                                    <strong>
                                        @sale.SaleDate.ToString("MMM dd, yyyy")
                                    </strong>

                                    <small>
                                        @sale.SaleDate.ToString("hh:mm tt")
                                    </small>

                                </td>


                                <!-- Customer -->

                                <td>

                                    <div class="sales-customer">

                                        <div class="sales-customer-icon">
                                            <i class="bi bi-person"></i>
                                        </div>

                                        <div>

                                            @if (sale.Customer != null)
                                            {
                                                <strong>
                                                    @sale.Customer.CustomerName
                                                </strong>
                                            }
                                            else
                                            {
                                                <strong>
                                                    Walk-in Customer
                                                </strong>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- Items -->

                                <td>

                                    <span class="items-count">
                                        @itemCount item@(itemCount != 1 ? "s" : "")
                                    </span>

                                </td>


                                <!-- Total -->

                                <td>

                                    <strong>
                                        ₱@sale.TotalAmount.ToString("N2")
                                    </strong>

                                </td>


                                <!-- Paid -->

                                <td>

                                    <strong>
                                        ₱@sale.AmountPaid.ToString("N2")
                                    </strong>

                                </td>


                                <!-- Status -->

                                <td>

                                    <span class="sale-status @statusClass">

                                        <span></span>

                                        @(string.IsNullOrWhiteSpace(sale.Status)
                                            ? "Unpaid"
                                            : sale.Status)

                                    </span>

                                </td>


                                <!-- View -->
                                <td>
                                    @if (sale.Status?.Equals("Unpaid", StringComparison.OrdinalIgnoreCase) == true &&
                                         utangsBySaleId.TryGetValue(sale.SaleId, out var matchingUtang))
                                    {
                                        <button type="button"
                                                class="btn view-utang-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#utangDetailsModal-@matchingUtang.UtangId">
                                            <i class="bi bi-eye me-1"></i>
                                            View
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn sales-view-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#saleDetailsModal-@sale.SaleId">
                                            <i class="bi bi-eye me-1"></i>
                                            View
                                        </button>
                                    }
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center py-5">

                                <div class="text-muted">

                                    <i class="bi bi-receipt fs-2"></i>

                                    <div class="mt-2">
                                        No sales transactions yet.
                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     NEW TRANSACTION MODAL
========================================================= -->

<div class="modal fade"
     id="newSaleModal"
     tabindex="-1"
     aria-labelledby="newSaleModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content transaction-modal">

            <form asp-controller="Sales"
                  asp-action="Create"
                  method="post"
                  id="saleForm">

                @Html.AntiForgeryToken()
                <input type="hidden" name="ReturnTo" value="Sales" />

                <!-- Header -->

                <div class="modal-header transaction-header">

                    <div class="transaction-title">

                        <div class="transaction-icon">
                            <i class="bi bi-cart-plus"></i>
                        </div>

                        <div>

                            <h5 id="newSaleModalLabel">
                                New Transaction
                            </h5>

                            <p>
                                Create a sale or record an utang.
                            </p>

                        </div>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <!-- Body -->

                <div class="modal-body transaction-body">


                    <!-- =================================================
                         TRANSACTION TYPE
                    ================================================== -->

                    <div class="transaction-section">

                        <label class="transaction-label">
                            Transaction Type
                        </label>

                        <div class="transaction-type-grid">

                            <!-- Cash -->

                            <label class="transaction-type-option">

                                <input type="radio"
                                       name="TransactionType"
                                       value="Cash"
                                       @(!openUtang ? "checked" : "") />

                                <div class="transaction-type-card">

                                    <div class="transaction-type-icon cash">
                                        <i class="bi bi-cash"></i>
                                    </div>

                                    <div>

                                        <strong>Cash Sale</strong>

                                        <small>
                                            Customer pays immediately
                                        </small>

                                    </div>

                                    <i class="bi bi-check-circle-fill selected-icon"></i>

                                </div>

                            </label>


                            <!-- Utang -->

                            <label class="transaction-type-option">

                                <input type="radio"
                                       name="TransactionType"
                                       value="Utang" 
                                        @(openUtang ? "checked" : "") />

                                <div class="transaction-type-card">

                                    <div class="transaction-type-icon utang">
                                        <i class="bi bi-wallet2"></i>
                                    </div>

                                    <div>

                                        <strong>Utang</strong>

                                        <small>
                                            Record customer balance
                                        </small>

                                    </div>

                                    <i class="bi bi-check-circle-fill selected-icon"></i>

                                </div>

                            </label>

                        </div>

                    </div>


                    <!-- =================================================
                         CUSTOMER
                    ================================================== -->

                    <div class="transaction-section">

                        <label for="customerSelect"
                               class="transaction-label">

                            Customer

                        </label>

                        <select id="customerSelect"
                                name="CustomerId"
                                class="form-select transaction-select">

                            <option value="">
                                Walk-in Customer
                            </option>

                            @if (ViewBag.Customers != null)
                            {
                                foreach (var customer in ViewBag.Customers)
                                {
                                    <option value="@customer.CustomerId">
                                        @customer.CustomerName
                                    </option>
                                }

                            }

                        </select>

                        <small class="transaction-help">
                            Customer is required when recording an utang.
                        </small>

                    </div>


                    <!-- =================================================
                         PRODUCT SELECTOR
                    ================================================== -->

                    <div class="transaction-section">

                        <label for="productSelector"
                               class="transaction-label">

                            Add Product

                        </label>

                        <!--
                            IMPORTANT:
                            This is the ONLY product selector.

                            Selecting a product automatically adds it
                            to the product list below.
                        -->

                        <select id="productSelector"
                                class="form-select transaction-select">

                            <option value="">
                                Select a product to add...
                            </option>

                            @if (ViewBag.Products != null)
                            {
                                foreach (var product in ViewBag.Products)
                                {
                                    <option value="@product.ProductId"
                                            data-price="@product.Price"
                                            data-stock="@product.Quantity">

                                        @product.ProductName
                                        — ₱@product.Price.ToString("N2")
                                        (@product.Quantity in stock)

                                    </option>
                                }
                            }

                        </select>

                        <small class="transaction-help">
                            Select a product and it will be added automatically.
                        </small>

                    </div>


                    <!-- =================================================
                         SELECTED PRODUCTS
                    ================================================== -->

                    <div class="transaction-section">

                        <div class="transaction-section-header">

                            <label class="transaction-label mb-0">
                                Selected Products
                            </label>

                        </div>


                        <div class="transaction-products">

                            <!-- Table Header -->

                            <div class="product-table-head">

                                <div>Product</div>
                                <div>Quantity</div>
                                <div>Subtotal</div>
                                <div></div>

                            </div>


                            <!--
                                JavaScript will add product rows here.
                            -->

                            <div id="saleProductsContainer">

                                <div id="emptyProductMessage"
                                     class="text-center text-muted py-3"
                                     style="font-size: 11px;">

                                    <i class="bi bi-cart3 me-1"></i>
                                    No products added yet.

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         PAYMENT
                    ================================================== -->

                    <div class="transaction-section">

                        <div class="transaction-payment">

                            <div class="payment-summary">


                                <!-- Total -->

                                <div class="payment-total">

                                    <span>
                                        Total Amount
                                    </span>

                                    <strong id="saleTotal">
                                        ₱0.00
                                    </strong>

                                </div>


                                <!-- Amount Paid -->

                                <div class="payment-input-group">

                                    <label for="amountPaid">
                                        Amount Paid
                                    </label>

                                    <div class="money-input">

                                        <span>₱</span>

                                        <input type="number"
                                               id="amountPaid"
                                               name="AmountPaid"
                                               min="0"
                                               step="0.01"
                                               value="0" />

                                    </div>

                                </div>


                                <!-- Change / Balance -->

                                <div class="payment-result">

                                    <span id="paymentResultLabel">
                                        Change
                                    </span>

                                    <strong id="paymentResult">
                                        ₱0.00
                                    </strong>

                                </div>

                            </div>


                            <!-- Utang information -->

                            <div id="utangPaymentInfo"
                                 class="transaction-note"
                                 style="display: none;">

                                <i class="bi bi-info-circle"></i>

                                <div>
                                    The remaining amount will be recorded
                                    as the customer's utang balance.
                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Footer -->

                <div class="modal-footer transaction-footer">

                    <button type="button"
                            class="btn transaction-cancel-btn"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn transaction-submit-btn">

                        <i class="bi bi-check-lg me-1"></i>

                        Complete Sale

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     SALE DETAILS MODALS
========================================================= -->

@if (sales.Any())
{
    foreach (var sale in sales)
    {
        int itemCount =
            sale.SaleItems?.Sum(i => i.Quantity) ?? 0;

        decimal balance =
            Math.Max(0, sale.TotalAmount - sale.AmountPaid);

        string statusClass =
            sale.Status?.ToLower() switch
            {
                "paid" => "paid",
                "partial" => "partial",
                _ => "unpaid"
            };

        <div class="modal fade"
             id="saleDetailsModal-@sale.SaleId"
             tabindex="-1"
             aria-labelledby="saleDetailsLabel-@sale.SaleId"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content sale-details-modal">

                    <!-- =================================================
                         DETAILS HEADER
                    ================================================== -->

                    <div class="modal-header sale-details-header">

                        <div class="sale-details-title">

                            <div class="sale-details-icon">
                                <i class="bi bi-receipt"></i>
                            </div>

                            <div>

                                <h5 id="saleDetailsLabel-@sale.SaleId">
                                    Sale Details
                                </h5>

                                <p>
                                    Transaction #@sale.SaleId
                                </p>

                            </div>

                        </div>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>


                    <!-- =================================================
                         DETAILS BODY
                    ================================================== -->

                    <div class="modal-body sale-details-body">

                        <!-- Transaction Information -->

                        <div class="sale-detail-info-grid">

                            <!-- Date -->

                            <div class="sale-detail-info">

                                <span>Date</span>

                                <strong>
                                    @sale.SaleDate.ToString("MMM dd, yyyy")
                                </strong>

                                <small class="d-block text-muted">
                                    @sale.SaleDate.ToString("hh:mm tt")
                                </small>

                            </div>


                            <!-- Customer -->

                            <div class="sale-detail-info">

                                <span>Customer</span>

                                <strong>
                                    @(sale.Customer?.CustomerName
                                        ?? "Walk-in Customer")
                                </strong>

                            </div>


                            <!-- Status -->

                            <div class="sale-detail-info">

                                <span>Status</span>

                                <strong>

                                    <span class="sale-status @statusClass">

                                        <span></span>

                                        @(sale.Status ?? "Unpaid")

                                    </span>

                                </strong>

                            </div>


                            <!-- Payment Method -->

                            <div class="sale-detail-info">

                                <span>Payment</span>

                                <strong>
                                    @(sale.PaymentMethod ?? "Cash")
                                </strong>

                            </div>


                            <!-- Items -->

                            <div class="sale-detail-info">

                                <span>Items</span>

                                <strong>
                                    @itemCount item@(itemCount != 1 ? "s" : "")
                                </strong>

                            </div>


                            <!-- Sale ID -->

                            <div class="sale-detail-info">

                                <span>Transaction ID</span>

                                <strong>
                                    #@sale.SaleId
                                </strong>

                            </div>

                        </div>


                        <!-- =================================================
                             PRODUCTS
                        ================================================== -->

                        <div class="sale-details-products">

                            <div class="sale-details-section-header">

                                <div>

                                    <h6>
                                        Purchased Products
                                    </h6>

                                    <p>
                                        Products included in this transaction.
                                    </p>

                                </div>

                                <span class="sale-item-count">
                                    @itemCount item@(itemCount != 1 ? "s" : "")
                                </span>

                            </div>


                            <div class="table-responsive">

                                <table class="table sale-details-table">

                                    <thead>

                                        <tr>

                                            <th>Product</th>
                                            <th>Qty</th>
                                            <th>Price</th>
                                            <th>Subtotal</th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @if (sale.SaleItems != null &&
                                             sale.SaleItems.Any())
                                        {
                                            foreach (var item in sale.SaleItems)
                                            {
                                                <tr>

                                                    <td>

                                                        <div class="sale-product-name">

                                                            <div class="sale-product-icon">
                                                                <i class="bi bi-box"></i>
                                                            </div>

                                                            <strong>
                                                                @(item.Product?.ProductName
                                                                    ?? "Product")
                                                            </strong>

                                                        </div>

                                                    </td>

                                                    <td>
                                                        @item.Quantity
                                                    </td>

                                                    <td>
                                                        ₱@item.UnitPrice.ToString("N2")
                                                    </td>

                                                    <td>
                                                        <strong>
                                                            ₱@item.Subtotal.ToString("N2")
                                                        </strong>
                                                    </td>

                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>

                                                <td colspan="4"
                                                    class="text-center text-muted py-3">

                                                    No product details available.

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>


                        <!-- =================================================
                             PAYMENT SUMMARY
                        ================================================== -->

                        <div class="sale-details-payment">

                            <div class="sale-payment-row">

                                <span>
                                    Total Amount
                                </span>

                                <strong>
                                    ₱@sale.TotalAmount.ToString("N2")
                                </strong>

                            </div>


                            <div class="sale-payment-row">

                                <span>
                                    Amount Paid
                                </span>

                                <strong class="paid-value">
                                    ₱@sale.AmountPaid.ToString("N2")
                                </strong>

                            </div>


                            <div class="sale-payment-row sale-balance-row">

                                <span>
                                    Balance
                                </span>

                                <strong class="balance-value">
                                    ₱@balance.ToString("N2")
                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         DETAILS FOOTER
                    ================================================== -->

                    <div class="modal-footer sale-details-footer">

                        <button type="button"
                                class="btn transaction-cancel-btn"
                                data-bs-dismiss="modal">

                            Close

                        </button>

                    </div>

                </div>

            </div>

        </div>

        }
        }



<!-- =========================================================
     UTANG DETAILS MODALS
========================================================= -->

@foreach (var sale in sales)
{
    if (sale.Status?.Equals(
            "Unpaid",
            StringComparison.OrdinalIgnoreCase) == true &&
        utangsBySaleId.TryGetValue(
            sale.SaleId,
            out var matchingUtang))
    {
        <partial name="UtangDetailsModal"
                 model="matchingUtang" />
    }
}

@section Scripts {
    <script src="~/js/sales.js" asp-append-version="true"></script>
}
