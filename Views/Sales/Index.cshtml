@model IEnumerable<mini_store.Models.Sale>

@{
    ViewData["Title"] = "Sales";

    var totalSales = Model.Sum(s => s.TotalAmount);
    var totalTransactions = Model.Count();
    var paidSales = Model.Count(s => s.Status == "Paid");

    var outstanding = Model
        .Where(s => s.Status != "Paid")
        .Sum(s => s.TotalAmount - s.AmountPaid);
}

<div class="sales-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Sales
            </h1>

            <p class="text-muted mb-0">
                Manage and monitor store transactions.
            </p>
        </div>

        <!-- NEW SALE BUTTON -->
        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#newSaleModal">

            <i class="bi bi-cart-plus"></i>
            New Sale

        </button>

    </div>


    <!-- ===================================================== -->
    <!-- SUMMARY CARDS -->
    <!-- ===================================================== -->

    <div class="row g-4 mb-4">

        <!-- TOTAL SALES -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100 sales-summary-card">

                <div class="card-body">

                    <div class="sales-summary-icon sales-icon-blue">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                    <p class="text-muted mb-2">
                        Total Sales
                    </p>

                    <h3 class="fw-bold mb-0">
                        ₱@totalSales.ToString("N2")
                    </h3>

                </div>

            </div>

        </div>


        <!-- TRANSACTIONS -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100 sales-summary-card">

                <div class="card-body">

                    <div class="sales-summary-icon sales-icon-purple">
                        <i class="bi bi-receipt"></i>
                    </div>

                    <p class="text-muted mb-2">
                        Transactions
                    </p>

                    <h3 class="fw-bold mb-0">
                        @totalTransactions
                    </h3>

                </div>

            </div>

        </div>


        <!-- PAID SALES -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100 sales-summary-card">

                <div class="card-body">

                    <div class="sales-summary-icon sales-icon-green">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    <p class="text-muted mb-2">
                        Paid Sales
                    </p>

                    <h3 class="fw-bold mb-0">
                        @paidSales
                    </h3>

                </div>

            </div>

        </div>


        <!-- OUTSTANDING -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100 sales-summary-card">

                <div class="card-body">

                    <div class="sales-summary-icon sales-icon-red">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    <p class="text-muted mb-2">
                        Outstanding
                    </p>

                    <h3 class="fw-bold mb-0">
                        ₱@outstanding.ToString("N2")
                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- SALES TABLE -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm sales-table-card">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>

                    <h5 class="fw-bold mb-1">
                        Sales Transactions
                    </h5>

                    <small class="text-muted">
                        View your recent store transactions.
                    </small>

                </div>


                <!-- SEARCH -->
                <div class="sales-search">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="salesSearch"
                           class="form-control"
                           placeholder="Search customer...">

                </div>

            </div>


            <div class="table-responsive">

                <table class="table align-middle mb-0"
                       id="salesTable">

                    <thead>

                        <tr>

                            <th>Date</th>

                            <th>Customer</th>

                            <th>Items</th>

                            <th>Total</th>

                            <th>Paid</th>

                            <th>Status</th>

                            <th class="text-end">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var sale in Model)
                        {
                            <tr>

                                <!-- DATE -->
                                <td>

                                    <strong>
                                        @sale.SaleDate.ToString("MMM dd, yyyy")
                                    </strong>

                                    <br>

                                    <small class="text-muted">
                                        @sale.SaleDate.ToString("hh:mm tt")
                                    </small>

                                </td>


                                <!-- CUSTOMER -->
                                <td>

                                    <div class="d-flex align-items-center gap-2">

                                        <div class="sales-customer-icon">
                                            <i class="bi bi-person"></i>
                                        </div>

                                        <span>
                                            @(sale.Customer?.CustomerName
                                                ?? "Walk-in Customer")
                                        </span>

                                    </div>

                                </td>


                                <!-- ITEMS -->
                                <td>
                                    @sale.SaleItems.Count
                                </td>


                                <!-- TOTAL -->
                                <td>

                                    <strong>
                                        ₱@sale.TotalAmount.ToString("N2")
                                    </strong>

                                </td>


                                <!-- PAID -->
                                <td>
                                    ₱@sale.AmountPaid.ToString("N2")
                                </td>


                                <!-- STATUS -->
                                <td>

                                    @if (sale.Status == "Paid")
                                    {
                                        <span class="badge bg-success">
                                            Paid
                                        </span>
                                    }
                                    else if (sale.Status == "Partial")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Partial
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Unpaid
                                        </span>
                                    }

                                </td>


                                <!-- ACTION -->
                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@sale.SaleId"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye"></i>
                                        View

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- NEW SALE MODAL -->
<!-- ========================================================= -->

<div class="modal fade"
     id="newSaleModal"
     tabindex="-1"
     aria-labelledby="newSaleModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content sales-modal">

            <!-- HEADER -->
            <div class="modal-header">

                <div>

                    <h5 class="modal-title fw-bold"
                        id="newSaleModalLabel">

                        <i class="bi bi-cart-plus me-2"></i>
                        New Sale

                    </h5>

                    <small class="text-muted">
                        Create a new store transaction.
                    </small>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- FORM -->
            <form asp-action="Create"
                  method="post"
                  id="newSaleForm">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <!-- CUSTOMER -->
                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            Customer
                        </label>

                        <select name="CustomerId"
                                class="form-select">

                            <option value="">
                                Walk-in Customer
                            </option>

                            @if (ViewBag.Customers != null)
                            {
                                foreach (var customer in ViewBag.Customers)
                                {
                                    <option value="@customer.CustomerId">
                                        @customer.CustomerName
                                    </option>
                                }
                            }

                        </select>

                        <small class="text-muted">
                            Leave as Walk-in Customer if the buyer is not registered.
                        </small>

                    </div>


                    <!-- PRODUCTS -->
                    <div class="mb-3">

                        <div class="d-flex justify-content-between align-items-center mb-2">

                            <label class="form-label fw-semibold mb-0">
                                Products
                            </label>

                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    id="addSaleProduct">

                                <i class="bi bi-plus-lg"></i>
                                Add Product

                            </button>

                        </div>


                        <div id="saleProductsContainer">

                            <!-- PRODUCT ROW -->
                            <div class="sale-product-row row g-2 mb-2">

                                <div class="col-md-7">

                                    <select name="ProductId"
                                            class="form-select sale-product-select"
                                            required>

                                        <option value="">
                                            -- Select Product --
                                        </option>

                                        @if (ViewBag.Products != null)
                                        {
                                            foreach (var product in ViewBag.Products)
                                            {
                                                <option value="@product.ProductId"
                                                        data-price="@product.Price"
                                                        data-stock="@product.Quantity">

                                                    @product.ProductName
                                                    -
                                                    ₱@product.Price.ToString("N2")
                                                    (@product.Quantity stock)

                                                </option>
                                            }
                                        }

                                    </select>

                                </div>


                                <div class="col-md-3">

                                    <input type="number"
                                           name="Quantity"
                                           class="form-control"
                                           min="1"
                                           value="1"
                                           placeholder="Quantity"
                                           required />

                                </div>


                                <div class="col-md-2">

                                    <button type="button"
                                            class="btn btn-outline-danger w-100 remove-sale-product">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- SALE NOTE -->
                    <div class="sale-modal-note">

                        <i class="bi bi-info-circle"></i>

                        <span>
                            Product stock will automatically decrease after the sale is saved.
                        </span>

                    </div>

                </div>


                <!-- FOOTER -->
                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light border"
                            data-bs-dismiss="modal">

                        <i class="bi bi-x-lg"></i>
                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg"></i>
                        Complete Sale

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/sales.css"
          asp-append-version="true" />

}


@section Scripts {

    <script src="~/js/sales.js"
            asp-append-version="true"></script>

}