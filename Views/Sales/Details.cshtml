@model mini_store.Models.Sale

@{
    ViewData["Title"] = "Sale Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold mb-1">Sale Details</h1>
        <p class="text-muted mb-0">
            Sale #S-@Model.SaleId.ToString("D5")
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        ← Back to Sales
    </a>

</div>

<div class="row g-4">

    <!-- Sale Information -->
    <div class="col-md-4">

        <div class="card border-0 shadow-sm">
            <div class="card-body">

                <h5 class="fw-bold mb-4">
                    Transaction Information
                </h5>

                <p>
                    <strong>Customer</strong><br>
                    @(Model.Customer?.CustomerName ?? "Walk-in Customer")
                </p>

                <p>
                    <strong>Date</strong><br>
                    @Model.SaleDate.ToString("MMMM dd, yyyy")
                </p>

                <p>
                    <strong>Time</strong><br>
                    @Model.SaleDate.ToString("hh:mm tt")
                </p>

                <p>
                    <strong>Payment Method</strong><br>
                    @Model.PaymentMethod
                </p>

                <p>
                    <strong>Status</strong><br>

                    @if (Model.Status == "Paid")
                    {
                        <span class="badge bg-success">
                            Paid
                        </span>
                    }
                    else if (Model.Status == "Partial")
                    {
                        <span class="badge bg-warning text-dark">
                            Partial
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Unpaid
                        </span>
                    }

                </p>

            </div>
        </div>

    </div>

    <!-- Products -->
    <div class="col-md-8">

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <h5 class="fw-bold mb-4">
                    Purchased Products
                </h5>

                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.SaleItems)
                            {
                                <tr>

                                    <td>
                                        @item.Product?.ProductName
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>
                                        ₱@item.UnitPrice.ToString("N2")
                                    </td>

                                    <td>
                                        ₱@item.Subtotal.ToString("N2")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <hr>

                <div class="text-end">

                    <p class="mb-1">
                        Total:
                        <strong>
                            ₱@Model.TotalAmount.ToString("N2")
                        </strong>
                    </p>

                    <p class="mb-1">
                        Amount Paid:
                        <strong>
                            ₱@Model.AmountPaid.ToString("N2")
                        </strong>
                    </p>

                    <h5 class="fw-bold">
                        Balance:
                        ₱@((Model.TotalAmount - Model.AmountPaid).ToString("N2"))
                    </h5>

                </div>

            </div>

        </div>

    </div>

</div>