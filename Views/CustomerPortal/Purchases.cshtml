@model mini_store.ViewModels.CustomerPortal.CustomerPortalViewModel
@using mini_store.Models

@{
    ViewData["Title"] = "My Purchases";

    var unpaid = Model.Transactions.Sum(s => Math.Max(0, s.TotalAmount - s.AmountPaid));

    var kTotal = ("primary", "bi-receipt", "Total Purchase Value", $"₱{Model.TotalPurchases:N2}", "All recorded sales");
    var kCount = ("gold", "bi-bag-check", "Transactions", Model.Transactions.Count.ToString(), "Recorded by the store");
    var kUnpaid = ("danger", "bi-hourglass-split", "Still Unpaid", $"₱{unpaid:N2}", "Across all purchases");
}
@section Styles {
    <link rel="stylesheet" href="~/css/transactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/portal.js" asp-append-version="true"></script>
}

<div class="pt-page">

    <section class="pt-hero pt-hero-sm">
        <div class="pt-eyebrow">Customer portal</div>
        <h1>My Purchases</h1>
        <p>Hello, @Model.CustomerName. Review your purchases and their payment status.</p>
    </section>

    <div class="row g-3">
        <div class="col-md-4"><partial name="_Kpi" model="kTotal" /></div>
        <div class="col-md-4"><partial name="_Kpi" model="kCount" /></div>
        <div class="col-md-4"><partial name="_Kpi" model="kUnpaid" /></div>
    </div>

    <section class="pt-card" data-portal-filter>
        <div class="pt-card-head">
            <div>
                <h5>Purchase History</h5>
                <p>Newest first</p>
            </div>
            <div class="pt-tools">
                <div class="pt-search">
                    <i class="bi bi-search"></i>
                    <input type="text" data-filter-q placeholder="Search transaction or product..." aria-label="Search purchases" autocomplete="off" />
                </div>
                <select class="pt-select" data-filter-cat aria-label="Filter by status">
                    <option value="">All statuses</option>
                    <option value="paid">Paid</option>
                    <option value="partial">Partial</option>
                    <option value="unpaid">Unpaid</option>
                </select>
            </div>
        </div>

        @if (Model.Transactions.Any())
        {
            <table class="pt-table">
                <thead>
<tr><th>Transaction</th><th>Date</th><th>Items</th><th>Total</th><th>Paid</th><th>Type</th><th>Status</th><th>Receipt</th></tr>
                </thead>
                <tbody>
                @foreach (var sale in Model.Transactions)
                {
                    var key = TxStatus.Key(sale.Status);
                    var names = string.Join(" ", sale.SaleItems.Select(i => i.Product?.ProductName));
                    var search = $"{sale.TransactionNo} {names} {sale.SaleDate:MMM dd yyyy} {sale.Status}".ToLowerInvariant();

                    <tr data-filter-item data-search="@search" data-category="@key">
                        <td data-label="Transaction"><span class="pt-mono">@sale.TransactionNo</span></td>
                        <td data-label="Date">@sale.SaleDate.ToString("MMM dd, yyyy")<small>@sale.SaleDate.ToString("hh:mm tt")</small></td>
                        <td data-label="Items">
                            @if (sale.SaleItems.Any())
                            {
                                foreach (var item in sale.SaleItems)
                                {
                                    <div>@item.Quantity × @(item.Product?.ProductName ?? "Product")</div>
                                }
                            }
                            else { <span class="text-muted">No item details</span> }
                        </td>
                        <td data-label="Total"><strong>₱@sale.TotalAmount.ToString("N2")</strong></td>
                        <td data-label="Paid">₱@sale.AmountPaid.ToString("N2")</td>
                        <td data-label="Type">@(sale.PaymentMethod == "Utang" ? "Credit" : sale.PaymentMethod)</td>
                        <td data-label="Status"><partial name="_StatusPill" model="(sale.Status, false)" /></td>
                        <td data-label="Receipt">
    <button type="button" class="pt-btn" data-receipt-sale="@sale.SaleId">
        <i class="bi bi-receipt"></i> View
    </button>
</td>
                    </tr>
                }
                </tbody>
            </table>

            <div class="pt-empty" data-filter-empty hidden>
                <i class="bi bi-search"></i>
                <h5>No matching purchases</h5>
                <p>Try a different search or status.</p>
            </div>
        }
        else
        {
            <div class="pt-empty">
                <i class="bi bi-bag-x"></i>
                <h5>No purchases yet</h5>
                <p>Your recorded purchases will appear here.</p>
            </div>
        }
    </section>
</div>
<partial name="_ReceiptModal" />