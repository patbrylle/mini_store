
@model List<mini_store.Models.Product>

@{
    ViewData["Title"] = "Product Catalog";
    Layout = "_Layout";
}

<style>
    .catalog-page {
        padding: 24px 0;
        color: #172b4d;
    }

    .catalog-header {
        padding: 26px;
        border-radius: 18px;
        color: white;
        background: linear-gradient(120deg, #17345d, #2876b9);
        margin-bottom: 22px;
    }

    .catalog-panel {
        background: white;
        border: 1px solid #e5eaf1;
        border-radius: 16px;
        padding: 22px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .04);
    }

    .catalog-card {
        height: 100%;
        padding: 20px;
        border: 1px solid #e5eaf1;
        border-radius: 14px;
        transition: transform .2s, box-shadow .2s;
    }

    .catalog-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 22px rgba(15, 23, 42, .08);
    }

    .catalog-price {
        color: #1769aa;
        font-size: 1.45rem;
        font-weight: 750;
    }

    .catalog-category {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        background: #eaf3ff;
        color: #1769aa;
        font-size: .8rem;
    }

    .catalog-stock {
        font-size: .88rem;
        color: #64748b;
    }

    .catalog-empty {
        padding: 40px 12px;
        text-align: center;
        color: #718096;
    }

    @@media (max-width: 576px) {
        .catalog-header, .catalog-panel {
            padding: 17px;
        }
    }
</style>

<div class="container-fluid catalog-page">
    <div class="catalog-header">
        <div class="small text-white-50 mb-2">
            CUSTOMER PORTAL / PRODUCTS
        </div>

        <h2 class="fw-bold">
            <i class="bi bi-shop me-2"></i>Product Catalog
        </h2>

        <p class="mb-0">
            Browse our products, categories, prices, and available stock.
        </p>
    </div>

    <section class="catalog-panel">
        <div class="d-flex flex-wrap justify-content-between
                    align-items-center gap-3 mb-4">
            <div>
                <h4 class="fw-bold mb-1">Available Products</h4>
                <p class="text-muted small mb-0">
                    @Model.Count product(s) in the catalog
                </p>
            </div>

            <a asp-controller="CustomerPortal"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Home
            </a>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-md-7">
                <input id="productSearch"
                       type="search"
                       class="form-control"
                       placeholder="Search product name..."
                       aria-label="Search products" />
            </div>

            <div class="col-12 col-md-5">
                <select id="categoryFilter" class="form-select"
                        aria-label="Filter by category">
                    <option value="">All Categories</option>

                    @foreach (var category in Model
                        .Where(p => p.Category != null)
                        .Select(p => p.Category!)
                        .DistinctBy(c => c.CategoryId)
                        .OrderBy(c => c.CategoryName))
                    {
                        <option value="@category.CategoryName">
                            @category.CategoryName
                        </option>
                    }
                </select>
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="row g-3" id="productGrid">
                @foreach (var product in Model)
                {
                    <div class="col-12 col-md-6 col-xl-4 product-item"
                         data-name="@product.ProductName"
                         data-category="@(product.Category?.CategoryName ?? "Uncategorized")">

                        <div class="catalog-card">
                            <div class="d-flex justify-content-between
                                        align-items-start gap-2 mb-3">
                                <span class="catalog-category">
                                    @(product.Category?.CategoryName
                                        ?? "Uncategorized")
                                </span>

                                <i class="bi bi-box-seam fs-4 text-secondary"></i>
                            </div>

                            <h5 class="fw-bold mb-2">
                                @product.ProductName
                            </h5>

                            <div class="catalog-price mb-3">
                                ₱@product.Price.ToString("N2")
                            </div>

                            <div class="d-flex justify-content-between
                                        align-items-center border-top pt-3">
                                <span class="catalog-stock">
                                    Available stock
                                </span>

                                <span class="fw-semibold
                                    @(product.Quantity > 0
                                        ? "text-success"
                                        : "text-danger")">
                                    @(product.Quantity > 0
                                        ? $"{product.Quantity} units"
                                        : "Out of stock")
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div id="noProductsFound"
                 class="catalog-empty d-none">
                <i class="bi bi-search fs-1"></i>
                <h5 class="fw-bold mt-3">No products found</h5>
                <p class="mb-0">
                    Try another product name or category.
                </p>
            </div>
        }
        else
        {
            <div class="catalog-empty">
                <i class="bi bi-box-seam fs-1"></i>
                <h5 class="fw-bold mt-3">No products available</h5>
                <p class="mb-0">
                    Products added by the store will appear here.
                </p>
            </div>
        }
    </section>
</div>

<script>
    const productSearch = document.getElementById("productSearch");
    const categoryFilter = document.getElementById("categoryFilter");
    const productItems = document.querySelectorAll(".product-item");
    const noProductsFound = document.getElementById("noProductsFound");

    function filterProducts() {
        const search = productSearch.value.toLowerCase().trim();
        const category = categoryFilter.value.toLowerCase();
        let visible = 0;

        productItems.forEach(item => {
            const name = (item.dataset.name || "").toLowerCase();
            const itemCategory =
                (item.dataset.category || "").toLowerCase();

            const matchesName = name.includes(search);
            const matchesCategory =
                category === "" || itemCategory === category;

            const show = matchesName && matchesCategory;

            item.classList.toggle("d-none", !show);

            if (show) visible++;
        });

        if (noProductsFound) {
            noProductsFound.classList.toggle("d-none", visible !== 0);
        }
    }

    productSearch.addEventListener("input", filterProducts);
    categoryFilter.addEventListener("change", filterProducts);
</script>
