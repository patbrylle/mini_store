@model List<mini_store.Models.Product>

@{
    ViewData["Title"] = "Products";

    var categories = Model.Where(p => p.Category != null)
        .Select(p => p.Category!).DistinctBy(c => c.CategoryId).OrderBy(c => c.CategoryName).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/portal.js" asp-append-version="true"></script>
}

<div class="pt-page">

    <section class="pt-hero pt-hero-sm">
        <div class="pt-eyebrow">Customer portal</div>
        <h1><i class="bi bi-shop me-2"></i>Product Catalog</h1>
        <p>Browse our products, prices and available stock.</p>
    </section>

    <section class="pt-card" data-portal-filter>
        <div class="pt-card-head">
            <div>
                <h5>Available Products</h5>
                <p>@Model.Count product(s)</p>
            </div>
            <div class="pt-tools">
                <div class="pt-search">
                    <i class="bi bi-search"></i>
                    <input type="text" data-filter-q placeholder="Search product..." aria-label="Search products" autocomplete="off" />
                </div>
                <select class="pt-select" data-filter-cat aria-label="Filter by category">
                    <option value="">All categories</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.CategoryName">@c.CategoryName</option>
                    }
                </select>
            </div>
        </div>

        <div class="pt-card-body">
            @if (Model.Any())
            {
                <div class="row g-3">
                @foreach (var p in Model)
                {
                    var category = p.Category?.CategoryName ?? "Uncategorized";
                    <div class="col-12 col-md-6 col-xl-4" data-filter-item
                         data-search="@($"{p.ProductName} {category}".ToLowerInvariant())"
                         data-category="@category">
                        <div class="pt-product">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <span class="pt-chip">@category</span>
                                <i class="bi bi-box-seam fs-4 text-muted"></i>
                            </div>
                            <h5 class="fw-bold mt-3 mb-0">@p.ProductName</h5>
                            <div class="pt-price">₱@p.Price.ToString("N2")</div>
                            <div class="pt-stock">
                                <span>Available stock</span>
                                <strong class="@(p.Quantity > 0 ? "text-success" : "text-danger")">
                                    @(p.Quantity > 0 ? $"{p.Quantity} units" : "Out of stock")
                                </strong>
                            </div>
                        </div>
                    </div>
                }
                </div>

                <div class="pt-empty" data-filter-empty hidden>
                    <i class="bi bi-search"></i>
                    <h5>No products found</h5>
                    <p>Try another name or category.</p>
                </div>
            }
            else
            {
                <div class="pt-empty">
                    <i class="bi bi-box-seam"></i>
                    <h5>No products available</h5>
                    <p>Products added by the store will appear here.</p>
                </div>
            }
        </div>
    </section>
</div>