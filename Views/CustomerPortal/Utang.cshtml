@model mini_store.ViewModels.CustomerPortal.CustomerPortalViewModel

@{
    ViewData["Title"] = "My Credit";

    var overdueAmount = Model.Utangs.Where(u => u.IsOverdue).Sum(u => u.Balance);

    var kOwed    = ("gold", "bi-wallet2", "Outstanding Balance", $"₱{Model.TotalUtangBalance:N2}", "Remaining to pay");
    var kRecords = ("primary", "bi-journal-text", "Credit Records", Model.Utangs.Count.ToString(), "All recorded credit");
    var kSettled = ("success", "bi-check-circle", "Settled", Model.Utangs.Count(u => u.Balance <= 0).ToString(), "Fully paid");
    var kOver    = ("danger", "bi-exclamation-circle", "Overdue", $"₱{overdueAmount:N2}", $"{Model.OverdueCount} record(s)");
}
@section Styles {
    <link rel="stylesheet" href="~/css/transactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/portal.js" asp-append-version="true"></script>
}

<div class="pt-page">

    <section class="pt-hero pt-hero-sm">
        <div class="pt-eyebrow">Customer portal</div>
        <h1>My Credit</h1>
        <p>Hello, @Model.CustomerName. Track your balances, payments and due dates.</p>
    </section>

    <div class="row g-3">
        <div class="col-xl-3 col-sm-6"><partial name="_Kpi" model="kOwed" /></div>
        <div class="col-xl-3 col-sm-6"><partial name="_Kpi" model="kRecords" /></div>
        <div class="col-xl-3 col-sm-6"><partial name="_Kpi" model="kSettled" /></div>
        <div class="col-xl-3 col-sm-6"><partial name="_Kpi" model="kOver" /></div>
    </div>

    <section class="pt-card" data-portal-filter>
        <div class="pt-card-head">
            <div>
                <h5>Credit Details</h5>
                <p>Original amount, payments made and remaining balance</p>
            </div>
            <div class="pt-tools">
                <div class="pt-search">
                    <i class="bi bi-search"></i>
                    <input type="text" data-filter-q placeholder="Search..." aria-label="Search credit records" autocomplete="off" />
                </div>
                <select class="pt-select" data-filter-cat aria-label="Filter by status">
                    <option value="">All records</option>
                    <option value="open">Open</option>
                    <option value="overdue">Overdue</option>
                    <option value="paid">Paid</option>
                </select>
            </div>
        </div>

        @if (Model.Utangs.Any())
        {
            <table class="pt-table">
                <thead>
<tr><th>Reference</th><th>Recorded</th><th>Amount</th><th>Paid</th><th>Balance</th><th>Due date</th><th>Status</th><th>Receipts</th></tr>
                </thead>
                <tbody>
                @foreach (var u in Model.Utangs)
                {
                    var group = u.Balance <= 0 ? "paid" : u.IsOverdue ? "overdue" : "open";
                    var reference = u.Sale?.TransactionNo ?? $"#{u.UtangId}";
                    var pct = u.Amount > 0 ? (int)Math.Round(Math.Min(100m, u.AmountPaid / u.Amount * 100m)) : 0;
                    var search = $"{reference} {u.DateCreated:MMM dd yyyy} {u.DueDate:MMM dd yyyy} {u.Status} {group}".ToLowerInvariant();

                    <tr data-filter-item data-search="@search" data-category="@group">
                        <td data-label="Reference"><span class="pt-mono">@reference</span></td>
                        <td data-label="Recorded">@u.DateCreated.ToString("MMM dd, yyyy")</td>
                        <td data-label="Amount">₱@u.Amount.ToString("N2")</td>
                        <td data-label="Paid">
                            ₱@u.AmountPaid.ToString("N2")
                            <div class="pt-progress" title="@pct% paid"><span style="width:@(pct)%"></span></div>
                        </td>
                        <td data-label="Balance"><strong class="@(u.Balance > 0 ? "text-danger" : "text-success")">₱@u.Balance.ToString("N2")</strong></td>
                        <td data-label="Due date">@(u.DueDate?.ToString("MMM dd, yyyy") ?? "Not set")</td>
                        <td data-label="Status"><partial name="_StatusPill" model="(u.Status, u.IsOverdue)" /></td>
                        <td data-label="Receipts">
    <div class="pt-btn-group">
        @foreach (var p in u.Payments.OrderBy(p => p.Sequence))
        {
            <button type="button" class="pt-btn" title="@p.ReceiptNo"
                    data-receipt-sale="@u.SaleId" data-receipt-payment="@p.PaymentId">
                <i class="bi bi-receipt"></i> ₱@p.Amount.ToString("N2")
            </button>
        }
        @if (!u.Payments.Any())
        {
            <button type="button" class="pt-btn" data-receipt-sale="@u.SaleId">
                <i class="bi bi-receipt"></i> Slip
            </button>
        }
    </div>
</td>
                    </tr>
                }
                </tbody>
            </table>

            <div class="pt-empty" data-filter-empty hidden>
                <i class="bi bi-search"></i>
                <h5>No matching records</h5>
                <p>Try a different search or filter.</p>
            </div>
        }
        else
        {
            <div class="pt-empty">
                <i class="bi bi-check-circle"></i>
                <h5>You're all caught up!</h5>
                <p>You have no recorded credit.</p>
            </div>
        }
    </section>
</div>
<partial name="_ReceiptModal" />