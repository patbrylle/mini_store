
@model mini_store.ViewModels.CustomerPortal.CustomerPortalViewModel

@{
    ViewData["Title"] = "My Utang";
    Layout = "_Layout";
}

<style>
    .utang-page { padding: 24px 0; color: #172b4d; }
    .utang-header {
        padding: 26px;
        border-radius: 18px;
        color: white;
        background: linear-gradient(120deg, #17345d, #2876b9);
        margin-bottom: 22px;
    }
    .utang-card {
        background: white;
        border: 1px solid #e5eaf1;
        border-radius: 16px;
        padding: 22px;
        height: 100%;
        box-shadow: 0 5px 18px rgba(15,23,42,.04);
    }
    .utang-card small { color: #718096; }
    .utang-card h3 {
        font-weight: 750;
        margin-top: 9px;
        overflow-wrap: anywhere;
    }
    .utang-panel {
        background: white;
        border: 1px solid #e5eaf1;
        border-radius: 16px;
        padding: 22px;
    }
    .utang-table th {
        background: #f5f7fb;
        color: #64748b;
        font-size: .78rem;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .utang-table td { vertical-align: middle; }
    .utang-table { white-space: nowrap; }
    .utang-empty { text-align: center; padding: 36px 12px; color: #718096; }
    @@media(max-width:576px) {
        .utang-header, .utang-panel, .utang-card { padding: 17px; }
    }
</style>

<div class="container-fluid utang-page">
    <div class="utang-header">
        <div class="small text-white-50 mb-2">CUSTOMER PORTAL / MY UTANG</div>
        <h2 class="fw-bold">My Utang</h2>
        <p class="mb-0">
            Hello, @Model.CustomerName. Keep track of your outstanding balances and due dates.
        </p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="utang-card">
                <small><i class="bi bi-wallet2 me-2"></i>Total Outstanding</small>
                <h3 class="text-danger">₱@Model.TotalUtangBalance.ToString("N2")</h3>
                <small>Remaining recorded balance</small>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="utang-card">
                <small><i class="bi bi-receipt me-2"></i>Utang Records</small>
                <h3>@Model.Utangs.Count</h3>
                <small>All recorded credit transactions</small>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="utang-card">
                <small><i class="bi bi-check-circle me-2"></i>Paid Records</small>
                <h3>@Model.Utangs.Count(u => u.Balance <= 0)</h3>
                <small>Balances fully settled</small>
            </div>
        </div>
    </div>

    <section class="utang-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <div>
                <h4 class="fw-bold mb-1">Utang Details</h4>
                <p class="text-muted small mb-0">
                    Check the original amount, payments recorded, and remaining balance.
                </p>
            </div>
            <a asp-controller="CustomerPortal"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Home
            </a>
        </div>

        @if (Model.Utangs.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover utang-table">
                    <thead>
                        <tr>
                            <th>Utang No.</th>
                            <th>Date Recorded</th>
                            <th>Original Amount</th>
                            <th>Amount Paid</th>
                            <th>Balance</th>
                            <th>Due Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var utang in Model.Utangs)
                    {
                        var overdue = utang.Balance > 0
                            && utang.DueDate.HasValue
                            && utang.DueDate.Value.Date < DateTime.Today;

                        <tr>
                            <td class="fw-bold">#@utang.UtangId</td>
                            <td>@utang.DateCreated.ToString("MMM dd, yyyy")</td>
                            <td>₱@utang.Amount.ToString("N2")</td>
                            <td>₱@utang.AmountPaid.ToString("N2")</td>
                            <td class="fw-bold @(utang.Balance > 0 ? "text-danger" : "text-success")">
                                ₱@utang.Balance.ToString("N2")
                            </td>
                            <td>
                                @if (utang.DueDate.HasValue)
                                {
                                    @utang.DueDate.Value.ToString("MMM dd, yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">Not set</span>
                                }
                            </td>
                            <td>
                                @if (utang.Balance <= 0)
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else if (overdue)
                                {
                                    <span class="badge bg-danger">Overdue</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @(utang.Status ?? "Unpaid")
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="utang-empty">
                <i class="bi bi-check-circle fs-1"></i>
                <h5 class="mt-3 fw-bold">You're all caught up!</h5>
                <p class="mb-0">You have no recorded utang transactions.</p>
            </div>
        }
    </section>
</div>