
@{
    ViewData["Title"] = "Account Not Linked";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="card border-0 shadow-sm mx-auto text-center p-4"
         style="max-width: 600px; border-radius: 18px;">

        <div class="mb-3">
            <i class="bi bi-person-exclamation text-warning"
               style="font-size: 3rem;"></i>
        </div>

        <h3 class="fw-bold">Customer Account Not Linked</h3>

        <p class="text-muted mt-2">
            Your login account is not connected to a store customer record.
            Please contact the store administrator for assistance.
        </p>

        <a asp-controller="Account"
           asp-action="Logout"
           class="btn btn-outline-primary mt-2">
            Return to Login
        </a>
    </div>
</div>
