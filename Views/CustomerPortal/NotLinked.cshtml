@{
    ViewData["Title"] = "Account Not Linked";
}

@section Styles {
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
}

<div class="pt-page">
    <section class="pt-card">
        <div class="pt-empty" style="padding: 56px 16px;">
            <i class="bi bi-person-exclamation"></i>
            <h5>Customer account not linked</h5>
            <p>Your login isn't connected to a store customer record yet. Please contact the store for help.</p>
            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
                <button type="submit" class="btn um-add-btn">Return to login</button>
            </form>
        </div>
    </section>
</div>