@model mini_store.ViewModels.CustomerPortal.CustomerPortalViewModel

@{
    ViewData["Title"] = "Home";

    var firstName = Model.CustomerName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? Model.CustomerName;
    var next = Model.NextDue;
    var open = Model.Utangs.Where(u => u.Balance > 0).Take(3).ToList();

    var kPurchases = ("primary", "bi-bag-check", "Total Purchases", $"₱{Model.TotalPurchases:N2}", $"{Model.Transactions.Count} transaction(s)");
    var kBalance   = ("gold", "bi-wallet2", "Credit Balance", $"₱{Model.TotalUtangBalance:N2}", "Still to be paid");
    var kPaid      = ("success", "bi-cash-stack", "Amount Paid", $"₱{Model.TotalAmountPaid:N2}", "Payments recorded");
    var kNext      = ("danger", "bi-calendar-event",
                      "Next Payment Due",
                      next != null ? next.DueDate!.Value.ToString("MMM dd, yyyy") : "None",
                      next != null ? $"₱{next.Balance:N2} remaining" : "You're all caught up");
}

@section Styles {
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
}

<div class="pt-page">

    @if (Model.OverdueCount > 0)
    {
        <div class="pt-alert is-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>You have @Model.OverdueCount overdue credit record(s). Please settle them with the store.</span>
            <a asp-action="Utang" class="pt-link ms-auto">View</a>
        </div>
    }

    <section class="pt-hero">
        <div class="pt-eyebrow"><i class="bi bi-grid-1x2-fill me-2"></i>Customer portal</div>
        <h1>Welcome back, @firstName!</h1>
        <p>A summary of your purchases and credit balance with the store.</p>
    </section>

    <div class="row g-3">
        <div class="col-xl-3 col-sm-6"><partial name="_Kpi" model="kPurchases" /></div>
        <div class="col-xl-3 col-sm-6"><partial name="_Kpi" model="kBalance" /></div>
        <div class="col-xl-3 col-sm-6"><partial name="_Kpi" model="kPaid" /></div>
        <div class="col-xl-3 col-sm-6"><partial name="_Kpi" model="kNext" /></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <section class="pt-card">
                <div class="pt-card-head">
                    <div>
                        <h5>Recent Purchases</h5>
                        <p>Your latest recorded transactions</p>
                    </div>
                    <a asp-action="Purchases" class="pt-link">View all <i class="bi bi-arrow-right"></i></a>
                </div>

                @if (Model.Transactions.Any())
                {
                    <table class="pt-table">
                        <thead>
                            <tr><th>Transaction</th><th>Date</th><th>Total</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var sale in Model.Transactions.Take(5))
                        {
                            <tr>
                                <td data-label="Transaction"><span class="pt-mono">@sale.TransactionNo</span></td>
                                <td data-label="Date">@sale.SaleDate.ToString("MMM dd, yyyy")<small>@sale.SaleDate.ToString("hh:mm tt")</small></td>
                                <td data-label="Total"><strong>₱@sale.TotalAmount.ToString("N2")</strong></td>
                                <td data-label="Status"><partial name="_StatusPill" model="(sale.Status, false)" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="pt-empty">
                        <i class="bi bi-bag-x"></i>
                        <h5>No purchases yet</h5>
                        <p>Your purchases will appear here once the store records them.</p>
                    </div>
                }
            </section>
        </div>

        <div class="col-lg-4">
            <section class="pt-card">
                <div class="pt-card-head">
                    <div>
                        <h5>Credit Snapshot</h5>
                        <p>Open balances</p>
                    </div>
                    <a asp-action="Utang" class="pt-link">View all</a>
                </div>

                <div class="pt-card-body">
                    @if (open.Count == 0)
                    {
                        <div class="pt-empty">
                            <i class="bi bi-check-circle"></i>
                            <h5>All settled</h5>
                            <p>No unpaid credit.</p>
                        </div>
                    }
                    else
                    {
                        foreach (var u in open)
                        {
                            var pct = u.Amount > 0 ? (int)Math.Round(Math.Min(100m, u.AmountPaid / u.Amount * 100m)) : 0;
                            <div class="pt-credit-item">
                                <div class="pt-credit-row">
                                    <strong>₱@u.Balance.ToString("N2")</strong>
                                    <partial name="_StatusPill" model="(u.Status, u.IsOverdue)" />
                                </div>
                                <div class="pt-progress" title="@pct% paid"><span style="width:@(pct)%"></span></div>
                                <div class="pt-credit-row mt-1">
                                    <small>@(u.Sale?.TransactionNo ?? $"#{u.UtangId}")</small>
                                    <small>Due @(u.DueDate?.ToString("MMM dd, yyyy") ?? "not set")</small>
                                </div>
                            </div>
                        }
                    }
                </div>
            </section>
        </div>
    </div>
</div>