
@model mini_store.ViewModels.CustomerPortal.CustomerPortalViewModel

@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<style>
    .customer-home {
        padding: 24px 0 36px;
        color: #172b4d;
    }

    .welcome-panel {
        position: relative;
        overflow: hidden;
        padding: 32px;
        margin-bottom: 26px;
        border-radius: 22px;
        color: #fff;
        background: linear-gradient(120deg, #142c52, #245da0, #347fbd);
        box-shadow: 0 12px 30px rgba(30, 64, 110, .15);
    }

    .welcome-panel::after {
        content: "";
        position: absolute;
        width: 210px;
        height: 210px;
        right: -65px;
        top: -95px;
        border: 35px solid rgba(255,255,255,.08);
        border-radius: 50%;
        pointer-events: none;
    }

    .welcome-label {
        font-size: .76rem;
        letter-spacing: 1.5px;
        font-weight: 700;
        color: #cfe4ff;
    }

    .welcome-title {
        font-size: clamp(1.5rem, 3vw, 2.15rem);
        font-weight: 750;
        margin: 12px 0 8px;
    }

    .welcome-text {
        color: #e1edff;
        max-width: 540px;
        margin-bottom: 0;
    }

    .customer-stat {
        height: 100%;
        min-height: 158px;
        padding: 22px;
        border: 1px solid #e8edf4;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .035);
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .customer-stat:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 26px rgba(15, 23, 42, .07);
    }

    .stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 13px;
        font-size: 1.2rem;
    }

    .stat-blue { background: #e9f1ff; color: #245fbd; }
    .stat-green { background: #e3f8ed; color: #13834b; }
    .stat-orange { background: #fff1dc; color: #bd7010; }
    .stat-purple { background: #f0eaff; color: #7450c7; }

    .stat-label {
        color: #718096;
        font-size: .87rem;
        font-weight: 500;
        margin-top: 17px;
    }

    .stat-value {
        font-size: clamp(1.35rem, 2.5vw, 1.8rem);
        font-weight: 750;
        color: #172b4d;
        overflow-wrap: anywhere;
        margin-top: 3px;
    }

    .customer-panel {
        background: #fff;
        border: 1px solid #e8edf4;
        border-radius: 18px;
        padding: 24px;
        margin-top: 26px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .035);
    }

    .panel-title {
        font-weight: 750;
        color: #172b4d;
        margin-bottom: 5px;
    }

    .panel-subtitle {
        font-size: .88rem;
        color: #718096;
    }

    .customer-table {
        margin-top: 18px;
        margin-bottom: 0;
        white-space: nowrap;
    }

    .customer-table thead th {
        background: #f6f8fc;
        color: #68778d;
        font-size: .76rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        border-bottom: 1px solid #e8edf4;
        padding: 14px;
    }

    .customer-table td {
        padding: 15px 14px;
        vertical-align: middle;
        border-color: #eef1f6;
    }

    .transaction-number {
        font-weight: 700;
        color: #245fbd;
    }

    .status-pill {
        display: inline-block;
        border-radius: 30px;
        padding: 6px 11px;
        font-size: .78rem;
        font-weight: 700;
        background: #e3f8ed;
        color: #13834b;
    }

    .status-pending {
        background: #fff1dc;
        color: #98600b;
    }

    .status-neutral {
        background: #eef2f7;
        color: #536176;
    }

    .quick-link {
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
        color: #172b4d;
        padding: 15px;
        border: 1px solid #e8edf4;
        border-radius: 14px;
        height: 100%;
        transition: background .2s ease, border-color .2s ease;
    }

    .quick-link:hover {
        background: #f7faff;
        border-color: #bfd4f7;
        color: #245fbd;
    }

    .quick-link-icon {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: #e9f1ff;
        color: #245fbd;
        font-size: 1.15rem;
        flex-shrink: 0;
    }

    .empty-state {
        text-align: center;
        padding: 36px 12px;
        color: #718096;
    }

    .empty-state i {
        font-size: 2.5rem;
        color: #a7b5c8;
    }

    @@media (max-width: 576px) {
        .customer-home { padding-top: 14px; }
        .welcome-panel { padding: 24px 20px; border-radius: 17px; }
        .customer-stat { padding: 17px; min-height: 145px; }
        .customer-panel { padding: 17px; }
    }
</style>

<div class="container-fluid customer-home">

    <section class="welcome-panel">
        <div class="welcome-label">
            <i class="bi bi-grid-1x2-fill me-2"></i>
            CUSTOMER PORTAL
        </div>

        <h1 class="welcome-title">
            Welcome back, @Model.CustomerName!
        </h1>

        <p class="welcome-text">
            Here's a summary of your purchases and account balance.
            You can review your transactions anytime.
        </p>
    </section>

    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="customer-stat">
                <div class="stat-top">
                    <i class="bi bi-bag-check stat-icon stat-blue"></i>
                    <i class="bi bi-arrow-up-right text-muted"></i>
                </div>
                <div class="stat-label">Total Purchases</div>
                <div class="stat-value">
                    ₱@Model.TotalPurchases.ToString("N2")
                </div>
                <small class="text-muted">
                    @Model.Transactions.Count transaction(s)
                </small>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="customer-stat">
                <div class="stat-top">
                    <i class="bi bi-wallet2 stat-icon stat-orange"></i>
                    <i class="bi bi-credit-card text-muted"></i>
                </div>
                <div class="stat-label">Outstanding Utang</div>
                <div class="stat-value">
                    ₱@Model.TotalUtangBalance.ToString("N2")
                </div>
                <small class="text-muted">Remaining recorded balance</small>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="customer-stat">
                <div class="stat-top">
                    <i class="bi bi-cash-stack stat-icon stat-green"></i>
                    <i class="bi bi-check-circle text-muted"></i>
                </div>
                <div class="stat-label">Amount Paid</div>
                <div class="stat-value">
                    ₱@Model.TotalAmountPaid.ToString("N2")
                </div>
                <small class="text-muted">Payments recorded on sales</small>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="customer-stat">
                <div class="stat-top">
                    <i class="bi bi-receipt stat-icon stat-purple"></i>
                    <i class="bi bi-clock-history text-muted"></i>
                </div>
                <div class="stat-label">Purchase Records</div>
                <div class="stat-value">@Model.Transactions.Count</div>
                <small class="text-muted">All recorded transactions</small>
            </div>
        </div>
    </div>

    <section class="customer-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h4 class="panel-title">Recent Purchases</h4>
                <div class="panel-subtitle">
                    Your latest recorded store transactions
                </div>
            </div>

            <a asp-controller="CustomerPortal"
               asp-action="Purchases"
               class="btn btn-outline-primary rounded-pill px-3">
                View all purchases <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        @if (Model.Transactions.Any())
        {
            <div class="table-responsive">
                <table class="table customer-table table-hover">
                    <thead>
                        <tr>
                            <th>Transaction</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Paid</th>
                            <th>Payment</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sale in Model.Transactions.Take(5))
                        {
                            <tr>
                                <td class="transaction-number">
                                    #@sale.SaleId
                                </td>
                                <td>
                                    @sale.SaleDate.ToString("MMM dd, yyyy")
                                    <div class="small text-muted">
                                        @sale.SaleDate.ToString("hh:mm tt")
                                    </div>
                                </td>
                                <td>
                                    @(sale.SaleItems?.Sum(i => i.Quantity) ?? 0)
                                    item(s)
                                </td>
                                <td class="fw-semibold">
                                    ₱@sale.TotalAmount.ToString("N2")
                                </td>
                                <td>₱@sale.AmountPaid.ToString("N2")</td>
                                <td>@sale.PaymentMethod</td>
                                <td>
                                    @{
                                        var status = sale.Status ?? "Recorded";
                                        var statusClass = status.Equals(
                                            "Paid", StringComparison.OrdinalIgnoreCase)
                                            ? ""
                                            : status.Equals(
                                                "Unpaid", StringComparison.OrdinalIgnoreCase)
                                                || status.Equals(
                                                    "Pending", StringComparison.OrdinalIgnoreCase)
                                                ? "status-pending"
                                                : "status-neutral";
                                    }
                                    <span class="status-pill @statusClass">
                                        @status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-bag-x"></i>
                <h5 class="mt-3 fw-bold">No purchases yet</h5>
                <p class="mb-0">
                    Your purchases will appear here when recorded by the store.
                </p>
            </div>
        }
    </section>

    <section class="customer-panel">
        <div class="mb-3">
            <h4 class="panel-title">Quick Access</h4>
            <div class="panel-subtitle">
                Go directly to the information you need
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <a asp-controller="CustomerPortal"
                   asp-action="Purchases"
                   class="quick-link">
                    <span class="quick-link-icon">
                        <i class="bi bi-bag"></i>
                    </span>
                    <span class="flex-grow-1">
                        <strong class="d-block">My Purchases</strong>
                        <small class="text-muted">
                            View purchase history and items
                        </small>
                    </span>
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>

            <div class="col-12 col-md-6">
                <a asp-controller="CustomerPortal"
                   asp-action="Utang"
                   class="quick-link">
                    <span class="quick-link-icon">
                        <i class="bi bi-wallet2"></i>
                    </span>
                    <span class="flex-grow-1">
                        <strong class="d-block">My Utang</strong>
                        <small class="text-muted">
                            Check balances and due dates
                        </small>
                    </span>
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>
    </section>

</div>
