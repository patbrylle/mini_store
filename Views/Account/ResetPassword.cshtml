@model mini_store.ViewModels.Account.ResetPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="login-page">

    <span class="bg-blob bg-blob-1"></span>
    <span class="bg-blob bg-blob-2"></span>
    <span class="bg-blob bg-blob-3"></span>

    <div class="login-card">

        <div class="login-header">

            <div class="login-logo">
                <span class="logo-ring"></span>
                <span class="logo-ring logo-ring-delay"></span>
                <i class="bi bi-shield-lock"></i>
            </div>

            <h1>Reset Password</h1>
            <p>Create a new password for your <strong>Mini Store</strong> account.</p>
        </div>

        <form asp-action="ResetPassword" method="post" class="login-form">

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div class="form-group reveal" style="--i:1">
                <label asp-for="Password">New Password</label>
                <div class="input-wrap">
                    <i class="bi bi-key input-icon"></i>
                    <input asp-for="Password"
                           class="form-control"
                           placeholder="Enter your new password"
                           autocomplete="new-password" />
                    <button type="button" class="toggle-password" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>

                <div class="pw-meter" id="pwMeter" data-level="0">
                    <div class="pw-meter-bars">
                        <span></span><span></span><span></span><span></span>
                    </div>
                    <small class="pw-meter-text" id="pwMeterText">Enter a password</small>
                </div>
            </div>

            <div class="form-group reveal" style="--i:2">
                <label asp-for="ConfirmPassword">Confirm New Password</label>
                <div class="input-wrap">
                    <i class="bi bi-check2-circle input-icon"></i>
                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           placeholder="Confirm your new password"
                           autocomplete="new-password" />
                    <button type="button" class="toggle-password" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                <small class="match-text" id="matchText"></small>
            </div>

            <button type="submit" class="login-button reveal" style="--i:3">
                <span>Reset Password</span>
                <i class="bi bi-arrow-right"></i>
            </button>

        </form>

        <div class="forgot-footer">
            <a asp-controller="Account" asp-action="Login" class="back-link">
                <i class="bi bi-arrow-left"></i>
                <span>Back to Login</span>
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // show / hide toggles
            document.querySelectorAll('.toggle-password').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = btn.closest('.input-wrap').querySelector('input');
                    var icon  = btn.querySelector('i');
                    var show  = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
                    btn.classList.toggle('active', show);
                    btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                });
            });

            // strength meter + match check
            var pw      = document.getElementById('Password');
            var confirm = document.getElementById('ConfirmPassword');
            var meter   = document.getElementById('pwMeter');
            var meterTx = document.getElementById('pwMeterText');
            var matchTx = document.getElementById('matchText');
            var labels  = ['Enter a password', 'Weak', 'Fair', 'Good', 'Strong'];

            function score(v) {
                if (!v) return 0;
                var s = 0;
                if (v.length >= 8) s++;
                if (/[a-z]/.test(v) && /[A-Z]/.test(v)) s++;
                if (/\d/.test(v)) s++;
                if (/[^A-Za-z0-9]/.test(v)) s++;
                return Math.max(s, 1);
            }

            function updateMatch() {
                if (!confirm.value) { matchTx.textContent = ''; matchTx.className = 'match-text'; return; }
                var same = confirm.value === pw.value;
                matchTx.textContent = same ? 'Passwords match' : 'Passwords do not match yet';
                matchTx.className = 'match-text ' + (same ? 'ok' : 'bad');
            }

            pw.addEventListener('input', function () {
                var s = score(pw.value);
                meter.dataset.level = s;
                meterTx.textContent = labels[s];
                updateMatch();
            });
            confirm.addEventListener('input', updateMatch);
        })();
    </script>
}