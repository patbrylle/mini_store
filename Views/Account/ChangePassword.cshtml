@model mini_store.ViewModels.Account.ChangePasswordViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Change Password";
}

<div class="container-fluid">

    <div class="page-header">
        <div class="page-header-icon"><i class="bi bi-shield-lock"></i></div>
        <div>
            <h2>Change Password</h2>
            <p>Update your account password to keep your store data secure.</p>
        </div>
    </div>

    <div class="row g-4">

        <!-- FORM -->
        <div class="col-lg-7 col-xl-6">
            <div class="form-card">

                <form asp-action="ChangePassword" method="post">

                    <div asp-validation-summary="ModelOnly" class="form-alert-danger"></div>

                    <!-- Current Password -->
                    <div class="field">
                        <label asp-for="CurrentPassword" class="field-label">Current Password</label>
                        <div class="field-wrap">
                            <i class="bi bi-lock field-icon"></i>
                            <input asp-for="CurrentPassword"
                                   class="field-input"
                                   placeholder="Enter current password"
                                   autocomplete="current-password" />
                            <button type="button" class="field-toggle" aria-label="Show password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="field-error"></span>
                    </div>

                    <hr class="field-divider" />

                    <!-- New Password -->
                    <div class="field">
                        <label asp-for="NewPassword" class="field-label">New Password</label>
                        <div class="field-wrap">
                            <i class="bi bi-key field-icon"></i>
                            <input asp-for="NewPassword"
                                   class="field-input"
                                   placeholder="Enter new password"
                                   autocomplete="new-password" />
                            <button type="button" class="field-toggle" aria-label="Show password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="field-error"></span>

                        <!-- strength meter -->
                        <div class="pw-meter" id="pwMeter" data-level="0">
                            <div class="pw-meter-bars">
                                <span></span><span></span><span></span><span></span>
                            </div>
                            <small class="pw-meter-text" id="pwMeterText">Enter a password</small>
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="field">
                        <label asp-for="ConfirmPassword" class="field-label">Confirm New Password</label>
                        <div class="field-wrap">
                            <i class="bi bi-check2-circle field-icon"></i>
                            <input asp-for="ConfirmPassword"
                                   class="field-input"
                                   placeholder="Re-enter new password"
                                   autocomplete="new-password" />
                            <button type="button" class="field-toggle" aria-label="Show password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                        <small class="match-text" id="matchText"></small>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-brand">
                            <i class="bi bi-key-fill"></i>
                            <span>Change Password</span>
                        </button>

                        <a asp-controller="Dashboard" asp-action="Index" class="btn-soft">
                            Cancel
                        </a>
                    </div>

                </form>

            </div>
        </div>

        <!-- TIPS -->
        <div class="col-lg-5 col-xl-4">
            <div class="tips-card">
                <h6><i class="bi bi-lightbulb"></i> Password tips</h6>
                <ul class="pw-rules" id="pwRules">
                    <li data-rule="length"><i class="bi bi-circle"></i> At least 8 characters</li>
                    <li data-rule="case"><i class="bi bi-circle"></i> Upper and lowercase letters</li>
                    <li data-rule="number"><i class="bi bi-circle"></i> At least one number</li>
                    <li data-rule="symbol"><i class="bi bi-circle"></i> At least one symbol (!@@#$...)</li>
                </ul>
                <p class="tips-note">Avoid reusing passwords from other sites.</p>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            // ---- show / hide toggles ----
            document.querySelectorAll('.field-toggle').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = btn.closest('.field-wrap').querySelector('input');
                    var icon  = btn.querySelector('i');
                    var show  = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
                    btn.classList.toggle('active', show);
                    btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                });
            });

            // ---- strength meter + rules ----
            var newPw   = document.getElementById('NewPassword');
            var confirm = document.getElementById('ConfirmPassword');
            var meter   = document.getElementById('pwMeter');
            var meterTx = document.getElementById('pwMeterText');
            var matchTx = document.getElementById('matchText');
            var rules   = document.querySelectorAll('#pwRules li');
            var labels  = ['Enter a password', 'Weak', 'Fair', 'Good', 'Strong'];

            function checks(v) {
                return {
                    length: v.length >= 8,
                    case:   /[a-z]/.test(v) && /[A-Z]/.test(v),
                    number: /\d/.test(v),
                    symbol: /[^A-Za-z0-9]/.test(v)
                };
            }

            function updateStrength() {
                var v = newPw.value;
                var c = checks(v);
                var score = v ? Object.values(c).filter(Boolean).length : 0;
                if (v && score === 0) score = 1;

                meter.dataset.level = score;
                meterTx.textContent = labels[score];

                rules.forEach(function (li) {
                    var ok = c[li.dataset.rule];
                    li.classList.toggle('ok', ok);
                    li.querySelector('i').className = ok ? 'bi bi-check-circle-fill' : 'bi bi-circle';
                });
                updateMatch();
            }

            function updateMatch() {
                if (!confirm.value) { matchTx.textContent = ''; matchTx.className = 'match-text'; return; }
                var same = confirm.value === newPw.value;
                matchTx.textContent = same ? 'Passwords match' : 'Passwords do not match yet';
                matchTx.className = 'match-text ' + (same ? 'ok' : 'bad');
            }

            newPw.addEventListener('input', updateStrength);
            confirm.addEventListener('input', updateMatch);
        })();
    </script>
}