@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Check Your Email";
}

<div class="login-page">

    <span class="bg-blob bg-blob-1"></span>
    <span class="bg-blob bg-blob-2"></span>
    <span class="bg-blob bg-blob-3"></span>

    <div class="login-card">

        <div class="login-header">

            <div class="login-logo">
                <span class="logo-ring"></span>
                <span class="logo-ring logo-ring-delay"></span>
                <i class="bi bi-envelope-paper"></i>
                <span class="logo-badge"><i class="bi bi-check-lg"></i></span>
            </div>

            <h1>Check Your Email</h1>

            <p>
                If an account exists with that email address,
                you will receive instructions to reset your password.
            </p>
        </div>

        <div class="confirmation-message reveal" style="--i:1">
            <i class="bi bi-info-circle"></i>
            <p>
                Please check your email and follow the password reset instructions.
                Don't see it? Check your spam or junk folder.
            </p>
        </div>

        <a asp-controller="Account"
           asp-action="Login"
           class="login-button confirmation-button reveal"
           style="--i:2">
            <i class="bi bi-arrow-left"></i>
            <span>Back to Login</span>
        </a>

    </div>
</div>