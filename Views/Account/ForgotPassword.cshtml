@model mini_store.ViewModels.Account.ForgotPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="login-page">

    <span class="bg-blob bg-blob-1"></span>
    <span class="bg-blob bg-blob-2"></span>
    <span class="bg-blob bg-blob-3"></span>

    <div class="login-card">

        <div class="login-header">

            <div class="login-logo">
                <span class="logo-ring"></span>
                <span class="logo-ring logo-ring-delay"></span>
                <i class="bi bi-key"></i>
            </div>

            <h1>Forgot Password?</h1>
            <p>Enter your email address and we'll help you reset your password.</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success-soft">
                <i class="bi bi-check-circle-fill"></i>
                <span>@TempData["Success"]</span>
            </div>
        }

        <form asp-action="ForgotPassword" method="post" class="login-form">

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group reveal" style="--i:1">
                <label asp-for="Email">Email</label>
                <div class="input-wrap">
                    <i class="bi bi-envelope input-icon"></i>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter your email"
                           autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <button type="submit" class="login-button reveal" style="--i:2">
                <span>Continue</span>
                <i class="bi bi-arrow-right"></i>
            </button>

        </form>

        <div class="forgot-footer">
            <a asp-controller="Account" asp-action="Login" class="back-link">
                <i class="bi bi-arrow-left"></i>
                <span>Back to Login</span>
            </a>
        </div>

    </div>
</div>