@model mini_store.ViewModels.Account.LoginViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <span class="bg-blob bg-blob-1"></span>
    <span class="bg-blob bg-blob-2"></span>
    <span class="bg-blob bg-blob-3"></span>

    <div class="login-card">

        <div class="login-header">

            <div class="login-logo">
                <span class="logo-ring"></span>
                <span class="logo-ring logo-ring-delay"></span>
                <i class="bi bi-shop"></i>
            </div>

            <h1>Welcome Back</h1>
            <p>Sign in to <strong>Mini Store</strong> Management System</p>
        </div>

        <form asp-action="Login" method="post" class="login-form">

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group reveal" style="--i:1">
                <label asp-for="Email">Email</label>
                <div class="input-wrap">
                    <i class="bi bi-envelope input-icon"></i>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter your email"
                           autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group reveal" style="--i:2">
                <label asp-for="Password">Password</label>
                <div class="input-wrap">
                    <i class="bi bi-lock input-icon"></i>
                    <input asp-for="Password"
                           class="form-control"
                           placeholder="Enter your password"
                           autocomplete="current-password" />
                    <button type="button" class="toggle-password" aria-label="Show password" onclick="togglePassword(this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="remember-row reveal" style="--i:3">
                <label class="remember-check">
                    <input asp-for="RememberMe" />
                    <span>Remember me</span>
                </label>

                <a asp-controller="Account"
                   asp-action="ForgotPassword"
                   class="forgot-password">
                    Forgot Password?
                </a>
            </div>

            <button type="submit" class="login-button reveal" style="--i:4">
                <span>Sign In</span>
                <i class="bi bi-arrow-right"></i>
            </button>

        </form>

        <div class="login-footer">
            &copy; @DateTime.Now.Year Mini Store. All rights reserved.
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(btn) {
            const input = btn.closest('.input-wrap').querySelector('input');
            const icon  = btn.querySelector('i');
            const show  = input.type === 'password';

            input.type = show ? 'text' : 'password';
            icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            btn.classList.toggle('active', show);
            btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        }
    </script>
}