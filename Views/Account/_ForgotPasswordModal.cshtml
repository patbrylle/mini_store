<div class="modal fade fp-modal" id="forgotPasswordModal" tabindex="-1"
     aria-labelledby="fpTitle" aria-hidden="true"
     data-send-url="@Url.Action("SendResetCode", "Account")"
     data-reset-url="@Url.Action("ResetWithCode", "Account")">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            @Html.AntiForgeryToken()

            <div class="fp-head">
                <div class="fp-icon"><i class="bi bi-key"></i></div>
                <div class="me-auto">
                    <h5 id="fpTitle">Forgot password?</h5>
                    <p id="fpSub">We'll email you a 6-digit code to confirm it's you.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="fp-body">
                <div class="fp-alert is-error" id="fpError" role="alert" hidden></div>
                <div class="fp-alert is-demo" id="fpDemo" hidden></div>

                <!-- STEP 1: email -->
                <form id="fpStep1" novalidate>
                    <label class="fp-label" for="fpEmail">Email address</label>
                    <div class="fp-input">
                        <i class="bi bi-envelope"></i>
                        <input type="email" id="fpEmail" maxlength="100" autocomplete="email" placeholder="name@example.com" />
                    </div>
                    <button type="submit" class="fp-btn fp-btn-primary w-100 mt-3">Send code</button>
                </form>

                <!-- STEP 2: code + new password -->
                <form id="fpStep2" novalidate hidden>
                    <p class="fp-note">We sent a code to <strong id="fpSentTo"></strong>. It expires in a few minutes.</p>

                    <label class="fp-label" for="fpCode">6-digit code</label>
                    <div class="fp-input">
                        <i class="bi bi-123"></i>
                        <input type="text" id="fpCode" inputmode="numeric" maxlength="6"
                               autocomplete="one-time-code" placeholder="000000" />
                    </div>

                    <label class="fp-label mt-3" for="fpPw">New password</label>
                    <div class="fp-input">
                        <i class="bi bi-lock"></i>
                        <input type="password" id="fpPw" autocomplete="new-password" placeholder="New password" />
                        <button type="button" class="fp-eye" aria-label="Show password"><i class="bi bi-eye"></i></button>
                    </div>

                    <label class="fp-label mt-3" for="fpPw2">Confirm password</label>
                    <div class="fp-input">
                        <i class="bi bi-shield-lock"></i>
                        <input type="password" id="fpPw2" autocomplete="new-password" placeholder="Confirm password" />
                        <button type="button" class="fp-eye" aria-label="Show password"><i class="bi bi-eye"></i></button>
                    </div>

                    <small class="fp-note d-block mt-2">At least 8 characters with an uppercase letter, a lowercase letter, a number and a symbol.</small>

                    <button type="submit" class="fp-btn fp-btn-primary w-100 mt-3">Reset password</button>
                    <button type="button" class="fp-link" id="fpResend" disabled>Resend code</button>
                </form>

                <!-- DONE -->
                <div id="fpDone" class="text-center py-3" hidden>
                    <div class="fp-icon is-ok mx-auto mb-3"><i class="bi bi-check-lg"></i></div>
                    <h5>Password updated</h5>
                    <p class="fp-note">You can now sign in with your new password.</p>
                    <button type="button" class="fp-btn fp-btn-primary" data-bs-dismiss="modal">Back to sign in</button>
                </div>
            </div>

        </div>
    </div>
</div>