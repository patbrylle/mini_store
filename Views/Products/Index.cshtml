@model IEnumerable<mini_store.Models.Product>

@{
    ViewData["Title"] = "Products";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/products.css"
          asp-append-version="true" />
}

<div class="products-page">

    <!-- HEADER -->
    <div class="products-header">

        <div>
            <h1 class="products-title">Products</h1>

            <p class="products-subtitle">
                Manage your store products and inventory.
            </p>
        </div>

        <!-- ADD PRODUCT BUTTON -->
        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#addProductModal">

            <i class="bi bi-plus-lg"></i>
            Add Product

        </button>

    </div>


    <!-- PRODUCT TABLE -->
    <div class="card products-card shadow-sm border-0">

        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table products-table mb-0">

                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var product in Model)
                            {
                                <tr>

                                    <!-- PRODUCT -->
                                    <td>

                                        <div class="product-name">

                                            <div class="product-icon">
                                                <i class="bi bi-box-seam"></i>
                                            </div>

                                            <strong>
                                                @product.ProductName
                                            </strong>

                                        </div>

                                    </td>


                                    <!-- CATEGORY -->
                                    <td>

                                        @if (product.Category != null)
                                        {
                                            <span class="category-badge">
                                                @product.Category.CategoryName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Uncategorized
                                            </span>
                                        }

                                    </td>


                                    <!-- PRICE -->
                                    <td>

                                        <strong>
                                            ₱@product.Price.ToString("N2")
                                        </strong>

                                    </td>


                                    <!-- STOCK -->
                                    <td>

                                        @if (product.Quantity == 0)
                                        {
                                            <span class="stock-badge stock-out">
                                                Out of Stock
                                            </span>
                                        }
                                        else if (product.Quantity <= 10)
                                        {
                                            <span class="stock-badge stock-low">
                                                @product.Quantity Low Stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="stock-badge stock-good">
                                                @product.Quantity
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->
                                    <td class="text-end">

                                        <div class="product-actions">

                                            <!-- EDIT BUTTON -->
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary edit-product-btn"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editProductModal"
                                                    data-product-id="@product.ProductId"
                                                    data-product-name="@product.ProductName"
                                                    data-category-id="@product.CategoryId"
                                                    data-price="@product.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                    data-quantity="@product.Quantity">

                                                <i class="bi bi-pencil"></i>
                                                Edit

                                            </button>


                                            <!-- DELETE BUTTON -->
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger delete-product-btn"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteProductModal"
                                                    data-product-id="@product.ProductId"
                                                    data-product-name="@product.ProductName"
                                                    data-category="@product.Category?.CategoryName"
                                                    data-price="@product.Price.ToString("N2")"
                                                    data-stock="@product.Quantity">

                                                <i class="bi bi-trash"></i>
                                                Delete

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- EMPTY STATE -->

                <div class="products-empty">

                    <div class="empty-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>

                    <h5>No Products Yet</h5>

                    <p>
                        Start by adding your first product.
                    </p>

                    <button type="button"
                            class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#addProductModal">

                        <i class="bi bi-plus-lg"></i>
                        Add Product

                    </button>

                </div>
            }

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- ADD PRODUCT MODAL -->
<!-- ========================================================= -->

<div class="modal fade"
     id="addProductModal"
     tabindex="-1"
     aria-labelledby="addProductModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content product-modal">

            <!-- HEADER -->
            <div class="modal-header">

                <div>

                    <h5 class="modal-title fw-bold"
                        id="addProductModalLabel">

                        <i class="bi bi-box-seam me-2"></i>
                        Add Product

                    </h5>

                    <small class="text-muted">
                        Add a new product to your store.
                    </small>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- FORM -->
            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <!-- PRODUCT NAME -->
                    <div class="mb-3">

                        <label class="form-label">
                            Product Name
                        </label>

                        <input type="text"
                               name="ProductName"
                               class="form-control"
                               placeholder="Enter product name"
                               required />

                    </div>


                    <!-- CATEGORY -->
                    <div class="mb-3">

                        <label class="form-label">
                            Category
                        </label>

                        <select name="CategoryId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Category --
                            </option>

                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.Value">
                                    @category.Text
                                </option>
                            }

                        </select>

                    </div>


                    <!-- PRICE + QUANTITY -->
                    <div class="row">

                        <div class="col-md-6">

                            <div class="mb-3">

                                <label class="form-label">
                                    Price
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₱
                                    </span>

                                    <input type="number"
                                           name="Price"
                                           class="form-control"
                                           step="0.01"
                                           min="0"
                                           placeholder="0.00"
                                           required />

                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="mb-3">

                                <label class="form-label">
                                    Quantity
                                </label>

                                <input type="number"
                                       name="Quantity"
                                       class="form-control"
                                       min="0"
                                       placeholder="0"
                                       required />

                            </div>

                        </div>

                    </div>

                </div>


                <!-- FOOTER -->
                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light border"
                            data-bs-dismiss="modal">

                        <i class="bi bi-x-lg"></i>
                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg"></i>
                        Save Product

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- EDIT PRODUCT MODAL -->
<!-- ========================================================= -->

<div class="modal fade"
     id="editProductModal"
     tabindex="-1"
     aria-labelledby="editProductModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content product-modal">

            <!-- HEADER -->
            <div class="modal-header">

                <div>

                    <h5 class="modal-title fw-bold"
                        id="editProductModalLabel">

                        <i class="bi bi-pencil-square me-2"></i>
                        Edit Product

                    </h5>

                    <small class="text-muted">
                        Update the product information.
                    </small>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- FORM -->
            <form asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <!-- PRODUCT ID -->
                    <input type="hidden"
                           id="editProductId"
                           name="ProductId" />


                    <!-- PRODUCT NAME -->
                    <div class="mb-3">

                        <label class="form-label">
                            Product Name
                        </label>

                        <input type="text"
                               id="editProductName"
                               name="ProductName"
                               class="form-control"
                               placeholder="Enter product name"
                               required />

                    </div>


                    <!-- CATEGORY -->
                    <div class="mb-3">

                        <label class="form-label">
                            Category
                        </label>

                        <select id="editCategoryId"
                                name="CategoryId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Category --
                            </option>

                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.Value">
                                    @category.Text
                                </option>
                            }

                        </select>

                    </div>


                    <!-- PRICE + QUANTITY -->
                    <div class="row">

                        <div class="col-md-6">

                            <div class="mb-3">

                                <label class="form-label">
                                    Price
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₱
                                    </span>

                                    <input type="number"
                                           id="editPrice"
                                           name="Price"
                                           class="form-control"
                                           step="0.01"
                                           min="0"
                                           required />

                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="mb-3">

                                <label class="form-label">
                                    Quantity
                                </label>

                                <input type="number"
                                       id="editQuantity"
                                       name="Quantity"
                                       class="form-control"
                                       min="0"
                                       required />

                            </div>

                        </div>

                    </div>

                </div>


                <!-- FOOTER -->
                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light border"
                            data-bs-dismiss="modal">

                        <i class="bi bi-x-lg"></i>
                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg"></i>
                        Update Product

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- DELETE PRODUCT MODAL -->
<!-- ========================================================= -->

<div class="modal fade"
     id="deleteProductModal"
     tabindex="-1"
     aria-labelledby="deleteProductModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content delete-modal">

            <!-- HEADER -->
            <div class="modal-header">

                <div>

                    <h5 class="modal-title fw-bold text-danger"
                        id="deleteProductModalLabel">

                        <i class="bi bi-trash3 me-2"></i>
                        Delete Product

                    </h5>

                    <small class="text-muted">
                        This action will permanently remove the product.
                    </small>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- FORM -->
            <form asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <!-- PRODUCT ID -->
                    <input type="hidden"
                           id="deleteProductId"
                           name="id" />


                    <!-- DELETE ICON -->
                    <div class="delete-icon">

                        <i class="bi bi-trash3"></i>

                    </div>


                    <h5 class="text-center mt-3">
                        Are you sure?
                    </h5>


                    <p class="text-muted text-center mb-4">

                        You are about to delete:

                        <strong id="deleteProductName"></strong>

                    </p>


                    <!-- PRODUCT INFORMATION -->
                    <div class="product-info">

                        <div class="info-row">

                            <span>
                                Product
                            </span>

                            <strong id="deleteProductNameInfo">
                            </strong>

                        </div>


                        <div class="info-row">

                            <span>
                                Category
                            </span>

                            <strong id="deleteProductCategory">
                            </strong>

                        </div>


                        <div class="info-row">

                            <span>
                                Price
                            </span>

                            <strong id="deleteProductPrice">
                            </strong>

                        </div>


                        <div class="info-row">

                            <span>
                                Stock
                            </span>

                            <strong id="deleteProductStock">
                            </strong>

                        </div>

                    </div>


                    <!-- WARNING -->
                    <p class="text-danger small text-center mt-3 mb-0">

                        <i class="bi bi-exclamation-triangle"></i>

                        This action cannot be undone.

                    </p>

                </div>


                <!-- FOOTER -->
                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light border"
                            data-bs-dismiss="modal">

                        <i class="bi bi-x-lg"></i>
                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash3"></i>
                        Delete Product

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script src="~/js/products.js"
            asp-append-version="true"></script>

}