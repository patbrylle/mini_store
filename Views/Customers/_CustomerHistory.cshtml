@model mini_store.Models.CustomerHistoryVm
@using mini_store.Models

<div class="tx-info-grid mb-3">
    <div class="tx-info"><span>Transactions</span><strong>@Model.Sales.Count</strong></div>
    <div class="tx-info"><span>Total purchases</span><strong>₱@Model.TotalPurchases.ToString("N2")</strong></div>
    <div class="tx-info @(Model.Outstanding > 0 ? "is-danger" : "")">
        <span>Outstanding utang</span><strong>₱@Model.Outstanding.ToString("N2")</strong>
    </div>
    <div class="tx-info @(Model.OverdueCount > 0 ? "is-danger" : "")">
        <span>Overdue</span><strong>@Model.OverdueCount</strong>
    </div>
</div>

<ul class="nav nav-pills customer-history-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#chTxnPane" type="button" role="tab">
            <i class="bi bi-receipt"></i> Transactions (@Model.Sales.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chUtangPane" type="button" role="tab">
            <i class="bi bi-wallet2"></i> Utang Records (@Model.Utangs.Count)
        </button>
    </li>
</ul>

<div class="tab-content">

    <!-- TRANSACTIONS -->
    <div class="tab-pane fade show active" id="chTxnPane" role="tabpanel">
        @if (Model.Sales.Count == 0)
        {
            <p class="tx-muted">No transactions yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="tx-table">
                    <thead>
                        <tr>
                            <th>Transaction</th><th>Type</th>
                            <th class="text-center">Items</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Paid</th>
                            <th>Status</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var s in Model.Sales)
                    {
                        var key = TxStatus.Key(s.Status);
                        <tr>
                            <td>
                                <strong>@s.TransactionNo</strong>
                                <small class="d-block text-muted">@s.SaleDate.ToString("MMM dd, yyyy · hh:mm tt")</small>
                            </td>
                            <td>@s.PaymentMethod</td>
                            <td class="text-center">@s.SaleItems.Sum(i => i.Quantity)</td>
                            <td class="text-end">₱@s.TotalAmount.ToString("N2")</td>
                            <td class="text-end">₱@s.AmountPaid.ToString("N2")</td>
                            <td><span class="tx-pill @key"><span class="tx-dot"></span>@s.Status</span></td>
                            <td class="text-end">
                                <button type="button" class="tx-btn tx-btn-ghost tx-btn-sm" data-tx-view="@s.SaleId">
                                    <i class="bi bi-eye"></i> View
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- UTANG -->
    <div class="tab-pane fade" id="chUtangPane" role="tabpanel">
        @if (Model.Utangs.Count == 0)
        {
            <p class="tx-muted">No utang records.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="tx-table">
                    <thead>
                        <tr>
                            <th>Transaction</th><th>Due date</th>
                            <th class="text-end">Amount</th>
                            <th class="text-end">Paid</th>
                            <th class="text-end">Balance</th>
                            <th>Status</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var u in Model.Utangs)
                    {
                        var key = TxStatus.Key(u.Status);
                        <tr>
                            <td>
                                <strong>@(u.Sale?.TransactionNo ?? $"Utang #{u.UtangId}")</strong>
                                <small class="d-block text-muted">@u.DateCreated.ToString("MMM dd, yyyy")</small>
                            </td>
                            <td>@(u.DueDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                            <td class="text-end">₱@u.Amount.ToString("N2")</td>
                            <td class="text-end text-success">₱@u.AmountPaid.ToString("N2")</td>
                            <td class="text-end"><strong class="@(u.Balance > 0 ? "text-danger" : "")">₱@u.Balance.ToString("N2")</strong></td>
                            <td>
                                @if (u.IsOverdue)
                                {
                                    <span class="tx-pill overdue"><i class="bi bi-exclamation-circle-fill"></i> Overdue</span>
                                }
                                else
                                {
                                    <span class="tx-pill @key"><span class="tx-dot"></span>@u.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="tx-btn tx-btn-ghost tx-btn-sm" data-tx-view="@u.SaleId">
                                    <i class="bi @(u.Balance > 0 ? "bi-cash-coin" : "bi-eye")"></i>
                                    @(u.Balance > 0 ? "View / Pay" : "View")
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>