@model IEnumerable<mini_store.Models.Customer>

@{
    ViewData["Title"] = "Customers";

    var customers = Model?.ToList() ?? new List<mini_store.Models.Customer>();
    var balances = ViewBag.Balances as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();

    int totalCustomers = customers.Count;
    int withLogin = customers.Count(c => !string.IsNullOrEmpty(c.UserId));
    int withUtang = balances.Count;
    decimal outstanding = balances.Values.Sum();
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/transactions.css" asp-append-version="true" />
}

<div class="customer-page">

    <!-- PAGE HEADER -->
    <div class="customer-header">

        <div class="customer-title-area">

            <div class="customer-page-icon">
                <i class="bi bi-people"></i>
            </div>

            <div>
                <h1>Customers</h1>
                <p>Manage your store customers and their information.</p>
            </div>

        </div>

        <button type="button"
                class="btn customer-primary-btn"
                data-bs-toggle="modal"
                data-bs-target="#addCustomerModal">
            <i class="bi bi-plus-lg"></i>
            Add Customer
        </button>

    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert fade show customer-alert is-warning" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@(string.Join(" ", ViewData.ModelState.Values
                .SelectMany(v => v.Errors)
                .Select(e => e.ErrorMessage)))</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- SUMMARY CARDS -->
    <div class="row g-3 customer-kpi-row">
        <div class="col-xl-3 col-md-6">
            <div class="customer-stat-card is-primary" style="--i:0">
                <div class="customer-stat-icon"><i class="bi bi-people"></i></div>
                <div class="customer-stat-body">
                    <span class="customer-stat-label">Total Customers</span>
                    <h3>@totalCustomers</h3>
                    <small>Registered customers</small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="customer-stat-card is-success" style="--i:1">
                <div class="customer-stat-icon"><i class="bi bi-person-check"></i></div>
                <div class="customer-stat-body">
                    <span class="customer-stat-label">With Login</span>
                    <h3>@withLogin</h3>
                    <small>Can use the customer portal</small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="customer-stat-card is-gold" style="--i:2">
                <div class="customer-stat-icon"><i class="bi bi-journal-text"></i></div>
                <div class="customer-stat-body">
                    <span class="customer-stat-label">Customers with Utang</span>
                    <h3>@withUtang</h3>
                    <small>Have an unpaid balance</small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="customer-stat-card is-danger" style="--i:3">
                <div class="customer-stat-icon"><i class="bi bi-wallet2"></i></div>
                <div class="customer-stat-body">
                    <span class="customer-stat-label">Outstanding Utang</span>
                    <h3>₱@outstanding.ToString("N2")</h3>
                    <small>Total still to collect</small>
                </div>
            </div>
        </div>
    </div>

    <!-- CUSTOMER DIRECTORY -->
    <div class="customer-table-card">

        <div class="customer-table-header">

            <div class="customer-section-title">

                <div class="customer-section-icon">
                    <i class="bi bi-person-vcard"></i>
                </div>

                <div>
                    <h5>Customer Directory</h5>
                    <p>View and manage registered customers.</p>
                </div>

            </div>

            <div class="customer-tools">

                <span class="customer-count">@totalCustomers total</span>

                <div class="customer-search">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           id="customerSearch"
                           placeholder="Search customer..."
                           aria-label="Search customers"
                           autocomplete="off" />
                </div>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table customer-table" id="customerTable">

                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Contact</th>
                        <th>Address</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (customers.Any())
                    {
                        foreach (var customer in customers)
                        {
                            string name = customer.CustomerName ?? "";
                            string initial = name.Length > 0 ? name.Substring(0, 1).ToUpper() : "?";

                            <tr>

                                <!-- CUSTOMER -->
                                <td>
                                    <div class="customer-cell">
                                        <div class="customer-avatar">@initial</div>
                                        <span class="customer-name">@customer.CustomerName</span>

                                        @if (!string.IsNullOrEmpty(customer.UserId))
                                        {
                                            <span class="customer-login-badge"
                                                  title="This customer can log in to the customer portal">
                                                <i class="bi bi-person-check-fill"></i> Login
                                            </span>
                                        }

                                        @if (balances.TryGetValue(customer.CustomerId, out var owed))
                                        {
                                            <span class="customer-owes-badge" title="Unpaid utang balance">Owes ₱@owed.ToString("N2")</span>
                                        }
                                    </div>
                                </td>

                                <!-- EMAIL -->
                                <td class="customer-email">
                                    @if (!string.IsNullOrWhiteSpace(customer.Email))
                                    {
                                        <span class="customer-meta">
                                            <i class="bi bi-envelope"></i>
                                            @customer.Email
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="customer-none">Not provided</span>
                                    }
                                </td>

                                <!-- CONTACT -->
                                <td class="customer-contact">
                                    @if (!string.IsNullOrWhiteSpace(customer.ContactNumber))
                                    {
                                        <span class="customer-meta">
                                            <i class="bi bi-telephone"></i>
                                            @customer.ContactNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="customer-none">Not provided</span>
                                    }
                                </td>

                                <!-- ADDRESS -->
                                <td class="customer-address">
                                    @if (!string.IsNullOrWhiteSpace(customer.Address))
                                    {
                                        <span class="customer-address-text" title="@customer.Address">
                                            @customer.Address
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="customer-none">Not provided</span>
                                    }
                                </td>

                                <!-- ACTIONS -->
                                <td>
                                    <div class="customer-actions">

                                        <button type="button"
                                                class="btn customer-action-btn customer-history-btn"
                                                title="Transactions and utang history"
                                                data-bs-toggle="modal"
                                                data-bs-target="#customerHistoryModal"
                                                data-url="@Url.Action("History", "Customers", new { id = customer.CustomerId })"
                                                data-name="@customer.CustomerName">
                                            <i class="bi bi-clock-history"></i>
                                            <span>History</span>
                                        </button>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <button type="button"
                                                    class="btn customer-action-btn customer-edit-btn"
                                                    title="Edit customer"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editCustomerModal-@customer.CustomerId">
                                                <i class="bi bi-pencil"></i><span>Edit</span>
                                            </button>

                                            <button type="button"
                                                    class="btn customer-action-btn customer-delete-btn"
                                                    title="Delete customer"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteCustomerModal-@customer.CustomerId">
                                                <i class="bi bi-trash"></i><span>Delete</span>
                                            </button>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">

                                <div class="customer-empty">

                                    <div class="customer-empty-icon">
                                        <i class="bi bi-people"></i>
                                    </div>

                                    <h5>No Customers</h5>
                                    <p>There are currently no registered customers.</p>

                                    <button type="button"
                                            class="btn customer-primary-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#addCustomerModal">
                                        <i class="bi bi-plus-lg"></i>
                                        Add Customer
                                    </button>

                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- shown when the search matches nothing -->
        <div class="customer-empty" id="customerNoResults" hidden>
            <div class="customer-empty-icon">
                <i class="bi bi-search"></i>
            </div>
            <h5>No matching customers</h5>
            <p>Try a different name, email or number.</p>
        </div>

    </div>

</div>

<!-- ADD CUSTOMER MODAL -->
<div class="modal fade" id="addCustomerModal" tabindex="-1" aria-labelledby="addCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content customer-modal">

            <form asp-controller="Customers" asp-action="Create" method="post">

                <div class="modal-header customer-modal-header">
                    <div class="customer-modal-title">
                        <div class="customer-modal-icon"><i class="bi bi-person-plus"></i></div>
                        <div>
                            <h5 id="addCustomerModalLabel">Add Customer</h5>
                            <p>Enter the customer's information.</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body customer-modal-body">
                    @{ var addFields = ("add", (mini_store.Models.Customer?)null, false); }
                    <partial name="_CustomerFields" model="addFields" />
                </div>

                <div class="modal-footer customer-modal-footer">
                    <button type="button" class="btn customer-cancel-btn" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn customer-save-btn">
                        <i class="bi bi-check-lg me-1"></i> Add Customer
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<!-- HISTORY MODAL (body loaded by customer.js) -->
<div class="modal fade" id="customerHistoryModal" tabindex="-1" aria-labelledby="customerHistoryTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content customer-modal">

            <div class="modal-header customer-modal-header">
                <div class="customer-modal-title">
                    <div class="customer-modal-icon"><i class="bi bi-clock-history"></i></div>
                    <div>
                        <h5 id="customerHistoryTitle">Customer History</h5>
                        <p>Transactions and utang records.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body customer-modal-body" id="customerHistoryBody">
                <!-- loaded by customer.js -->
            </div>

        </div>
    </div>
</div>

@{
    ViewData["DefaultTransactionType"] = "Cash";
}
<partial name="_TransactionModal" model="(mini_store.Models.TransactionFormData)ViewBag.Form" />

<!-- ============================================================
     EDIT + DELETE MODALS (admin only)
     ============================================================ -->
@if (User.IsInRole("Admin"))
{
    foreach (var customer in customers)
    {
        var hasLogin = !string.IsNullOrEmpty(customer.UserId);
        var editFields = ($"edit-{customer.CustomerId}", customer, hasLogin);

        <!-- EDIT CUSTOMER MODAL -->
        <div class="modal fade"
             id="editCustomerModal-@customer.CustomerId"
             tabindex="-1"
             aria-labelledby="editCustomerModalLabel-@customer.CustomerId"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content customer-modal">

                    <form asp-controller="Customers" asp-action="Edit" method="post">

                        <!-- Controller expects Edit(int id, Customer customer),
                             so BOTH id and CustomerId are posted -->
                        <input type="hidden" name="id" value="@customer.CustomerId" />
                        <input type="hidden" name="CustomerId" value="@customer.CustomerId" />

                        <div class="modal-header customer-modal-header">
                            <div class="customer-modal-title">
                                <div class="customer-modal-icon"><i class="bi bi-pencil"></i></div>
                                <div>
                                    <h5 id="editCustomerModalLabel-@customer.CustomerId">Edit Customer</h5>
                                    <p>Update customer information.</p>
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body customer-modal-body">
                            <partial name="_CustomerFields" model="editFields" />
                        </div>

                        <div class="modal-footer customer-modal-footer">
                            <button type="button" class="btn customer-cancel-btn" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn customer-save-btn">
                                <i class="bi bi-check-lg me-1"></i> Save Changes
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>

        <!-- DELETE CUSTOMER MODAL -->
        <div class="modal fade"
             id="deleteCustomerModal-@customer.CustomerId"
             tabindex="-1"
             aria-labelledby="deleteCustomerModalLabel-@customer.CustomerId"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content customer-modal">

                    <div class="modal-header customer-modal-header">
                        <div class="customer-modal-title">
                            <div class="customer-modal-icon is-danger"><i class="bi bi-trash"></i></div>
                            <div>
                                <h5 id="deleteCustomerModalLabel-@customer.CustomerId">Delete Customer</h5>
                                <p>This action cannot be undone.</p>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body customer-modal-body">
                        <p class="customer-delete-text">
                            Are you sure you want to delete
                            <strong>@customer.CustomerName</strong>?
                        </p>

                        @if (hasLogin)
                        {
                            <p class="customer-hint">
                                <i class="bi bi-exclamation-triangle"></i>
                                This also deletes their customer-portal login.
                            </p>
                        }
                    </div>

                    <div class="modal-footer customer-modal-footer">
                        <button type="button" class="btn customer-cancel-btn" data-bs-dismiss="modal">Cancel</button>

                        <form asp-controller="Customers" asp-action="Delete" method="post">
                            <input type="hidden" name="id" value="@customer.CustomerId" />
                            <button type="submit" class="btn customer-delete-confirm">
                                <i class="bi bi-trash me-1"></i> Delete Customer
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script src="~/js/transactions.js" asp-append-version="true"></script>
    <script src="~/js/customer.js" asp-append-version="true"></script>
}