@model List<mini_store.ViewModels.Notification.NotificationViewModel>

@{
    ViewData["Title"] = "Notifications";
}

<div class="page-header">
    <div>
        <h2>Notifications</h2>
        <p>View important updates and alerts from your store.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-bell-slash"
                   style="font-size: 3rem;">
                </i>

                <h5 class="mt-3">
                    No notifications
                </h5>

                <p class="text-muted">
                    Everything looks good for now.
                </p>

            </div>
        }
        else
        {
            @foreach (var notification in Model)
            {
               <a asp-controller="Notification"
   asp-action="Open"
   asp-route-id="@notification.NotificationId"
   class="text-decoration-none text-dark">

<div class="notification-item d-flex align-items-center gap-3 p-3 @(notification.IsRead ? "" : "notification-unread")">
                        <div class="notification-icon">
                            <i class="bi @notification.Icon"></i>
                        </div>

                        <div class="notification-content flex-grow-1">

                          <h6 class="mb-1 @(notification.IsRead ? "" : "fw-bold")">
    @notification.Title
</h6>

                            <p class="mb-1">
                                @notification.Message
                            </p>

                            <small class="text-muted">
                                @notification.CreatedAt.ToString("MMM dd, yyyy h:mm tt")
                            </small>

                        </div>

<div class="notification-arrow">
    <i class="bi bi-chevron-right"></i>
</div>
                    </div>

                </a>

                <hr class="my-0" />
            }
        }

    </div>
</div>
