@model IEnumerable<mini_store.Models.Utang>

@{
    ViewData["Title"] = "Utang Records";

    var records = Model?.ToList() ?? new List<mini_store.Models.Utang>();

    var totalUtang = records.Sum(u => u.Amount);
    var totalPaid = records.Sum(u => u.AmountPaid);
    var totalBalance = records.Sum(u => u.Balance);
    var totalRecords = records.Count;

    var unpaidRecords = records.Count(u => u.Status == "Unpaid");
    var partialRecords = records.Count(u => u.Status == "Partial");
    var paidRecords = records.Count(u => u.Status == "Paid");
    var overdueRecords = records.Count(u =>
    u.DueDate.HasValue &&
    u.DueDate.Value.Date < DateTime.Today &&
    u.Balance > 0);
}

@section Styles {
    <link rel="stylesheet" href="~/css/utang.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sales.css" asp-append-version="true" />
}

<div class="utang-page">


<!-- PAGE HEADER -->
<div class="utang-header">

    <div class="utang-title-area">

        <div class="utang-page-icon">
            <i class="bi bi-wallet2"></i>
        </div>

        <div>
            <h1>Utang Records</h1>
            <p>Manage customer credit and outstanding balances.</p>
        </div>

    </div>

    <button type="button"
            class="btn utang-primary-btn"
            data-bs-toggle="modal"
            data-bs-target="#newSaleModal">

        <i class="bi bi-plus-lg"></i>
        Record Utang

    </button>

</div>


<!-- SUMMARY CARDS -->
<div class="row g-3 mb-4">

    <div class="col-xl-4 col-md-6">

        <div class="utang-stat-card">

            <div class="utang-stat-icon stat-orange">
                <i class="bi bi-wallet2"></i>
            </div>

            <div>

                <span class="utang-stat-label">
                    Total Utang
                </span>

                <h3>
                    ₱@totalUtang.ToString("N2")
                </h3>

                <small>
                    @totalRecords credit record(s)
                </small>

            </div>

        </div>

    </div>


    <div class="col-xl-4 col-md-6">

        <div class="utang-stat-card">

            <div class="utang-stat-icon stat-green">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>

                <span class="utang-stat-label">
                    Total Paid
                </span>

                <h3 class="text-success">
                    ₱@totalPaid.ToString("N2")
                </h3>

                <small>
                    Payments received
                </small>

            </div>

        </div>

    </div>


    <div class="col-xl-4 col-md-6">

        <div class="utang-stat-card">

            <div class="utang-stat-icon stat-red">
                <i class="bi bi-exclamation-circle"></i>
            </div>

            <div>

                <span class="utang-stat-label">
                    Remaining Balance
                </span>

                <h3 class="text-danger">
                    ₱@totalBalance.ToString("N2")
                </h3>

                <small>
                    Amount still to collect
                </small>

            </div>

        </div>

    </div>

</div>


<!-- STATUS SUMMARY -->
<div class="utang-status-summary">

    <div class="utang-status-item">

        <span class="status-dot status-dot-red"></span>

        <div>
            <strong>@unpaidRecords</strong>
            <span>Unpaid</span>
        </div>

    </div>


    <div class="utang-status-item">

        <span class="status-dot status-dot-yellow"></span>

        <div>
            <strong>@partialRecords</strong>
            <span>Partial</span>
        </div>

    </div>


    <div class="utang-status-item">

        <span class="status-dot status-dot-green"></span>

        <div>
            <strong>@paidRecords</strong>
            <span>Paid</span>
        </div>
        <div class="utang-status-item">

    <span class="status-dot status-dot-overdue"></span>

    <div>
        <strong>@overdueRecords</strong>
        <span>Overdue</span>
    </div>

</div>

    </div>

</div>


<!-- UTANG TABLE -->
<div class="utang-table-card">

    <div class="utang-table-header">

        <div class="utang-section-title">

            <div class="section-icon">
                <i class="bi bi-people"></i>
            </div>

            <div>

                <h5>Customer Utang</h5>

                <p>
                    Customers with credit records and outstanding balances.
                </p>

            </div>

        </div>


        <div class="utang-search">

            <i class="bi bi-search"></i>

            <input type="text"
                   id="utangSearch"
                   placeholder="Search customer..."
                   autocomplete="off" />

        </div>

    </div>


    <!-- TABLE -->
    <div class="table-responsive">

        <table class="table utang-table"
               id="utangTable">

            <thead>

                <tr>

                    <th>Customer</th>

                    <th>Date</th>
                    <th>Due Date</th>

                    <th>Total Utang</th>

                    <th>Paid</th>

                    <th>Balance</th>

                    <th>Status</th>

                    <th class="text-end">
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (records.Any())
                {

                    foreach (var utang in records)
                    {

                        string statusClass =
                            utang.Status?.ToLower() switch
                            {
                                "paid" => "status-paid",
                                "partial" => "status-partial",
                                _ => "status-unpaid"
                            };


                        <tr>

                            <!-- CUSTOMER -->
                            <td>

                                <div class="customer-cell">

                                    <div class="customer-avatar">
                                        <i class="bi bi-person"></i>
                                    </div>

                                    <div>

                                        <strong>
                                            @(utang.Customer?.CustomerName
                                                ?? "Unknown Customer")
                                        </strong>

                                    </div>

                                </div>

                            </td>


                            <!-- DATE -->
                            <td>

                                <div class="utang-date-cell">

                                    <strong>
                                        @(utang.Sale?.SaleDate.ToString("MMM dd, yyyy")
                                            ?? utang.DateCreated.ToString("MMM dd, yyyy"))
                                    </strong>

                                    <small>
                                        @(utang.Sale?.SaleDate.ToString("hh:mm tt")
                                            ?? utang.DateCreated.ToString("hh:mm tt"))
                                    </small>

                                </div>

                            </td>
                            <!-- DUE DATE -->
<td>

    @if (utang.DueDate.HasValue)
    {
        <div class="utang-date-cell">

            <strong>
                @utang.DueDate.Value.ToString("MMM dd, yyyy")
            </strong>

            @if (utang.Status != "Paid" &&
                 utang.DueDate.Value.Date < DateTime.Today)
            {
                <small class="text-danger fw-semibold">
                    Overdue
                </small>
            }
            else if (utang.Status != "Paid" &&
                     utang.DueDate.Value.Date == DateTime.Today)
            {
                <small class="text-warning fw-semibold">
                    Due Today
                </small>
            }

        </div>
    }
    else
    {
        <span class="text-muted">
            No due date
        </span>
    }

</td>


                            <!-- TOTAL -->
                            <td>

                                <span class="amount-text">
                                    ₱@utang.Amount.ToString("N2")
                                </span>

                            </td>


                            <!-- PAID -->
                            <td>

                                <span class="paid-amount">
                                    ₱@utang.AmountPaid.ToString("N2")
                                </span>

                            </td>


                            <!-- BALANCE -->
                            <td>

                                <span class="balance-amount">
                                    ₱@utang.Balance.ToString("N2")
                                </span>

                            </td>


                           <!-- STATUS -->
<td>

    @{
        bool isOverdue =
            utang.DueDate.HasValue &&
            utang.DueDate.Value.Date < DateTime.Today &&
            utang.Balance > 0;
    }

    @if (isOverdue)
    {
        <span class="utang-status status-overdue">
            <span></span>
            <i class="bi bi-exclamation-circle-fill me-1"></i>
            Overdue
        </span>
    }
    else
    {
        <span class="utang-status @statusClass">

            <span></span>

            @(utang.Status ?? "Unpaid")

        </span>
    }

</td>

                            <!-- ACTION -->
                            <td class="text-end">
                                <!-- VIEW BUTTON -->
                                <button type="button"
                                        class="btn view-utang-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#utangDetailsModal-@utang.UtangId">
                                    <i class="bi bi-eye"></i>
                                    View
                                </button>

                                <!-- DELETE BUTTON - ONLY IF PAID -->
                                @if (utang.Status == "Paid" && utang.Balance <= 0)
                                {
                                    <form asp-controller="Utang"
                                          asp-action="Delete"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this paid utang record?');">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@utang.UtangId" />

                                        <button type="submit"
                                                class="btn utang-delete-btn">
                                            <i class="bi bi-trash"></i>
                                            Delete
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>

                    }

                }
                else
                {

                    <tr>

                        <td colspan="8"
                            class="text-center py-5">

                            <div class="text-muted">

                                <i class="bi bi-wallet2 fs-2"></i>

                                <div class="mt-2">
                                    No Utang Records
                                </div>

                            </div>

                        </td>

                    </tr>

                }

            </tbody>

        </table>

    </div>


    <!-- EMPTY STATE -->
    @if (!records.Any())
    {

        <div class="utang-empty">

            <div class="utang-empty-icon">
                <i class="bi bi-wallet2"></i>
            </div>

            <h5>No Utang Records</h5>

            <p>
                There are currently no customer credit records.
            </p>

            <button type="button"
                    class="btn utang-primary-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#newSaleModal">

                <i class="bi bi-plus-lg"></i>

                Record Utang

            </button>

        </div>

    }

</div>


</div>

@if (TempData["TransactionError"] is string transactionError)
{
    <div class="alert alert-danger" role="alert">
        @transactionError
    </div>
}

<partial name="_UtangTransactionModal" />

@if (records.Any())
{
    foreach (var utang in records)
    {
        <partial name="UtangDetailsModal"
                 model="utang" />
    }
}


@section Scripts {


<script src="~/js/utang.js"
       asp-append-version="true"></script>

<script src="~/js/sales.js"
        asp-append-version="true"></script>

}
