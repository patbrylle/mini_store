
@model IEnumerable<mini_store.Models.Utang>

@{
    ViewData["Title"] = "Utang Records";
    ViewData["ReturnTo"] = "Utang";
    ViewData["DefaultTransactionType"] = "Utang";

    var records = Model?.ToList() ?? new List<mini_store.Models.Utang>();

    bool IsOverdue(mini_store.Models.Utang u) =>
        u.DueDate.HasValue &&
        u.DueDate.Value.Date < DateTime.Today &&
        u.Balance > 0;

    string StatusKey(mini_store.Models.Utang u) =>
        u.Status?.ToLowerInvariant() switch
        {
            "paid" => "paid",
            "partial" => "partial",
            _ => "unpaid"
        };

    var totalUtang = records.Sum(u => u.Amount);
    var totalPaid = records.Sum(u => u.AmountPaid);
    var totalBalance = records.Sum(u => u.Balance);
    int totalRecords = records.Count;

    int unpaidRecords = records.Count(u => StatusKey(u) == "unpaid");
    int partialRecords = records.Count(u => StatusKey(u) == "partial");
    int paidRecords = records.Count(u => StatusKey(u) == "paid");

    var overdueList = records.Where(IsOverdue).ToList();
    int overdueRecords = overdueList.Count;
    var overdueBalance = overdueList.Sum(u => u.Balance);

    var successMsg =
        (TempData["UtangSuccess"] ?? TempData["SuccessMessage"]) as string;

    var errorMsg =
        (TempData["UtangError"]
        ?? TempData["ErrorMessage"]
        ?? TempData["TransactionError"]) as string;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/utang.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/sales.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/transaction-modal.css"
          asp-append-version="true" />
}

<div class="ut-page">

    <!-- PAGE HEADER -->
    <div class="ut-header">
        <div class="ut-title-area">
            <div class="ut-page-icon">
                <i class="bi bi-wallet2"></i>
            </div>

            <div>
                <h1>Utang Records</h1>
                <p>Manage customer credit and outstanding balances.</p>
            </div>
        </div>

        <button type="button"
                class="btn ut-primary-btn"
                data-bs-toggle="modal"
                data-bs-target="#newSaleModal">
            <i class="bi bi-plus-lg"></i>
            Record Utang
        </button>
    </div>

    <!-- ALERTS -->
    @if (!string.IsNullOrWhiteSpace(successMsg))
    {
        <div class="alert fade show ut-alert is-success" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@successMsg</span>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMsg))
    {
        <div class="alert fade show ut-alert is-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@errorMsg</span>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="ut-kpi is-primary" style="--i:0">
                <div class="ut-kpi-icon">
                    <i class="bi bi-wallet2"></i>
                </div>

                <div class="ut-kpi-body">
                    <span>Total Utang</span>
                    <h3>₱@totalUtang.ToString("N2")</h3>
                    <small>@totalRecords credit record(s)</small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="ut-kpi is-success" style="--i:1">
                <div class="ut-kpi-icon">
                    <i class="bi bi-check-circle"></i>
                </div>

                <div class="ut-kpi-body">
                    <span>Total Paid</span>
                    <h3>₱@totalPaid.ToString("N2")</h3>
                    <small>Payments received</small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="ut-kpi is-gold" style="--i:2">
                <div class="ut-kpi-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div class="ut-kpi-body">
                    <span>Remaining Balance</span>
                    <h3>₱@totalBalance.ToString("N2")</h3>
                    <small>Amount still to collect</small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="ut-kpi is-danger" style="--i:3">
                <div class="ut-kpi-icon">
                    <i class="bi bi-exclamation-circle"></i>
                </div>

                <div class="ut-kpi-body">
                    <span>Overdue</span>
                    <h3>₱@overdueBalance.ToString("N2")</h3>
                    <small>@overdueRecords overdue record(s)</small>
                </div>
            </div>
        </div>

    </div>

    <!-- UTANG TABLE CARD -->
    <div class="ut-card">

        <div class="ut-card-header">

            <div class="ut-section-title">
                <div class="ut-section-icon">
                    <i class="bi bi-people"></i>
                </div>

                <div>
                    <h5>Customer Utang</h5>
                    <p>Customers with credit records and outstanding balances.</p>
                </div>
            </div>

            <div class="ut-tools">

                <span class="ut-count" id="utangShown">
                    Showing @totalRecords of @totalRecords
                </span>

                <div class="ut-search">
                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="utangSearch"
                           placeholder="Search customer..."
                           aria-label="Search utang records"
                           autocomplete="off" />
                </div>

            </div>
        </div>

        <!-- STATUS FILTERS -->
        <div class="ut-filters"
             id="utangFilters"
             role="group"
             aria-label="Filter by status">

            <button type="button"
                    class="ut-chip active"
                    data-filter="all"
                    aria-pressed="true">
                All <span>@totalRecords</span>
            </button>

            <button type="button"
                    class="ut-chip"
                    data-filter="unpaid"
                    aria-pressed="false">
                Unpaid <span>@unpaidRecords</span>
            </button>

            <button type="button"
                    class="ut-chip"
                    data-filter="partial"
                    aria-pressed="false">
                Partial <span>@partialRecords</span>
            </button>

            <button type="button"
                    class="ut-chip"
                    data-filter="paid"
                    aria-pressed="false">
                Paid <span>@paidRecords</span>
            </button>

            <button type="button"
                    class="ut-chip is-overdue"
                    data-filter="overdue"
                    aria-pressed="false">
                <i class="bi bi-exclamation-circle-fill"></i>
                Overdue <span>@overdueRecords</span>
            </button>

        </div>

        <!-- TABLE -->
        <div class="table-responsive">

            <table class="table ut-table" id="utangTable">

                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Due Date</th>
                        <th>Total Utang</th>
                        <th>Paid</th>
                        <th>Balance</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>

                <tbody id="utangTableBody">

                    @if (records.Any())
                    {
                        foreach (var utang in records)
                        {
                            bool overdue = IsOverdue(utang);
                            string statusKey = StatusKey(utang);

                            string statusText =
                                string.IsNullOrWhiteSpace(utang.Status)
                                    ? "Unpaid"
                                    : utang.Status;

                            string customerName =
                                utang.Customer?.CustomerName ?? "Unknown Customer";

                            string initial = customerName.Length > 0
                                ? customerName.Substring(0, 1).ToUpperInvariant()
                                : "?";

                            string dateText = utang.Sale != null
                                ? utang.Sale.SaleDate.ToString("MMM dd, yyyy")
                                : utang.DateCreated.ToString("MMM dd, yyyy");

                            string timeText = utang.Sale != null
                                ? utang.Sale.SaleDate.ToString("hh:mm tt")
                                : utang.DateCreated.ToString("hh:mm tt");

                            string dueText = utang.DueDate.HasValue
                                ? utang.DueDate.Value.ToString("MMM dd, yyyy")
                                : "";

                            bool dueToday =
                                utang.DueDate.HasValue &&
                                utang.DueDate.Value.Date == DateTime.Today &&
                                utang.Balance > 0;

                            int paidPct = utang.Amount > 0
                                ? (int)Math.Round(
                                    Math.Min(
                                        100m,
                                        utang.AmountPaid / utang.Amount * 100m))
                                : 0;

                            bool canDelete =
                                string.Equals(
                                    utang.Status,
                                    "Paid",
                                    StringComparison.OrdinalIgnoreCase)
                                && utang.Balance <= 0;

                            string searchKey =
                                (customerName + " " +
                                 statusText + " " +
                                 (overdue ? "overdue" : "") + " " +
                                 dateText + " " +
                                 dueText + " #" +
                                 utang.UtangId).ToLowerInvariant();

                            <tr data-status="@statusKey"
                                data-overdue="@(overdue ? "true" : "false")"
                                data-search="@searchKey">

                                <!-- CUSTOMER -->
                                <td>
                                    <div class="ut-customer">
                                        <div class="ut-avatar">@initial</div>
                                        <strong class="ut-customer-name">
                                            @customerName
                                        </strong>
                                    </div>
                                </td>

                                <!-- DATE -->
                                <td>
                                    <div class="ut-date">
                                        <strong>@dateText</strong>
                                        <small>@timeText</small>
                                    </div>
                                </td>

                                <!-- DUE DATE -->
                                <td>
                                    @if (utang.DueDate.HasValue)
                                    {
                                        <div class="ut-date">
                                            <strong>@dueText</strong>

                                            @if (overdue)
                                            {
                                                <small class="ut-flag is-overdue">
                                                    Overdue
                                                </small>
                                            }
                                            else if (dueToday)
                                            {
                                                <small class="ut-flag is-today">
                                                    Due today
                                                </small>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="ut-none">No due date</span>
                                    }
                                </td>

                                <!-- TOTAL -->
                                <td>
                                    <span class="ut-amount">
                                        ₱@utang.Amount.ToString("N2")
                                    </span>
                                </td>

                                <!-- PAID -->
                                <td>
                                    <span class="ut-paid">
                                        ₱@utang.AmountPaid.ToString("N2")
                                    </span>

                                    <div class="ut-progress"
                                         title="@paidPct% paid">
                                        <span style="width:@(paidPct)%"></span>
                                    </div>
                                </td>

                                <!-- BALANCE -->
                                <td>
                                    <span class="ut-balance @(utang.Balance <= 0 ? "is-settled" : "")">
                                        ₱@utang.Balance.ToString("N2")
                                    </span>
                                </td>

                                <!-- STATUS -->
                                <td>
                                    <div class="ut-status-wrap">

                                        @if (overdue)
                                        {
                                            <span class="ut-status overdue">
                                                <i class="bi bi-exclamation-circle-fill"></i>
                                                Overdue
                                            </span>

                                            <small class="ut-status-sub">
                                                @statusText
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="ut-status @statusKey">
                                                <span class="ut-dot"></span>
                                                @statusText
                                            </span>
                                        }

                                    </div>
                                </td>

                                <!-- ACTION -->
                                <td>
                                    <div class="ut-actions">

                                        <button type="button"
                                                class="btn ut-btn ut-btn-view"
                                                data-bs-toggle="modal"
                                                data-bs-target="#utangDetailsModal-@utang.UtangId">
                                            <i class="bi bi-eye"></i>
                                            <span>View</span>
                                        </button>

                                     
@if (User.IsInRole("Admin") && canDelete)
{
    <button type="button"
            class="btn ut-btn ut-btn-delete"
            title="Delete paid record"
            aria-label="Delete paid utang of @customerName"
            data-bs-toggle="modal"
            data-bs-target="#deleteUtangModal"
            data-id="@utang.UtangId"
            data-name="@customerName"
            data-amount="₱@utang.Amount.ToString("N2")">
        <i class="bi bi-trash"></i>
    </button>
}


                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="utangEmptyRow">
                            <td colspan="8">

                                <div class="ut-empty">
                                    <div class="ut-empty-icon">
                                        <i class="bi bi-wallet2"></i>
                                    </div>

                                    <h5>No Utang Records</h5>
                                    <p>There are currently no customer credit records.</p>

                                    <button type="button"
                                            class="btn ut-primary-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#newSaleModal">
                                        <i class="bi bi-plus-lg"></i>
                                        Record Utang
                                    </button>
                                </div>

                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>

        <!-- NO SEARCH RESULTS -->
        <div class="ut-empty" id="utangNoResults" hidden>

            <div class="ut-empty-icon">
                <i class="bi bi-search"></i>
            </div>

            <h5>No matching records</h5>
            <p>Try a different search or filter.</p>

            <button type="button"
                    class="ut-btn ut-btn-ghost"
                    id="utangClear">
                <i class="bi bi-x-circle"></i>
                Clear filters
            </button>

        </div>

    </div>
</div>

<!-- DELETE PAID UTANG MODAL -->
@if (User.IsInRole("Admin"))
{
<div class="modal fade ut-modal"
     id="deleteUtangModal"
     tabindex="-1"
     aria-labelledby="deleteUtangLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-sm">

        <div class="modal-content">

            <form asp-controller="Utang"
                  asp-action="Delete"
                  method="post">

                <input type="hidden" name="id" id="deleteUtangId" />

                <div class="modal-body ut-modal-body">

                    <div class="ut-modal-icon">
                        <i class="bi bi-trash"></i>
                    </div>

                    <h5 id="deleteUtangLabel">Delete paid record?</h5>

                    <p>
                        <strong id="deleteUtangName"></strong>
                        <span id="deleteUtangAmount"></span> utang
                    </p>

                    <small>
                        The linked sale and its items may also be removed,
                        depending on your controller implementation.
                        This cannot be undone.
                    </small>

                </div>

                <div class="modal-footer ut-modal-footer">

                    <button type="button"
                            class="ut-btn ut-btn-ghost"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="ut-btn ut-btn-danger-solid">
                        <i class="bi bi-trash"></i>
                        Delete
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>
}
<!-- SHARED TRANSACTION MODAL -->
<partial name="_TransactionModal" />

<!-- UTANG DETAILS MODALS -->
@if (records.Any())
{
    foreach (var utang in records)
    {
        <partial name="UtangDetailsModal" model="utang" />
    }
}

@section Scripts {

    <!-- Utang page filtering and delete confirmation -->
    <script src="~/js/utang.js"
            asp-append-version="true"></script>

    <!-- Shared transaction form and product selection -->
    <script src="~/js/transaction-modal.js"
            asp-append-version="true"></script>
}
