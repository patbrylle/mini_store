@model IEnumerable<mini_store.Models.Utang>

@{
    ViewData["Title"] = "Utang Records";

    var totalUtang = Model.Sum(u => u.Amount);
    var totalPaid = Model.Sum(u => u.AmountPaid);
    var totalBalance = Model.Sum(u => u.Balance);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Utang Records</h1>
        <p class="text-muted mb-0">
            Manage customer credit and outstanding balances.
        </p>
    </div>
</div>

<!-- SUMMARY -->
<div class="row g-4 mb-4">

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Total Utang</p>
                <h3 class="fw-bold">
                    ₱@totalUtang.ToString("N2")
                </h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Total Paid</p>
                <h3 class="fw-bold text-success">
                    ₱@totalPaid.ToString("N2")
                </h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Remaining Balance</p>
                <h3 class="fw-bold text-danger">
                    ₱@totalBalance.ToString("N2")
                </h3>
            </div>
        </div>
    </div>

</div>

<!-- CUSTOMER UTANG -->
<div class="card border-0 shadow-sm">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>
                <h5 class="fw-bold mb-1">
                    Customer Utang
                </h5>

                <p class="text-muted mb-0">
                    Customers with outstanding balances.
                </p>
            </div>

            <input type="text"
                   id="utangSearch"
                   class="form-control"
                   placeholder="Search customer..."
                   style="max-width: 250px;">

        </div>

        <div class="table-responsive">

            <table class="table align-middle" id="utangTable">

                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Total Utang</th>
                        <th>Paid</th>
                        <th>Balance</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var utang in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @(utang.Customer?.CustomerName ?? "Unknown Customer")
                                </strong>
                            </td>

                            <td>
                                ₱@utang.Amount.ToString("N2")
                            </td>

                            <td class="text-success">
                                ₱@utang.AmountPaid.ToString("N2")
                            </td>

                            <td class="fw-bold text-danger">
                                ₱@utang.Balance.ToString("N2")
                            </td>

                            <td>

                                @if (utang.Status == "Paid")
                                {
                                    <span class="badge bg-success">
                                        Paid
                                    </span>
                                }
                                else if (utang.Status == "Partial")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Partial
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Unpaid
                                    </span>
                                }

                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@utang.UtangId"
                                   class="btn btn-sm btn-outline-primary">
                                    View Utang
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

<script>

document.getElementById("utangSearch")
    .addEventListener("keyup", function () {

        const search = this.value.toLowerCase();

        document
            .querySelectorAll("#utangTable tbody tr")
            .forEach(row => {

                row.style.display =
                    row.innerText
                        .toLowerCase()
                        .includes(search)
                        ? ""
                        : "none";

            });

    });

</script>

}