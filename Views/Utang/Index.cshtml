@using mini_store.Models
@model IEnumerable<mini_store.Models.Utang>

@{
    ViewData["Title"] = "Utang Records";

    var records = Model?.ToList() ?? new List<Utang>();

    bool IsOverdue(Utang u) =>
        u.DueDate.HasValue && u.DueDate.Value.Date < DateTime.Today && u.Balance > 0;

    var totalUtang = records.Sum(u => u.Amount);
    var totalPaid = records.Sum(u => u.AmountPaid);
    var totalBalance = records.Sum(u => u.Balance);
    int totalRecords = records.Count;

    int unpaidRecords = records.Count(u => TxStatus.Key(u.Status) == "unpaid");
    int partialRecords = records.Count(u => TxStatus.Key(u.Status) == "partial");
    int paidRecords = records.Count(u => TxStatus.Key(u.Status) == "paid");

    var overdueList = records.Where(IsOverdue).ToList();
    var overdueBalance = overdueList.Sum(u => u.Balance);
}

@section Styles {
    <link rel="stylesheet" href="~/css/utang.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/transactions.css" asp-append-version="true" />
}

<div class="ut-page">

    <div class="ut-header">
        <div class="ut-title-area">
            <div class="ut-page-icon"><i class="bi bi-wallet2"></i></div>
            <div>
                <h1>Credit Records</h1>
                <p>Manage customer credit and outstanding balances.</p>
            </div>
        </div>

        <button type="button" class="btn ut-primary-btn" data-bs-toggle="modal" data-bs-target="#newSaleModal">
            <i class="bi bi-plus-lg"></i> Record Credit Sale
        </button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="ut-kpi is-primary" style="--i:0">
                <div class="ut-kpi-icon"><i class="bi bi-wallet2"></i></div>
                <div class="ut-kpi-body"><span>Total Credit</span><h3>₱@totalUtang.ToString("N2")</h3><small>@totalRecords credit record(s)</small></div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="ut-kpi is-success" style="--i:1">
                <div class="ut-kpi-icon"><i class="bi bi-check-circle"></i></div>
                <div class="ut-kpi-body"><span>Total Paid</span><h3>₱@totalPaid.ToString("N2")</h3><small>Payments received</small></div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="ut-kpi is-gold" style="--i:2">
                <div class="ut-kpi-icon"><i class="bi bi-hourglass-split"></i></div>
                <div class="ut-kpi-body"><span>Remaining Balance</span><h3>₱@totalBalance.ToString("N2")</h3><small>Amount still to collect</small></div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="ut-kpi is-danger" style="--i:3">
                <div class="ut-kpi-icon"><i class="bi bi-exclamation-circle"></i></div>
                <div class="ut-kpi-body"><span>Overdue</span><h3>₱@overdueBalance.ToString("N2")</h3><small>@overdueList.Count overdue record(s)</small></div>
            </div>
        </div>
    </div>

    <div class="ut-card">

        <div class="ut-card-header">
            <div class="ut-section-title">
                <div class="ut-section-icon"><i class="bi bi-people"></i></div>
                <div>
                    <h5>Customer Credit</h5>
                    <p>Open a record to view items, payments and receive payment.</p>
                </div>
            </div>

            <div class="ut-tools">
                <span class="ut-count" id="utangShown">Showing @totalRecords of @totalRecords</span>
                <div class="ut-search">
                    <i class="bi bi-search"></i>
                    <input type="text" id="utangSearch" placeholder="Search customer..." aria-label="Search utang records" autocomplete="off" />
                </div>
            </div>
        </div>

        <div class="ut-filters" id="utangFilters" role="group" aria-label="Filter by status">
            <button type="button" class="ut-chip active" data-filter="all" aria-pressed="true">All <span>@totalRecords</span></button>
            <button type="button" class="ut-chip" data-filter="unpaid" aria-pressed="false">Unpaid <span>@unpaidRecords</span></button>
            <button type="button" class="ut-chip" data-filter="partial" aria-pressed="false">Partial <span>@partialRecords</span></button>
            <button type="button" class="ut-chip" data-filter="paid" aria-pressed="false">Paid <span>@paidRecords</span></button>
            <button type="button" class="ut-chip is-overdue" data-filter="overdue" aria-pressed="false">
                <i class="bi bi-exclamation-circle-fill"></i> Overdue <span>@overdueList.Count</span>
            </button>
        </div>

        <div class="table-responsive">
            <table class="table ut-table" id="utangTable">
                <thead>
                    <tr>
                        <th>Customer</th><th>Date</th><th>Due Date</th><th>Total Utang</th>
                        <th>Paid</th><th>Balance</th><th>Status</th><th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody id="utangTableBody">
                @if (records.Any())
                {
                    foreach (var utang in records)
                    {
                        var overdue = IsOverdue(utang);
                        var statusKey = TxStatus.Key(utang.Status);
                        var statusText = string.IsNullOrWhiteSpace(utang.Status) ? "Unpaid" : utang.Status;
                        var customerName = utang.Customer?.CustomerName ?? "Unknown Customer";
                        var initial = customerName.Substring(0, 1).ToUpperInvariant();
                        var when = utang.Sale?.SaleDate ?? utang.DateCreated;
                        var dueText = utang.DueDate?.ToString("MMM dd, yyyy") ?? "";
                        var dueToday = utang.DueDate.HasValue && utang.DueDate.Value.Date == DateTime.Today && utang.Balance > 0;
                        var paidPct = utang.Amount > 0 ? (int)Math.Round(Math.Min(100m, utang.AmountPaid / utang.Amount * 100m)) : 0;
                        var searchKey = $"{customerName} {statusText} {(overdue ? "overdue" : "")} {when:MMM dd, yyyy} {dueText} #{utang.UtangId}".ToLowerInvariant();

                        <tr data-status="@statusKey" data-overdue="@(overdue ? "true" : "false")" data-search="@searchKey" data-utang-id="@utang.UtangId">
                            <td>
                                <div class="ut-customer">
                                    <div class="ut-avatar">@initial</div>
                                    <strong class="ut-customer-name">@customerName</strong>
                                </div>
                            </td>
                            <td>
                                <div class="ut-date"><strong>@when.ToString("MMM dd, yyyy")</strong><small>@when.ToString("hh:mm tt")</small></div>
                            </td>
                            <td>
                                @if (utang.DueDate.HasValue)
                                {
                                    <div class="ut-date">
                                        <strong>@dueText</strong>
                                        @if (overdue) { <small class="ut-flag is-overdue">Overdue</small> }
                                        else if (dueToday) { <small class="ut-flag is-today">Due today</small> }
                                    </div>
                                }
                                else { <span class="ut-none">No due date</span> }
                            </td>
                            <td><span class="ut-amount">₱@utang.Amount.ToString("N2")</span></td>
                            <td>
                                <span class="ut-paid">₱@utang.AmountPaid.ToString("N2")</span>
                                <div class="ut-progress" title="@paidPct% paid"><span style="width:@(paidPct)%"></span></div>
                            </td>
                            <td><span class="ut-balance @(utang.Balance <= 0 ? "is-settled" : "")">₱@utang.Balance.ToString("N2")</span></td>
                            <td>
                                <div class="ut-status-wrap">
                                    @if (overdue)
                                    {
                                        <span class="ut-status overdue"><i class="bi bi-exclamation-circle-fill"></i> Overdue</span>
                                        <small class="ut-status-sub">@statusText</small>
                                    }
                                    else
                                    {
                                        <span class="ut-status @statusKey"><span class="ut-dot"></span>@statusText</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="ut-actions">
                                    <button type="button" class="btn ut-btn ut-btn-view" data-tx-view="@utang.SaleId">
                                        <i class="bi @(utang.Balance > 0 ? "bi-cash-coin" : "bi-eye")"></i>
                                        <span>@(utang.Balance > 0 ? "View / Pay" : "View")</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="utangEmptyRow">
                        <td colspan="8">
                            <div class="ut-empty">
                                <div class="ut-empty-icon"><i class="bi bi-wallet2"></i></div>
                                <h5>No Credit Records</h5>
                                <p>There are currently no customer credit records.</p>
                                <button type="button" class="btn ut-primary-btn" data-bs-toggle="modal" data-bs-target="#newSaleModal">
                                    <i class="bi bi-plus-lg"></i> Record Credit Sale
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="ut-empty" id="utangNoResults" hidden>
            <div class="ut-empty-icon"><i class="bi bi-search"></i></div>
            <h5>No matching records</h5>
            <p>Try a different search or filter.</p>
            <button type="button" class="ut-btn ut-btn-ghost" id="utangClear"><i class="bi bi-x-circle"></i> Clear filters</button>
        </div>
    </div>
</div>

@{
    ViewData["ReturnTo"] = "Utang";
    ViewData["DefaultTransactionType"] = "Utang";
}
<partial name="_TransactionModal" model="(mini_store.Models.TransactionFormData)ViewBag.Form" />

@section Scripts {
    <script src="~/js/utang.js" asp-append-version="true"></script>
    <script src="~/js/transactions.js" asp-append-version="true"></script>
}