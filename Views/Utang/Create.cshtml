@model mini_store.Models.CreateUtang

@{
    ViewData["Title"] = "Record Utang";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Record Utang</h1>
        <p class="text-muted mb-0">
            Record products that a customer will pay later.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <!-- CUSTOMER -->

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <h5 class="fw-bold mb-3">
                Customer
            </h5>

            <select asp-for="CustomerId"
                    class="form-select"
                    required>

                <option value="">
                    Select Customer
                </option>

                @foreach (var customer in ViewBag.Customers)
                {
                    <option value="@customer.CustomerId">
                        @customer.CustomerName
                    </option>
                }

            </select>

        </div>
    </div>


    <!-- PRODUCTS -->

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <h5 class="fw-bold mb-1">
                Products
            </h5>

            <p class="text-muted">
                Select multiple products.
            </p>

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Select</th>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Available</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int index = 0;
                        }

                        @foreach (var product in ViewBag.Products)
                        {
                            <tr>

                                <td>
                                    <input type="checkbox"
                                           class="form-check-input product-check"
                                           data-index="@index">
                                </td>

                                <td>
                                    <strong>
                                        @product.ProductName
                                    </strong>
                                </td>

                                <td>
                                    ₱@product.Price.ToString("N2")
                                </td>

                                <td>
                                    @product.Quantity
                                </td>

                                <td>

                                    <input type="hidden"
                                           name="Products[@index].ProductId"
                                           value="@product.ProductId" />

                                    <input type="hidden"
                                           name="Products[@index].ProductName"
                                           value="@product.ProductName" />

                                    <input type="hidden"
                                           name="Products[@index].Price"
                                           value="@product.Price" />

                                    <input type="number"
                                           name="Products[@index].Quantity"
                                           value="0"
                                           min="0"
                                           max="@product.Quantity"
                                           class="form-control quantity-input"
                                           data-index="@index"
                                           disabled
                                           style="width: 100px;" />

                                </td>

                            </tr>

                            index++;
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>


    <!-- PAYMENT -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <h5 class="fw-bold mb-3">
                Payment
            </h5>

            <div class="row">

                <div class="col-md-4">

                    <label class="form-label">
                        Amount Paid
                    </label>

                    <input asp-for="AmountPaid"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           id="amountPaid"
                           value="0" />

                </div>

                <div class="col-md-4">

                    <label class="form-label">
                        Total
                    </label>

                    <input type="text"
                           id="totalDisplay"
                           class="form-control"
                           value="₱0.00"
                           readonly />

                </div>

                <div class="col-md-4">

                    <label class="form-label">
                        Balance
                    </label>

                    <input type="text"
                           id="balanceDisplay"
                           class="form-control text-danger fw-bold"
                           value="₱0.00"
                           readonly />

                </div>

            </div>

        </div>

    </div>


    <!-- BUTTON -->

    <div class="d-flex justify-content-end gap-2">

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Cancel
        </a>

        <button type="submit"
                class="btn btn-primary">
            <i class="bi bi-wallet2"></i>
            Record Utang
        </button>

    </div>

</form>


@section Scripts {

    <script>

        const checks =
            document.querySelectorAll(".product-check");

        const amountPaid =
            document.getElementById("amountPaid");

        const totalDisplay =
            document.getElementById("totalDisplay");

        const balanceDisplay =
            document.getElementById("balanceDisplay");


        function calculateTotal() {

            let total = 0;

            document
                .querySelectorAll(".quantity-input")
                .forEach(input => {

                    if (!input.disabled) {

                        const quantity =
                            parseInt(input.value) || 0;

                        const row =
                            input.closest("tr");

                        const priceText =
                            row.children[2]
                               .innerText
                               .replace("₱", "")
                               .replace(",", "");

                        const price =
                            parseFloat(priceText) || 0;

                        total += quantity * price;
                    }

                });


            const paid =
                parseFloat(amountPaid.value) || 0;

            const balance =
                Math.max(total - paid, 0);


            totalDisplay.value =
                "₱" + total.toFixed(2);

            balanceDisplay.value =
                "₱" + balance.toFixed(2);
        }


        checks.forEach(check => {

            check.addEventListener("change", function () {

                const index =
                    this.dataset.index;

                const quantity =
                    document.querySelector(
                        `.quantity-input[data-index="${index}"]`
                    );

                quantity.disabled =
                    !this.checked;

                if (this.checked) {
                    quantity.value = 1;
                }
                else {
                    quantity.value = 0;
                }

                calculateTotal();
            });

        });


        document
            .querySelectorAll(".quantity-input")
            .forEach(input => {

                input.addEventListener(
                    "input",
                    calculateTotal
                );

            });


        amountPaid.addEventListener(
            "input",
            calculateTotal
        );

    </script>
}