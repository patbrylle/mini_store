@using System.Globalization
@using System.Linq
@{
    ViewData["Title"] = "Reports";

    // ---- Chart data, built from the ViewBag values already used on this page ----

    var totalPaidVal    = Convert.ToDecimal(ViewBag.TotalPaid ?? 0).ToString("F2", CultureInfo.InvariantCulture);
    var outstandingVal  = Convert.ToDecimal(ViewBag.OutstandingSales ?? 0).ToString("F2", CultureInfo.InvariantCulture);

    int totalProducts = Convert.ToInt32(ViewBag.TotalProducts ?? 0);
    int lowStockCount = Convert.ToInt32(ViewBag.LowStock ?? 0);
    int outOfStockCount = Convert.ToInt32(ViewBag.OutOfStock ?? 0);
    int healthyStockCount = Math.Max(totalProducts - lowStockCount - outOfStockCount, 0);

    // ---- Collection rate (paid / total sales) ----
    decimal totalSalesDec = Convert.ToDecimal(ViewBag.TotalSales ?? 0);
    decimal totalPaidDec  = Convert.ToDecimal(ViewBag.TotalPaid ?? 0);
    int collectionRate = totalSalesDec > 0
        ? (int)Math.Round(totalPaidDec / totalSalesDec * 100)
        : 0;

    var topProducts = new List<dynamic>();
    int maxQty = 1;

    if (ViewBag.BestSellingProducts != null)
    {
        int c = 0;
        foreach (var p in ViewBag.BestSellingProducts)
        {
            maxQty = Math.Max(maxQty, Convert.ToInt32(p.QuantitySold));

            if (c < 6)
            {
                topProducts.Add(p);
                c++;
            }
        }
    }

    var bestLabelsJs = string.Join(",", topProducts.Select(p =>
        "\"" + ((string)p.ProductName.ToString()).Replace("\"", "\\\"") + "\""));

    var bestDataJs = string.Join(",", topProducts.Select(p =>
        Convert.ToInt32(p.QuantitySold).ToString(CultureInfo.InvariantCulture)));
}

@section Styles {
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}

<div class="reports-page">

    <!-- PAGE HEADER -->
    <div class="reports-header">
        <div class="reports-title-area">
            <div class="reports-page-icon">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
            <div>
                <h1 class="reports-title">Reports</h1>
                <p class="reports-subtitle">Track sales, inventory health, and utang at a glance.</p>
            </div>
        </div>

        <div class="reports-pill">
            <i class="bi bi-piggy-bank"></i>
            @collectionRate% <span>collected</span>
        </div>
    </div>


    <!-- SALES SUMMARY -->
    <div class="kpi-row">

        <h5 class="report-section-title">
            <i class="bi bi-cart-check"></i>
            Sales Summary
        </h5>

        <div class="row g-3">

            <div class="col-md-6 col-xl-3">
                <div class="kpi-card is-primary">
                    <div class="kpi-icon"><i class="bi bi-cash-stack"></i></div>
                    <div class="kpi-body">
                        <h6 class="kpi-label">Total Sales</h6>
                        <h4 class="kpi-value">₱@Convert.ToDecimal(ViewBag.TotalSales).ToString("N2")</h4>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="kpi-card is-gold">
                    <div class="kpi-icon"><i class="bi bi-receipt"></i></div>
                    <div class="kpi-body">
                        <h6 class="kpi-label">Transactions</h6>
                        <h4 class="kpi-value">@ViewBag.TotalTransactions</h4>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="kpi-card is-success">
                    <div class="kpi-icon"><i class="bi bi-check-circle"></i></div>
                    <div class="kpi-body">
                        <h6 class="kpi-label">Total Paid</h6>
                        <h4 class="kpi-value">₱@Convert.ToDecimal(ViewBag.TotalPaid).ToString("N2")</h4>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="kpi-card is-danger">
                    <div class="kpi-icon"><i class="bi bi-exclamation-circle"></i></div>
                    <div class="kpi-body">
                        <h6 class="kpi-label">Outstanding</h6>
                        <h4 class="kpi-value">₱@Convert.ToDecimal(ViewBag.OutstandingSales).ToString("N2")</h4>
                    </div>
                </div>
            </div>

        </div>
    </div>


    <!-- INVENTORY SUMMARY -->
    <div class="kpi-row">

        <h5 class="report-section-title">
            <i class="bi bi-box-seam"></i>
            Inventory Summary
        </h5>

        <div class="row g-3">

            <div class="col-md-6 col-xl-3">
                <div class="kpi-card is-primary">
                    <div class="kpi-icon"><i class="bi bi-boxes"></i></div>
                    <div class="kpi-body">
                        <h6 class="kpi-label">Total Products</h6>
                        <h4 class="kpi-value">@ViewBag.TotalProducts</h4>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="kpi-card is-gold">
                    <div class="kpi-icon"><i class="bi bi-box-seam-fill"></i></div>
                    <div class="kpi-body">
                        <h6 class="kpi-label">Total Stock</h6>
                        <h4 class="kpi-value">@ViewBag.TotalStock</h4>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="kpi-card is-gold">
                    <div class="kpi-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                    <div class="kpi-body">
                        <h6 class="kpi-label">Low Stock</h6>
                        <h4 class="kpi-value">@ViewBag.LowStock</h4>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="kpi-card is-danger">
                    <div class="kpi-icon"><i class="bi bi-x-circle-fill"></i></div>
                    <div class="kpi-body">
                        <h6 class="kpi-label">Out of Stock</h6>
                        <h4 class="kpi-value">@ViewBag.OutOfStock</h4>
                    </div>
                </div>
            </div>

        </div>
    </div>


    <!-- UTANG SUMMARY -->
    <div class="kpi-row">

        <h5 class="report-section-title">
            <i class="bi bi-wallet2"></i>
            Utang Summary
        </h5>

        <div class="row g-3">

            <div class="col-md-4">
                <div class="kpi-card is-primary">
                    <div class="kpi-icon"><i class="bi bi-wallet2"></i></div>
                    <div class="kpi-body">
                        <h6 class="kpi-label">Total Utang</h6>
                        <h4 class="kpi-value">₱@Convert.ToDecimal(ViewBag.TotalUtang).ToString("N2")</h4>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="kpi-card is-success">
                    <div class="kpi-icon"><i class="bi bi-check-circle"></i></div>
                    <div class="kpi-body">
                        <h6 class="kpi-label">Total Paid</h6>
                        <h4 class="kpi-value">₱@Convert.ToDecimal(ViewBag.UtangPaid).ToString("N2")</h4>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="kpi-card is-danger">
                    <div class="kpi-icon"><i class="bi bi-exclamation-circle"></i></div>
                    <div class="kpi-body">
                        <h6 class="kpi-label">Remaining Balance</h6>
                        <h4 class="kpi-value">₱@Convert.ToDecimal(ViewBag.UtangBalance).ToString("N2")</h4>
                    </div>
                </div>
            </div>

        </div>
    </div>


    <!-- CHARTS -->
    <div class="row g-4 mb-4">

        <div class="col-lg-6">
            <div class="panel">
                <div class="panel-header">
                    <h5><i class="bi bi-pie-chart-fill"></i> Payment Status</h5>
                </div>
                <div class="donut-chart-container">
                    <canvas id="paymentStatusChart"></canvas>
                </div>
                <div class="donut-legend">
                    <span><i style="background:#3c9461"></i> Paid <b>₱@Convert.ToDecimal(ViewBag.TotalPaid).ToString("N2")</b></span>
                    <span><i style="background:#c0392b"></i> Outstanding <b>₱@Convert.ToDecimal(ViewBag.OutstandingSales).ToString("N2")</b></span>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="panel">
                <div class="panel-header">
                    <h5><i class="bi bi-pie-chart-fill"></i> Inventory Status</h5>
                </div>
                <div class="donut-chart-container">
                    <canvas id="inventoryStatusChart"></canvas>
                </div>
                <div class="donut-legend">
                    <span><i style="background:#3c9461"></i> Healthy <b>@healthyStockCount</b></span>
                    <span><i style="background:#d49a21"></i> Low Stock <b>@lowStockCount</b></span>
                    <span><i style="background:#c0392b"></i> Out of Stock <b>@outOfStockCount</b></span>
                </div>
            </div>
        </div>

    </div>


    <!-- BEST SELLING PRODUCTS -->
    <div class="panel mb-4">

        <div class="panel-header">
            <h5><i class="bi bi-bar-chart-line-fill"></i> Best-Selling Products</h5>
        </div>

        @if (topProducts.Count > 0)
        {
            <div class="bar-chart-container">
                <canvas id="bestSellingChart"></canvas>
            </div>
        }

        <div class="table-responsive">

            <table class="table report-table align-middle mb-0">

                <thead>
                    <tr>
                        <th style="width:70px">Rank</th>
                        <th>Product</th>
                        <th>Quantity Sold</th>
                        <th>Revenue</th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        int rank = 1;
                    }

                    @if (ViewBag.BestSellingProducts != null &&
                         ViewBag.BestSellingProducts.Count > 0)
                    {
                        foreach (var product in ViewBag.BestSellingProducts)
                        {
                            int qty = Convert.ToInt32(product.QuantitySold);
                            int barPct = (int)Math.Round((double)qty / maxQty * 100);

                            <tr>
                                <td>
                                    <span class="rank-badge @(rank <= 3 ? "rank-" + rank : "")">@rank</span>
                                </td>

                                <td>
                                    <span class="report-product">@product.ProductName</span>
                                </td>

                                <td>
                                    <div class="qty-cell">
                                        <strong>@qty</strong>
                                        <div class="qty-bar"><span style="width:@barPct%"></span></div>
                                    </div>
                                </td>

                                <td>
                                    <span class="revenue-value">
                                        ₱@Convert.ToDecimal(product.Revenue).ToString("N2")
                                    </span>
                                </td>
                            </tr>

                            rank++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="empty-state">
                                    <i class="bi bi-bar-chart"></i>
                                    <p>No sales data available yet.</p>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <!-- Chart.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>

    <script>
        window.reportsChartData = {
            payment: {
                paid: @Html.Raw(totalPaidVal),
                outstanding: @Html.Raw(outstandingVal)
            },
            inventory: {
                healthy: @healthyStockCount,
                lowStock: @lowStockCount,
                outOfStock: @outOfStockCount
            },
            bestSelling: {
                labels: [@Html.Raw(bestLabelsJs)],
                data: [@Html.Raw(bestDataJs)]
            }
        };
    </script>

    <script src="~/js/reports.js" asp-append-version="true"></script>
}