@{
    ViewData["Title"] = "Reports";
}

@section Styles {
    <link rel="stylesheet" href="~/css/reports.css" />
}

<div class="reports-page">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Reports</h2>
            <p class="text-muted mb-0">
                View sales, inventory, utang, and product performance.
            </p>
        </div>
    </div>


    <!-- SALES SUMMARY -->
    <div class="card report-card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="fw-bold mb-3">
                <i class="bi bi-cart-check me-2"></i>
                Sales Summary
            </h5>

            <div class="row g-3">

                <div class="col-md-3">
                    <div class="report-stat">
                        <small class="text-muted">Total Sales</small>
                        <h4>₱@Convert.ToDecimal(ViewBag.TotalSales).ToString("N2")</h4>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="report-stat">
                        <small class="text-muted">Transactions</small>
                        <h4>@ViewBag.TotalTransactions</h4>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="report-stat">
                        <small class="text-muted">Total Paid</small>
                        <h4>₱@Convert.ToDecimal(ViewBag.TotalPaid).ToString("N2")</h4>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="report-stat">
                        <small class="text-muted">Outstanding</small>
                        <h4>₱@Convert.ToDecimal(ViewBag.OutstandingSales).ToString("N2")</h4>
                    </div>
                </div>

            </div>

        </div>
    </div>


    <!-- INVENTORY SUMMARY -->
    <div class="card report-card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="fw-bold mb-3">
                <i class="bi bi-box-seam me-2"></i>
                Inventory Summary
            </h5>

            <div class="row g-3">

                <div class="col-md-3">
                    <div class="report-stat">
                        <small class="text-muted">Total Products</small>
                        <h4>@ViewBag.TotalProducts</h4>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="report-stat">
                        <small class="text-muted">Total Stock</small>
                        <h4>@ViewBag.TotalStock</h4>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="report-stat">
                        <small class="text-muted">Low Stock</small>
                        <h4>@ViewBag.LowStock</h4>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="report-stat">
                        <small class="text-muted">Out of Stock</small>
                        <h4>@ViewBag.OutOfStock</h4>
                    </div>
                </div>

            </div>

        </div>
    </div>


    <!-- UTANG SUMMARY -->
    <div class="card report-card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="fw-bold mb-3">
                <i class="bi bi-wallet2 me-2"></i>
                Utang Summary
            </h5>

            <div class="row g-3">

                <div class="col-md-4">
                    <div class="report-stat">
                        <small class="text-muted">Total Utang</small>
                        <h4>₱@Convert.ToDecimal(ViewBag.TotalUtang).ToString("N2")</h4>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="report-stat">
                        <small class="text-muted">Total Paid</small>
                        <h4>₱@Convert.ToDecimal(ViewBag.UtangPaid).ToString("N2")</h4>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="report-stat">
                        <small class="text-muted">Remaining Balance</small>
                        <h4>₱@Convert.ToDecimal(ViewBag.UtangBalance).ToString("N2")</h4>
                    </div>
                </div>

            </div>

        </div>
    </div>


    <!-- BEST SELLING PRODUCTS -->
    <div class="card report-card shadow-sm mb-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-bar-chart-line-fill me-2"></i>
                        Best-Selling Products
                    </h5>

                    <p class="text-muted mb-0">
                        Products with the highest quantity sold.
                    </p>
                </div>
            </div>


            <div class="table-responsive">

                <table class="table report-table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>Quantity Sold</th>
                            <th>Revenue</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int rank = 1;
                        }

                        @if (ViewBag.BestSellingProducts != null &&
                             ViewBag.BestSellingProducts.Count > 0)
                        {
                            foreach (var product in ViewBag.BestSellingProducts)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">
                                            @rank
                                        </span>
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @product.ProductName
                                        </span>
                                    </td>

                                    <td>
                                        @product.QuantitySold
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            ₱@Convert.ToDecimal(product.Revenue).ToString("N2")
                                        </span>
                                    </td>
                                </tr>

                                rank++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="bi bi-bar-chart fs-3 d-block mb-2"></i>
                                    No sales data available yet.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
@section Scripts{
    <script src ="~/js/reports.js"></script>
}