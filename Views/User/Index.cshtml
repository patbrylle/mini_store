@model List<mini_store.ViewModels.Account.UserListViewModel>

@{
    ViewData["Title"] = "User Management";

    var users = Model ?? new();
    int total = users.Count;
    int disabled = users.Count(u => u.Status == "disabled");
    int admins = users.Count(u => u.Role == "Admin");
    int staff = users.Count(u => u.Role == "Staff");
    int customers = users.Count(u => u.Role == "Customer");
}

@section Styles {
    <link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />
}

<div class="um-page">

    <div class="um-header">
        <div class="um-title-area">
            <div class="um-page-icon"><i class="bi bi-people"></i></div>
            <div>
                <h1>User Management</h1>
                <p>Manage staff, administrator and customer login accounts.</p>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="CreateCustomerAccount" class="um-btn um-btn-ghost">
                <i class="bi bi-person-plus"></i> Create Customer Account
            </a>
            <a asp-action="CreateStaff" class="btn um-add-btn">
                <i class="bi bi-person-plus-fill"></i> Add Staff
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="um-kpi is-primary" style="--i:0">
                <div class="um-kpi-icon"><i class="bi bi-people"></i></div>
                <div><span>Total Accounts</span><h3>@total</h3></div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="um-kpi is-success" style="--i:1">
                <div class="um-kpi-icon"><i class="bi bi-person-check"></i></div>
                <div><span>Active</span><h3>@(total - disabled)</h3></div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="um-kpi is-gold" style="--i:2">
                <div class="um-kpi-icon"><i class="bi bi-person-x"></i></div>
                <div><span>Disabled</span><h3>@disabled</h3></div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="um-kpi is-danger" style="--i:3">
                <div class="um-kpi-icon"><i class="bi bi-person-badge"></i></div>
                <div><span>Customer Logins</span><h3>@customers</h3></div>
            </div>
        </div>
    </div>

    <div class="um-card">
        <div class="um-card-header">
            <div>
                <h5>Accounts</h5>
                <p>Disable, enable or delete staff and customer logins.</p>
            </div>
            <div class="um-search">
                <i class="bi bi-search"></i>
                <input type="text" id="userSearch" placeholder="Search by name or email..."
                       aria-label="Search accounts" autocomplete="off" />
            </div>
        </div>

        <div class="um-filters" id="userFilters" role="group" aria-label="Filter accounts">
            <button type="button" class="um-chip active" data-filter="all" aria-pressed="true">All <span>@total</span></button>
            <button type="button" class="um-chip" data-filter="admin" aria-pressed="false">Admins <span>@admins</span></button>
            <button type="button" class="um-chip" data-filter="staff" aria-pressed="false">Staff <span>@staff</span></button>
            <button type="button" class="um-chip" data-filter="customer" aria-pressed="false">Customers <span>@customers</span></button>
            <button type="button" class="um-chip" data-filter="disabled" aria-pressed="false">Disabled <span>@disabled</span></button>
        </div>

        <div class="table-responsive">
            <table class="table um-table" id="userTable">
                <thead>
                    <tr>
                        <th>Account</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (users.Any())
                {
                    foreach (var u in users)
                    {
                        var roleKey = u.Role.ToLowerInvariant();
                        var isAdmin = roleKey == "admin";
                        var isCustomer = roleKey == "customer";
                        var initial = u.DisplayName.Length > 0 ? u.DisplayName[..1].ToUpperInvariant() : "?";
                        var statusText = u.Status switch { "disabled" => "Disabled", "locked" => "Locked", _ => "Active" };
                        var search = $"{u.DisplayName} {u.Email} {u.Role} {statusText}".ToLowerInvariant();

                        <tr class="@(u.Status == "disabled" ? "is-disabled" : "")"
                            data-role="@roleKey" data-status="@u.Status" data-search="@search">
                            <td>
                                <div class="um-user">
                                    <div class="um-avatar @(isAdmin ? "is-admin" : "")">@initial</div>
                                    <div class="um-user-text">
                                        <strong>@u.DisplayName</strong>
                                        <small>@(u.DisplayName == u.Email ? u.Role + " account" : u.Email)</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="um-role @roleKey">
                                    <i class="bi @(isAdmin ? "bi-shield-fill" : isCustomer ? "bi-bag-fill" : "bi-person-fill")"></i>
                                    @u.Role
                                </span>
                            </td>
                            <td>
                                <span class="um-status @u.Status"><span></span>@statusText</span>
                            </td>
                            <td class="text-end">
                                @if (isAdmin)
                                {
                                    <span class="um-protected"><i class="bi bi-shield-lock"></i> Protected</span>
                                }
                                else
                                {
                                    <div class="um-actions">
                                        <form asp-action="SetStatus" method="post">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <input type="hidden" name="enable" value="@(u.Status == "active" ? "false" : "true")" />
                                            @if (u.Status == "active")
                                            {
                                                <button type="submit" class="um-btn um-btn-disable">
                                                    <i class="bi bi-person-x"></i><span>Disable</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="um-btn um-btn-enable">
                                                    <i class="bi bi-person-check"></i><span>@(u.Status == "locked" ? "Unlock" : "Enable")</span>
                                                </button>
                                            }
                                        </form>

                                        <button type="button" class="um-btn um-btn-delete"
                                                title="Delete login" aria-label="Delete @u.DisplayName"
                                                data-bs-toggle="modal" data-bs-target="#deleteUserModal"
                                                data-id="@u.Id" data-name="@u.DisplayName"
                                                data-kind="@(isCustomer ? "customer" : "staff")">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4">
                            <div class="um-empty">
                                <i class="bi bi-people"></i>
                                <strong>No accounts yet.</strong>
                                <span>Add a staff account to get started.</span>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="um-empty" id="userNoResults" hidden>
            <i class="bi bi-search"></i>
            <strong>No matching accounts.</strong>
            <span>Try a different search or filter.</span>
        </div>
    </div>
</div>

<!-- ONE delete modal, filled by users.js -->
<div class="modal fade um-modal" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" id="deleteUserId" />

                <div class="modal-body um-modal-body">
                    <div class="um-modal-icon"><i class="bi bi-trash"></i></div>
                    <h5 id="deleteUserLabel">Delete account?</h5>
                    <p><strong id="deleteUserName"></strong> will lose access. This cannot be undone.</p>
                    <small id="deleteUserNote"></small>
                </div>

                <div class="modal-footer um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="um-btn um-btn-danger-solid"><i class="bi bi-trash"></i> Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/users.js" asp-append-version="true"></script>
}