@model List<mini_store.ViewModels.Account.UserListViewModel>

@{
    ViewData["Title"] = "User Management";

    var users = Model ?? new List<mini_store.ViewModels.Account.UserListViewModel>();

    int totalUsers = users.Count;
    int activeUsers = users.Count(u => u.IsActive);
    int disabledUsers = totalUsers - activeUsers;
    int adminCount = users.Count(u => string.Equals(u.Role, "Admin", StringComparison.OrdinalIgnoreCase));
    int staffCount = users.Count(u => string.Equals(u.Role, "Staff", StringComparison.OrdinalIgnoreCase));
}

@section Styles {
    <link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />
}

<div class="um-page">

    <!-- HEADER -->
    <div class="um-header">

        <div class="um-title-area">
            <div class="um-page-icon">
                <i class="bi bi-people"></i>
            </div>

            <div>
                <h1>User Management</h1>
                <p>Manage store staff and administrator accounts.</p>
            </div>
        </div>

        <a asp-action="CreateStaff" class="btn um-add-btn">
            <i class="bi bi-person-plus-fill"></i>
            Add Staff
        </a>

    </div>


    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="um-kpi is-primary" style="--i:0">
                <div class="um-kpi-icon"><i class="bi bi-people"></i></div>
                <div>
                    <span>Total Users</span>
                    <h3>@totalUsers</h3>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="um-kpi is-success" style="--i:1">
                <div class="um-kpi-icon"><i class="bi bi-person-check"></i></div>
                <div>
                    <span>Active</span>
                    <h3>@activeUsers</h3>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="um-kpi is-gold" style="--i:2">
                <div class="um-kpi-icon"><i class="bi bi-person-x"></i></div>
                <div>
                    <span>Disabled</span>
                    <h3>@disabledUsers</h3>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="um-kpi is-danger" style="--i:3">
                <div class="um-kpi-icon"><i class="bi bi-shield-check"></i></div>
                <div>
                    <span>Administrators</span>
                    <h3>@adminCount</h3>
                </div>
            </div>
        </div>

    </div>


    <!-- USERS TABLE -->
    <div class="um-card">

        <div class="um-card-header">

            <div>
                <h5>Accounts</h5>
                <p>Edit, enable, disable or remove staff accounts.</p>
            </div>

            <div class="um-search">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="userSearch"
                       placeholder="Search by email..."
                       aria-label="Search users"
                       autocomplete="off" />
            </div>

        </div>

        <div class="um-filters" id="userFilters" role="group" aria-label="Filter users">
            <button type="button" class="um-chip active" data-filter="all" aria-pressed="true">
                All <span>@totalUsers</span>
            </button>
            <button type="button" class="um-chip" data-filter="admin" aria-pressed="false">
                Admins <span>@adminCount</span>
            </button>
            <button type="button" class="um-chip" data-filter="staff" aria-pressed="false">
                Staff <span>@staffCount</span>
            </button>
            <button type="button" class="um-chip" data-filter="disabled" aria-pressed="false">
                Disabled <span>@disabledUsers</span>
            </button>
        </div>

        <div class="table-responsive">

            <table class="table um-table" id="userTable">

                <thead>
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (users.Any())
                    {
                        foreach (var user in users)
                        {
                            string email = user.Email ?? "";
                            string role = user.Role ?? "";
                            string roleKey = role.ToLower();
                            string searchKey = (email + " " + role).ToLower();
                            string initial = email.Length > 0 ? email.Substring(0, 1).ToUpper() : "?";

                            bool isAdmin = roleKey == "admin";
                            bool isStaff = roleKey == "staff";

                            <tr class="@(user.IsActive ? "" : "is-disabled")"
                                data-role="@roleKey"
                                data-active="@(user.IsActive ? "true" : "false")"
                                data-search="@searchKey">

                                <!-- USER -->
                                <td>
                                    <div class="um-user">
                                        <div class="um-avatar @(isAdmin ? "is-admin" : "")">@initial</div>
                                        <div class="um-user-text">
                                            <strong>@email</strong>
                                            <small>@(isAdmin ? "Administrator account" : "Staff account")</small>
                                        </div>
                                    </div>
                                </td>

                                <!-- ROLE -->
                                <td>
                                    <span class="um-role @(isAdmin ? "admin" : "staff")">
                                        <i class="bi @(isAdmin ? "bi-shield-fill" : "bi-person-fill")"></i>
                                        @(isAdmin ? "Admin" : role)
                                    </span>
                                </td>

                                <!-- STATUS -->
                                <td>
                                    <span class="um-status @(user.IsActive ? "active" : "disabled")">
                                        <span></span>
                                        @(user.IsActive ? "Active" : "Disabled")
                                    </span>
                                </td>

                                <!-- ACTIONS -->
                                <td class="text-end">

                                    @if (isStaff)
                                    {
                                        <div class="um-actions">

                                            <!-- EDIT -->
                                            <a asp-action="Edit"
                                               asp-route-id="@user.Id"
                                               class="um-btn um-btn-edit">
                                                <i class="bi bi-pencil"></i>
                                                <span>Edit</span>
                                            </a>

                                            <!-- ENABLE / DISABLE -->
                                            <form asp-action="ToggleStatus" method="post" class="d-inline">

                                                <input type="hidden" name="id" value="@user.Id" />

                                                @if (user.IsActive)
                                                {
                                                    <button type="submit" class="um-btn um-btn-disable">
                                                        <i class="bi bi-person-x"></i>
                                                        <span>Disable</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="um-btn um-btn-enable">
                                                        <i class="bi bi-person-check"></i>
                                                        <span>Enable</span>
                                                    </button>
                                                }

                                            </form>

                                            <!-- DELETE (opens the confirmation modal) -->
                                            <button type="button"
                                                    class="um-btn um-btn-delete"
                                                    title="Delete account"
                                                    aria-label="Delete @email"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteUserModal"
                                                    data-id="@user.Id"
                                                    data-email="@email">
                                                <i class="bi bi-trash"></i>
                                            </button>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="um-protected">
                                            <i class="bi bi-shield-lock"></i>
                                            Protected
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="um-empty">
                                    <i class="bi bi-people"></i>
                                    <strong>No user accounts yet.</strong>
                                    <span>Add a staff account to get started.</span>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- shown by the script when nothing matches -->
        <div class="um-empty" id="userNoResults" hidden>
            <i class="bi bi-search"></i>
            <strong>No matching users.</strong>
            <span>Try a different search or filter.</span>
        </div>

    </div>

</div>


<!-- =========================================================
     DELETE CONFIRMATION MODAL (one modal, filled by script)
========================================================= -->

<div class="modal fade um-modal"
     id="deleteUserModal"
     tabindex="-1"
     aria-labelledby="deleteUserLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-sm">

        <div class="modal-content">

            <form asp-action="Delete" method="post">

                <input type="hidden" name="id" id="deleteUserId" />

                <div class="modal-body um-modal-body">

                    <div class="um-modal-icon">
                        <i class="bi bi-trash"></i>
                    </div>

                    <h5 id="deleteUserLabel">Delete staff account?</h5>

                    <p>
                        <strong id="deleteUserEmail"></strong>
                        will be permanently deleted. This cannot be undone.
                    </p>

                    <small>To only block access, use Disable instead.</small>

                </div>

                <div class="modal-footer um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="um-btn um-btn-danger-solid">
                        <i class="bi bi-trash"></i>
                        Delete
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <script>
        (function () {
            // ---------- search + role/status filter (one function, so they never fight) ----------
            var rows = Array.prototype.slice.call(document.querySelectorAll('#userTable tbody tr[data-role]'));
            var chips = document.querySelectorAll('#userFilters .um-chip');
            var search = document.getElementById('userSearch');
            var noResults = document.getElementById('userNoResults');
            var filter = 'all';

            function apply() {
                var q = search ? search.value.trim().toLowerCase() : '';
                var visible = 0;

                rows.forEach(function (row) {
                    var okFilter =
                        filter === 'all' ||
                        (filter === 'disabled' ? row.dataset.active === 'false' : row.dataset.role === filter);

                    var okSearch = !q || row.dataset.search.indexOf(q) !== -1;
                    var show = okFilter && okSearch;

                    row.hidden = !show;
                    if (show) visible++;
                });

                if (noResults) noResults.hidden = !rows.length || visible !== 0;
            }

            chips.forEach(function (chip) {
                chip.addEventListener('click', function () {
                    filter = chip.dataset.filter;

                    chips.forEach(function (c) {
                        var on = c === chip;
                        c.classList.toggle('active', on);
                        c.setAttribute('aria-pressed', on ? 'true' : 'false');
                    });

                    apply();
                });
            });

            if (search) search.addEventListener('input', apply);

            // ---------- fill the delete modal with the clicked user ----------
            var modal = document.getElementById('deleteUserModal');
            if (modal) {
                modal.addEventListener('show.bs.modal', function (e) {
                    var btn = e.relatedTarget;
                    if (!btn) return;

                    document.getElementById('deleteUserId').value = btn.getAttribute('data-id');
                    document.getElementById('deleteUserEmail').textContent = btn.getAttribute('data-email');
                });
            }
        })();
    </script>
}