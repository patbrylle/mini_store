@model mini_store.ViewModels.Account.ResetUserPasswordViewModel

<div class="um-modal" id="umResetModal" role="dialog" aria-modal="true" aria-labelledby="umResetTitle" aria-hidden="true">
    <div class="um-modal-card">
        <button type="button" class="um-modal-x" data-um-close aria-label="Close">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>

        <div class="um-modal-head">
            <div class="um-modal-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
            </div>
            <div>
                <h3 id="umResetTitle">Reset password</h3>
                <span class="um-modal-user" id="umResetEmail"></span>
            </div>
        </div>

        <form asp-controller="User" asp-action="ResetPassword" method="post" id="umResetForm" data-min="6" novalidate>
            <input type="hidden" asp-for="Id" id="umResetId" />

            <div class="um-modal-error" id="umResetError" role="alert" hidden></div>

            <div class="um-modal-field">
                <label for="umNewPassword">New password</label>
                <div class="um-pw">
                    <input asp-for="NewPassword" id="umNewPassword" class="um-modal-input" autocomplete="new-password" placeholder="At least 6 characters" />
                    <button type="button" class="um-pw-toggle" aria-label="Show password" aria-pressed="false">
                        <svg class="um-eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="um-eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
            </div>

            <div class="um-modal-field">
                <label for="umConfirmPassword">Confirm password</label>
                <div class="um-pw">
                    <input asp-for="ConfirmPassword" id="umConfirmPassword" class="um-modal-input" autocomplete="new-password" placeholder="Re-enter the password" />
                    <button type="button" class="um-pw-toggle" aria-label="Show password" aria-pressed="false">
                        <svg class="um-eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="um-eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
            </div>

            <div class="um-modal-actions">
                <button type="button" class="um-modal-btn um-modal-btn-light" data-um-close>Cancel</button>
                <button type="submit" class="um-modal-btn um-modal-btn-primary" id="umResetSubmit">Reset password</button>
            </div>
        </form>
    </div>
</div>

<script src="~/js/reset-password.js" asp-append-version="true"></script>