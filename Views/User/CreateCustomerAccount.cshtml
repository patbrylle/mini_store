@model mini_store.ViewModels.Account.CreateCustomerAccountViewModel

@{
    ViewData["Title"] = "Create Customer Account";
}

@section Styles {
    <link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />
}

<div class="um-page um-form-page">

    <a asp-action="Index" class="um-back">
        <i class="bi bi-arrow-left"></i> Back to User Management
    </a>

    <div class="um-header">
        <div class="um-title-area">
            <div class="um-page-icon"><i class="bi bi-person-badge"></i></div>
            <div>
                <h1>Create Customer Account</h1>
                <p>Give an existing customer access to the customer portal.</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="um-card um-form-card">
                <div class="um-form-head">
                    <div class="um-form-head-icon"><i class="bi bi-person-vcard"></i></div>
                    <div>
                        <h5>Account Information</h5>
                        <p>The login email is taken from the customer's record.</p>
                    </div>
                </div>

                <form asp-action="CreateCustomerAccount" method="post">
                    <div class="um-form-body">

                        <div asp-validation-summary="ModelOnly" class="um-alert"></div>

                        <div class="um-field">
                            <label asp-for="CustomerId" class="um-label">Select Customer</label>
                            <div class="um-input-wrap">
                                <i class="bi bi-person"></i>
                                <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="um-input" required>
                                    <option value="">Choose a customer</option>
                                </select>
                            </div>
                            <span asp-validation-for="CustomerId" class="um-field-error"></span>
                            <small class="um-hint">Only customers with an email and no linked account appear here.</small>
                        </div>

                        <div class="um-field">
                            <label asp-for="Password" class="um-label">Temporary Password</label>
                            <div class="um-input-wrap">
                                <i class="bi bi-lock"></i>
                                <input asp-for="Password" class="um-input" type="password"
                                       placeholder="Enter a strong password" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="Password" class="um-field-error"></span>
                        </div>

                        <div class="um-field mb-0">
                            <label asp-for="ConfirmPassword" class="um-label">Confirm Password</label>
                            <div class="um-input-wrap">
                                <i class="bi bi-shield-lock"></i>
                                <input asp-for="ConfirmPassword" class="um-input" type="password"
                                       placeholder="Enter the password again" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="um-field-error"></span>
                        </div>

                    </div>

                    <div class="um-form-actions">
                        <a asp-action="Index" class="um-btn um-btn-ghost">Cancel</a>
                        <button type="submit" class="btn um-add-btn">
                            <i class="bi bi-check-circle"></i> Create Account
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="um-side-card">
                <h6>Good to know</h6>
                <ul class="um-tips">
                    <li>
                        <span class="um-tip-icon"><i class="bi bi-key"></i></span>
                        <div><strong>Temporary password</strong>
                            Share it privately. The customer can change it on My Profile, or use "Forgot password" on the login page.</div>
                    </li>
                    <li>
                        <span class="um-tip-icon"><i class="bi bi-envelope-check"></i></span>
                        <div><strong>Email must be unique</strong>
                            It becomes the login. Fix duplicates on the Customers page first.</div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}