@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-header">
    <div>
        <h1>Dashboard</h1>
        <p class="text-muted">Welcome back! Here's what's happening in your store today.</p>
    </div>
    <div class="dashboard-updated">
        Last updated: @DateTime.Now.ToString("MMM dd, yyyy - h:mm tt")
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card kpi-card shadow-sm border-0">
            <div class="card-body">
                <h6 class="kpi-label">Today's Sales</h6>
                <h2 class="kpi-value">₱@ViewBag.TodaySales</h2>
                <span class="kpi-sub">@ViewBag.TodayTransactionCount transactions</span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card kpi-card shadow-sm border-0">
            <div class="card-body">
                <h6 class="kpi-label">Inventory Value</h6>
                <h2 class="kpi-value">₱@ViewBag.TotalInventoryValue</h2>
                <span class="kpi-sub">Across @ViewBag.TotalProducts products</span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card kpi-card shadow-sm border-0 kpi-alert">
            <div class="card-body">
                <h6 class="kpi-label">Low Stock Items</h6>
                <h2 class="kpi-value">@ViewBag.LowStockCount</h2>
                <a asp-controller="Products" asp-action="LowStock" class="kpi-link">
                    Needs restocking →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card kpi-card shadow-sm border-0">
            <div class="card-body">
                <h6 class="kpi-label">Net Profit (This Month)</h6>
                <h2 class="kpi-value">₱@ViewBag.NetProfitThisMonth</h2>
                <span class="kpi-sub">@ViewBag.TotalCategories categories</span>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="quick-actions mb-4">
    <a asp-controller="Products" asp-action="Create" class="btn btn-quick">+ Add Product</a>
    <a asp-controller="Sales" asp-action="Create" class="btn btn-quick">+ New Sale</a>
    <a asp-controller="Products" asp-action="Index" class="btn btn-quick-outline">+ Add Stock</a>
    <a asp-controller="Reports" asp-action="Index" class="btn btn-quick-outline">📊 View Reports</a>
</div>

<div class="row g-4">
    <!-- Sales Trend -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 panel">
            <div class="card-body">
                <div class="panel-header">
                    <h5>Sales Overview</h5>
                </div>
                <canvas id="salesTrendChart" height="90"></canvas>
            </div>
        </div>
    </div>

    <!-- Sales by Category -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 panel">
            <div class="card-body">
                <div class="panel-header">
                    <h5>Sales by Category</h5>
                </div>
                <canvas id="categoryChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <!-- Low Stock Alerts -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 panel">
            <div class="card-body">
                <div class="panel-header">
                    <h5>Low Stock Alerts</h5>
                    <span class="badge-count">@ViewBag.LowStockCount items</span>
                </div>

                @if (ViewBag.LowStockItems != null && ViewBag.LowStockItems.Count > 0)
                {
                    <table class="table table-hover dashboard-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Stock</th>
                                <th>Reorder Level</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ViewBag.LowStockItems)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td><span class="stock-badge">@item.QuantityInStock</span></td>
                                    <td>@item.ReorderThreshold</td>
                                    <td>
                                        <a asp-controller="Products" asp-action="Edit" asp-route-id="@item.Id" class="text-decoration-none">
                                            Restock
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="empty-state">🎉 All products are well stocked.</p>
                }
            </div>
        </div>
    </div>

    <!-- Recent Transactions -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 panel">
            <div class="card-body">
                <div class="panel-header">
                    <h5>Recent Transactions</h5>
                    <a asp-controller="Sales" asp-action="Index" class="panel-link">View all →</a>
                </div>

                @if (ViewBag.RecentTransactions != null && ViewBag.RecentTransactions.Count > 0)
                {
                    <table class="table table-hover dashboard-table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tx in ViewBag.RecentTransactions)
                            {
                                <tr>
                                    <td>#@tx.Id</td>
                                    <td>₱@tx.TotalAmount</td>
                                    <td><span class="status-badge status-@tx.Status.ToLower()">@tx.Status</span></td>
                                    <td>@tx.CreatedAt.ToString("h:mm tt")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="empty-state">No transactions yet today.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <script>
        // Sales Trend Chart
        const salesTrendCtx = document.getElementById('salesTrendChart');
        new Chart(salesTrendCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(ViewBag.SalesTrendLabels ?? "[]"),
                datasets: [{
                    label: 'Sales',
                    data: @Html.Raw(ViewBag.SalesTrendData ?? "[]"),
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37, 99, 235, 0.08)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });

        // Category Chart
        const categoryCtx = document.getElementById('categoryChart');
        new Chart(categoryCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(ViewBag.CategoryLabels ?? "[]"),
                datasets: [{
                    data: @Html.Raw(ViewBag.CategoryData ?? "[]"),
                    backgroundColor: ['#2563eb', '#22c55e', '#f59e0b', '#ef4444', '#8b5cf6']
                }]
            },
            options: {
                plugins: { legend: { position: 'bottom' } }
            }
        });
    </script>
}