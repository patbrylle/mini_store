@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/dashboard.css"
          asp-append-version="true" />
}

<div class="dashboard-page">

    <!-- HEADER -->
    <div class="dashboard-header">
        <div>
            <h1 class="dashboard-title">Dashboard</h1>

            <p class="dashboard-subtitle">
                Welcome back! Here's what's happening in your store today.
            </p>
        </div>

        <div class="dashboard-updated">
            <i class="bi bi-clock-history"></i>
            Last updated:
            @DateTime.Now.ToString("MMM dd, yyyy - h:mm tt")
        </div>
    </div>


    <!-- SUMMARY CARDS -->
    <div class="row g-4 mb-4">

        <!-- Today's Sales -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">

                <div class="kpi-icon kpi-icon-primary">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <div>
                    <h6 class="kpi-label">
                        Today's Sales
                    </h6>

                    <h2 class="kpi-value">
                        ₱@(((decimal)ViewBag.TodaySales).ToString("N2"))
                    </h2>
                </div>

            </div>
        </div>


        <!-- Inventory Value -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">

                <div class="kpi-icon kpi-icon-gold">
                    <i class="bi bi-box-seam-fill"></i>
                </div>

                <div>
                    <h6 class="kpi-label">
                        Inventory Value
                    </h6>

                    <h2 class="kpi-value">
                        ₱@(((decimal)ViewBag.TotalInventoryValue).ToString("N2"))
                    </h2>
                </div>

            </div>
        </div>


        <!-- Low Stock -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card kpi-card-alert">

                <div class="kpi-icon kpi-icon-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <div>
                    <h6 class="kpi-label">
                        Low Stock Items
                    </h6>

                    <h2 class="kpi-value">
                        @ViewBag.LowStockCount
                    </h2>

                    <a asp-controller="Inventory"
                       asp-action="Index"
                       class="kpi-link">

                        View Inventory
                        <i class="bi bi-arrow-right"></i>

                    </a>
                </div>

            </div>
        </div>


        <!-- This Month's Sales -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">

                <div class="kpi-icon kpi-icon-success">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>

                <div>
                    <h6 class="kpi-label">
                        This Month's Sales
                    </h6>

                    <h2 class="kpi-value">
                        ₱@(((decimal)ViewBag.ThisMonthSales).ToString("N2"))
                    </h2>
                </div>

            </div>
        </div>

    </div>


    <!-- QUICK ACTIONS -->
    <div class="quick-actions mb-4">

        <a asp-controller="Products"
           asp-action="Create"
           class="btn-quick">

            <i class="bi bi-plus-lg"></i>
            Add Product

        </a>


        <a asp-controller="Sales"
           asp-action="Create"
           class="btn-quick">

            <i class="bi bi-receipt"></i>
            New Sale

        </a>


        <a asp-controller="Utang"
           asp-action="Create"
           class="btn-quick">

            <i class="bi bi-wallet2"></i>
            Record Utang

        </a>


        <a asp-controller="Inventory"
           asp-action="Index"
           class="btn-quick-outline">

            <i class="bi bi-boxes"></i>
            Add Stock

        </a>


        <a asp-controller="Reports"
           asp-action="Index"
           class="btn-quick-outline">

            <i class="bi bi-bar-chart-line-fill"></i>
            View Reports

        </a>

    </div>


    <!-- CHARTS -->
    <div class="row g-4 mb-4">

        <!-- SALES OVERVIEW -->
        <div class="col-lg-8">

            <div class="panel">

                <div class="panel-header">

                    <div>
                        <h5>Sales Overview</h5>

                        <small>
                            Sales for this month
                        </small>
                    </div>

                </div>

                <div class="chart-container">
                    <canvas id="salesTrendChart"></canvas>
                </div>

            </div>

        </div>


        <!-- CATEGORY BREAKDOWN -->
        <div class="col-lg-4">

            <div class="panel">

                <div class="panel-header">

                    <div>
                        <h5>Category Breakdown</h5>

                        <small>
                            Current inventory
                        </small>
                    </div>

                </div>

                <div class="category-chart-container">
                    <canvas id="categoryChart"></canvas>
                </div>

            </div>

        </div>

    </div>


    <!-- TABLES -->
    <div class="row g-4">

        <!-- LOW STOCK -->
        <div class="col-lg-6">

            <div class="panel">

                <div class="panel-header">

                    <div>
                        <h5>Low Stock Alerts</h5>

                        <small>
                            Products that may need restocking
                        </small>
                    </div>

                    <span class="badge-count">
                        @ViewBag.LowStockCount items
                    </span>

                </div>


                @if (ViewBag.LowStockItems != null &&
                     ViewBag.LowStockItems.Count > 0)
                {
                    <div class="table-responsive">

                        <table class="table table-hover dashboard-table">

                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th>Stock</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in ViewBag.LowStockItems)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                @item.ProductName
                                            </strong>
                                        </td>

                                        <td>
                                            @(item.Category?.CategoryName ?? "Uncategorized")
                                        </td>

                                        <td>

                                            @if (item.Quantity == 0)
                                            {
                                                <span class="stock-badge stock-out">
                                                    Out of Stock
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="stock-badge">
                                                    @item.Quantity
                                                </span>
                                            }

                                        </td>

                                        <td>
                                            <a asp-controller="Inventory"
                                               asp-action="Index"
                                               class="row-link">

                                                Restock
                                                <i class="bi bi-arrow-right"></i>

                                            </a>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="empty-state">

                        <i class="bi bi-check-circle"></i>

                        <p>
                            All products are well stocked.
                        </p>

                    </div>
                }

            </div>

        </div>


        <!-- RECENT TRANSACTIONS -->
        <div class="col-lg-6">

            <div class="panel">

                <div class="panel-header">

                    <div>
                        <h5>Recent Transactions</h5>

                        <small>
                            Latest sales
                        </small>
                    </div>

                    <a asp-controller="Sales"
                       asp-action="Index"
                       class="panel-link">

                        View all
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>


                @if (ViewBag.RecentTransactions != null &&
                     ViewBag.RecentTransactions.Count > 0)
                {
                    <div class="table-responsive">

                        <table class="table table-hover dashboard-table">

                            <thead>
                                <tr>
                                    <th>Sale</th>
                                    <th>Customer</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var tx in ViewBag.RecentTransactions)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                #@tx.SaleId
                                            </strong>

                                            <small class="d-block text-muted">
                                                @tx.SaleDate.ToString("MMM dd, h:mm tt")
                                            </small>
                                        </td>

                                        <td>
                                            @(tx.Customer?.CustomerName ?? "Walk-in Customer")
                                        </td>

                                        <td>
                                            ₱@tx.TotalAmount.ToString("N2")
                                        </td>

                                        <td>

                                            @if (tx.Status == "Paid")
                                            {
                                                <span class="status-badge status-paid">
                                                    Paid
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-unpaid">
                                                    @tx.Status
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="empty-state">

                        <i class="bi bi-receipt"></i>

                        <p>
                            No transactions yet.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <!-- Chart.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>

    <!-- Dashboard data from Controller -->
    <script>
        window.dashboardSalesLabels =
            @Html.Raw(ViewBag.SalesTrendLabels ?? "[]");

        window.dashboardSalesData =
            @Html.Raw(ViewBag.SalesTrendData ?? "[]");

        window.dashboardCategoryLabels =
            @Html.Raw(ViewBag.CategoryLabels ?? "[]");

        window.dashboardCategoryData =
            @Html.Raw(ViewBag.CategoryData ?? "[]");
    </script>

    <!-- Dashboard JavaScript -->
    <script src="~/js/dashboard.js"
            asp-append-version="true"></script>
}