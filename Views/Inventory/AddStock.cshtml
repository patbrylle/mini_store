@model mini_store.Models.Product

@{
    ViewData["Title"] = "Add Stock";
}

<div class="mb-4">
    <h1 class="fw-bold mb-1">Add Stock</h1>
    <p class="text-muted mb-0">
        Increase the available stock of a product.
    </p>
</div>

<div class="row">

    <div class="col-md-6">

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4">

                <h5 class="fw-bold mb-4">Product Information</h5>

                <div class="mb-3">
                    <label class="form-label text-muted">
                        Product
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.ProductName"
                           readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">
                        Category
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@(Model.Category?.CategoryName ?? "No Category")"
                           readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">
                        Current Stock
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.Quantity"
                           readonly>
                </div>

                <form asp-action="AddStock" method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.ProductId" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-4">
                        <label for="quantity"
                               class="form-label fw-semibold">
                            Quantity to Add
                        </label>

                        <input type="number"
                               id="quantity"
                               name="quantity"
                               class="form-control"
                               min="1"
                               value="1"
                               required>

                        <small class="text-muted">
                            Enter the number of items you want to add.
                        </small>
                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-success">
                            <i class="bi bi-plus-lg"></i>
                            Add Stock
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

