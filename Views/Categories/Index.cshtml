@model IEnumerable<mini_store.Models.Category>

@{
    ViewData["Title"] = "Categories";

    var categories = Model?.ToList()
        ?? new List<mini_store.Models.Category>();

    var totalCategories = categories.Count;

    /*
     * This will be replaced by the real product count
     * when your Category model has a Products navigation property.
     */
    var totalProducts = categories.Sum(c =>
        c.Products?.Count ?? 0);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/categories.css"
          asp-append-version="true" />
}

<div class="category-page">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <div class="category-header">

        <div class="category-title-area">

            <div class="category-page-icon">
                <i class="bi bi-tags"></i>
            </div>

            <div>
                <h1>Categories</h1>

                <p>
                    Manage and organize your store products into categories.
                </p>
            </div>

        </div>


        <button type="button"
                class="category-primary-btn"
                data-bs-toggle="modal"
                data-bs-target="#addCategoryModal">

            <i class="bi bi-plus-lg"></i>

            Add Category

        </button>

    </div>


    <!-- =========================================================
         SUMMARY / KPI CARDS
    ========================================================== -->

    <div class="row g-3 category-kpi-row">

        <!-- TOTAL CATEGORIES -->

        <div class="col-md-6">

            <div class="category-stat-card">

                <div class="category-stat-icon stat-primary">

                    <i class="bi bi-folder2-open"></i>

                </div>

                <div>

                    <span class="category-stat-label">
                        Total Categories
                    </span>

                    <h3>
                        @totalCategories
                    </h3>

                    <small>
                        Active product categories
                    </small>

                </div>

            </div>

        </div>


        <!-- PRODUCTS CATEGORIZED -->

        <div class="col-md-6">

            <div class="category-stat-card">

                <div class="category-stat-icon stat-gold">

                    <i class="bi bi-box-seam"></i>

                </div>

                <div>

                    <span class="category-stat-label">
                        Products Categorized
                    </span>

                    <h3>
                        @totalProducts
                    </h3>

                    <small>
                        Products assigned to categories
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         CATEGORY DIRECTORY
    ========================================================== -->

    <div class="category-table-card">


        <!-- DIRECTORY HEADER -->

        <div class="category-table-header">

            <div class="category-section-title">

                <div class="category-section-icon">

                    <i class="bi bi-list-ul"></i>

                </div>

                <div>

                    <h5>
                        Category Directory
                    </h5>

                    <p>
                        Manage your product categories and view their products.
                    </p>

                </div>

            </div>


            <!-- SEARCH -->

            <div class="category-search">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="categorySearch"
                       placeholder="Search categories..."
                       autocomplete="off" />

            </div>

        </div>


        <!-- =====================================================
             TABLE
        ====================================================== -->

        <div class="table-responsive">

            <table class="table category-table">

                <thead>

                    <tr>

                        <th>
                            Category
                        </th>

                        <th>
                            Products
                        </th>

                        <th>
                            Status
                        </th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody id="categoryTableBody">

                    @if (categories.Any())
                    {
                        foreach (var category in categories)
                        {
                            var productCount =
                                category.Products?.Count ?? 0;

                            <tr class="category-row">

                                <!-- CATEGORY -->

                                <td>

                                    <div class="category-cell">

                                        <div class="category-avatar">

                                            <i class="bi bi-folder"></i>

                                        </div>

                                        <div>

                                            <div class="category-name">
                                                @category.CategoryName
                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- PRODUCTS -->

                                <td>

                                    <span class="category-product-count">

                                        @productCount

                                        @(productCount == 1
                                            ? "Product"
                                            : "Products")

                                    </span>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    <span class="category-status">

                                        <span class="category-status-dot">
                                        </span>

                                        Active

                                    </span>

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="category-actions">

                                        <!-- VIEW PRODUCTS -->

                                        <a asp-controller="Categories"
                                           asp-action="Products"
                                           asp-route-id="@category.CategoryId"
                                           class="category-action-btn category-view-btn">

                                            <i class="bi bi-eye"></i>

                                            View Products

                                        </a>


                                        <!-- EDIT -->

                                        <a asp-action="Edit"
                                           asp-route-id="@category.CategoryId"
                                           class="category-action-btn category-edit-btn">

                                            <i class="bi bi-pencil"></i>

                                            Edit

                                        </a>


                                        <!-- DELETE -->

                                        <a asp-action="Delete"
                                           asp-route-id="@category.CategoryId"
                                           class="category-action-btn category-delete-btn">

                                            <i class="bi bi-trash"></i>

                                            Delete

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="4">

                                <div class="category-empty">

                                    <div class="category-empty-icon">

                                        <i class="bi bi-folder2-open"></i>

                                    </div>

                                    <h5>
                                        No categories yet
                                    </h5>

                                    <p>
                                        Add your first category to organize your products.
                                    </p>

                                    <button type="button"
                                            class="category-primary-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#addCategoryModal">

                                        <i class="bi bi-plus-lg"></i>

                                        Add Category

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =============================================================
     ADD CATEGORY MODAL
============================================================== -->

<div class="modal fade"
     id="addCategoryModal"
     tabindex="-1"
     aria-labelledby="addCategoryModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content category-modal">

            <form asp-controller="Categories"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- HEADER -->

                <div class="modal-header category-modal-header">

                    <div class="category-modal-title">

                        <div class="category-modal-icon">

                            <i class="bi bi-folder-plus"></i>

                        </div>

                        <div>

                            <h5 id="addCategoryModalLabel">
                                Add Category
                            </h5>

                            <p>
                                Create a new product category.
                            </p>

                        </div>

                    </div>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <!-- BODY -->

                <div class="modal-body category-modal-body">

                    <div class="category-form-group">

                        <label for="CategoryName">
                            Category Name
                        </label>

                        <div class="category-input">

                            <i class="bi bi-tag"></i>

                            <input type="text"
                                   id="CategoryName"
                                   name="CategoryName"
                                   class="form-control"
                                   placeholder="Enter category name"
                                   required />

                        </div>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer category-modal-footer">

                    <button type="button"
                            class="btn category-cancel-btn"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn category-save-btn">

                        <i class="bi bi-check-lg me-1"></i>

                        Save Category

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script src="~/js/categories.js"
            asp-append-version="true"></script>

}