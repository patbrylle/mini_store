@model IEnumerable<mini_store.Models.Category>

@{
    ViewData["Title"] = "Categories";

    var categories = Model?.ToList() ?? new List<mini_store.Models.Category>();

    var totalCategories = categories.Count;

    var totalProducts = categories.Sum(c =>
        c.Products?.Count ?? 0
    );
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/categories.css"
          asp-append-version="true" />
}

<div class="category-page">

    <!-- ============================================================
         PAGE HEADER
         ============================================================ -->

    <div class="category-header">

        <div class="category-title-area">

            <div class="category-page-icon">
                <i class="bi bi-tags"></i>
            </div>

            <div>
                <h1>Categories</h1>

                <p>
                    Manage and organize your store products into categories.
                </p>
            </div>

        </div>

        <button type="button"
                class="category-primary-btn"
                data-bs-toggle="modal"
                data-bs-target="#addCategoryModal">

            <i class="bi bi-plus-lg"></i>

            Add Category

        </button>

    </div>


    <!-- ============================================================
         KPI CARDS
         ============================================================ -->

    <div class="row g-3 category-kpi-row">

        <!-- TOTAL CATEGORIES -->

        <div class="col-md-6">

            <div class="category-stat-card">

                <div class="category-stat-icon">
                    <i class="bi bi-folder2-open"></i>
                </div>

                <div>

                    <span class="category-stat-label">
                        Total Categories
                    </span>

                    <h3>
                        @totalCategories
                    </h3>

                    <small>
                        Active product categories
                    </small>

                </div>

            </div>

        </div>


        <!-- TOTAL PRODUCTS -->

        <div class="col-md-6">

            <div class="category-stat-card">

                <div class="category-stat-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <div>

                    <span class="category-stat-label">
                        Products Categorized
                    </span>

                    <h3>
                        @totalProducts
                    </h3>

                    <small>
                        Products assigned to categories
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         CATEGORY DIRECTORY
         ============================================================ -->

    <div class="category-table-card">

        <div class="category-table-header">

            <div class="category-section-title">

                <div class="category-section-icon">
                    <i class="bi bi-list-ul"></i>
                </div>

                <div>

                    <h5>
                        Category Directory
                    </h5>

                    <p>
                        Manage your product categories and view their products.
                    </p>

                </div>

            </div>


            <!-- SEARCH -->

            <div class="category-search">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="categorySearch"
                       placeholder="Search categories..."
                       autocomplete="off" />

            </div>

        </div>


        <!-- ========================================================
             CATEGORY TABLE
             ======================================================== -->

        <div class="table-responsive">

            <table class="table category-table">

                <thead>

                    <tr>

                        <th>
                            Category
                        </th>

                        <th>
                            Products
                        </th>

                        <th>
                            Status
                        </th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody id="categoryTableBody">

                    @if (categories.Any())
                    {
                        foreach (var category in categories)
                        {
                            var productCount =
                                category.Products?.Count ?? 0;

                            <tr class="category-row">

                                <!-- CATEGORY -->

                                <td>

                                    <div class="category-cell">

                                        <div class="category-avatar">

                                            <i class="bi bi-folder"></i>

                                        </div>

                                        <div class="category-name">

                                            @category.CategoryName

                                        </div>

                                    </div>

                                </td>


                                <!-- PRODUCT COUNT -->

                                <td>

                                    <span class="category-product-count">

                                        @productCount

                                        @(productCount == 1
                                            ? "Product"
                                            : "Products")

                                    </span>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    <span class="category-status">

                                        <span class="category-status-dot">
                                        </span>

                                        Active

                                    </span>

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="category-actions">


                                        <!-- VIEW PRODUCTS -->

                                        <button type="button"
                                                class="category-action-btn category-view-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#viewProductsModal-@category.CategoryId">

                                            <i class="bi bi-eye"></i>

                                            View Products

                                        </button>


                                        <!-- EDIT -->

                                        <button type="button"
                                                class="category-action-btn category-edit-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editCategoryModal-@category.CategoryId">

                                            <i class="bi bi-pencil"></i>

                                            Edit

                                        </button>


                                        <!-- DELETE -->

                                        <button type="button"
                                                class="category-action-btn category-delete-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteCategoryModal-@category.CategoryId">

                                            <i class="bi bi-trash"></i>

                                            Delete

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="4">

                                <div class="category-empty">

                                    <div class="category-empty-icon">

                                        <i class="bi bi-folder2-open"></i>

                                    </div>

                                    <h5>
                                        No categories yet
                                    </h5>

                                    <p>
                                        Add your first category to organize
                                        your products.
                                    </p>

                                    <button type="button"
                                            class="category-primary-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#addCategoryModal">

                                        <i class="bi bi-plus-lg"></i>

                                        Add Category

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- ================================================================
     ADD CATEGORY MODAL
     ================================================================ -->

<div class="modal fade"
     id="addCategoryModal"
     tabindex="-1"
     aria-labelledby="addCategoryModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content category-modal">

            <form asp-controller="Categories"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- HEADER -->

                <div class="modal-header category-modal-header">

                    <div class="category-modal-title">

                        <div class="category-modal-icon">

                            <i class="bi bi-folder-plus"></i>

                        </div>

                        <div>

                            <h5 id="addCategoryModalLabel">
                                Add Category
                            </h5>

                            <p>
                                Create a new product category.
                            </p>

                        </div>

                    </div>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <!-- BODY -->

                <div class="modal-body category-modal-body">

                    <div class="category-form-group">

                        <label for="CategoryName">
                            Category Name
                        </label>

                        <div class="category-input">

                            <i class="bi bi-tag"></i>

                            <input type="text"
                                   id="CategoryName"
                                   name="CategoryName"
                                   class="form-control"
                                   placeholder="Enter category name"
                                   required />

                        </div>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer category-modal-footer">

                    <button type="button"
                            class="btn category-cancel-btn"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn category-save-btn">

                        <i class="bi bi-check-lg me-1"></i>

                        Save Category

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ================================================================
     EDIT / DELETE / VIEW PRODUCT MODALS
     ================================================================ -->

@foreach (var category in categories)
{

    <!-- ============================================================
         EDIT CATEGORY MODAL
         ============================================================ -->

    <div class="modal fade"
         id="editCategoryModal-@category.CategoryId"
         tabindex="-1"
         aria-labelledby="editCategoryModalLabel-@category.CategoryId"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content category-modal">

                <form asp-controller="Categories"
                      asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="id"
                           value="@category.CategoryId" />

                    <input type="hidden"
                           name="CategoryId"
                           value="@category.CategoryId" />


                    <!-- HEADER -->

                    <div class="modal-header category-modal-header">

                        <div class="category-modal-title">

                            <div class="category-modal-icon">

                                <i class="bi bi-pencil"></i>

                            </div>

                            <div>

                                <h5 id="editCategoryModalLabel-@category.CategoryId">
                                    Edit Category
                                </h5>

                                <p>
                                    Update the category information.
                                </p>

                            </div>

                        </div>


                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>


                    <!-- BODY -->

                    <div class="modal-body category-modal-body">

                        <div class="category-form-group">

                            <label for="editCategoryName-@category.CategoryId">
                                Category Name
                            </label>

                            <div class="category-input">

                                <i class="bi bi-tag"></i>

                                <input type="text"
                                       id="editCategoryName-@category.CategoryId"
                                       name="CategoryName"
                                       class="form-control"
                                       value="@category.CategoryName"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- FOOTER -->

                    <div class="modal-footer category-modal-footer">

                        <button type="button"
                                class="btn category-cancel-btn"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button type="submit"
                                class="btn category-save-btn">

                            <i class="bi bi-check-lg me-1"></i>

                            Save Changes

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>


    <!-- ============================================================
         DELETE CATEGORY MODAL
         ============================================================ -->

    <div class="modal fade"
         id="deleteCategoryModal-@category.CategoryId"
         tabindex="-1"
         aria-labelledby="deleteCategoryModalLabel-@category.CategoryId"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content category-modal">


                <!-- HEADER -->

                <div class="modal-header category-modal-header">

                    <div class="category-modal-title">

                        <div class="category-modal-icon is-danger">

                            <i class="bi bi-trash"></i>

                        </div>

                        <div>

                            <h5 id="deleteCategoryModalLabel-@category.CategoryId">
                                Delete Category
                            </h5>

                            <p>
                                This action cannot be undone.
                            </p>

                        </div>

                    </div>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <!-- BODY -->

                <div class="modal-body category-modal-body">

                    <p>

                        Are you sure you want to delete

                        <strong>
                            @category.CategoryName
                        </strong>?

                    </p>


                    @if (category.Products != null &&
                         category.Products.Any())
                    {

                        <div class="alert alert-warning">

                            <i class="bi bi-exclamation-triangle"></i>

                            <span>

                                This category contains

                                <strong>
                                    @category.Products.Count
                                </strong>

                                product(s).

                            </span>

                        </div>

                    }

                </div>


                <!-- FOOTER -->

                <div class="modal-footer category-modal-footer">

                    <button type="button"
                            class="btn category-cancel-btn"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <form asp-controller="Categories"
                          asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@category.CategoryId" />

                        <button type="submit"
                                class="btn btn-danger">

                            <i class="bi bi-trash me-1"></i>

                            Delete Category

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         VIEW PRODUCTS MODAL
         ============================================================ -->

    <div class="modal fade"
         id="viewProductsModal-@category.CategoryId"
         tabindex="-1"
         aria-labelledby="viewProductsModalLabel-@category.CategoryId"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content category-modal">


                <!-- HEADER -->

                <div class="modal-header category-modal-header">

                    <div class="category-modal-title">

                        <div class="category-modal-icon">

                            <i class="bi bi-box-seam"></i>

                        </div>

                        <div>

                            <h5 id="viewProductsModalLabel-@category.CategoryId">

                                @category.CategoryName Products

                            </h5>

                            <p>

                                Products assigned to this category.

                            </p>

                        </div>

                    </div>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <!-- BODY -->

                <div class="modal-body category-modal-body">

                    @if (category.Products != null &&
                         category.Products.Any())
                    {

                        <div class="table-responsive">

                            <table class="table category-table">

                                <thead>

                                    <tr>

                                        <th>
                                            Product
                                        </th>

                                        <th>
                                            Price
                                        </th>

                                        <th>
                                            Stock
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var product in category.Products)
                                    {

                                        <tr>

                                            <!-- PRODUCT -->

                                            <td>

                                                <div class="category-cell">

                                                    <div class="category-avatar">

                                                        <i class="bi bi-box"></i>

                                                    </div>

                                                    <div class="category-name">

                                                        @product.ProductName

                                                    </div>

                                                </div>

                                            </td>


                                            <!-- PRICE -->

                                            <td>

                                                ₱@product.Price.ToString("N2")

                                            </td>


                                            <!-- STOCK -->

                                            <td>

                                                @product.Quantity

                                            </td>

                                        </tr>

                                    }

                                </tbody>

                            </table>

                        </div>

                    }
                    else
                    {

                        <div class="category-empty">

                            <div class="category-empty-icon">

                                <i class="bi bi-box-seam"></i>

                            </div>

                            <h5>
                                No products in this category
                            </h5>

                            <p>

                                There are currently no products assigned
                                to

                                <strong>
                                    @category.CategoryName
                                </strong>.

                            </p>

                        </div>

                    }

                </div>


                <!-- FOOTER -->

                <div class="modal-footer category-modal-footer">

                    <button type="button"
                            class="btn category-cancel-btn"
                            data-bs-dismiss="modal">

                        Close

                    </button>

                </div>

            </div>

        </div>

    </div>

}


@section Scripts {

    <script src="~/js/categories.js"
            asp-append-version="true">
    </script>

}
