@model mini_store.Models.TransactionFormData
@using mini_store.Models
@{
    var returnTo = ViewData["ReturnTo"]?.ToString() ?? "Sales";
    var defaultType = string.Equals(
        ViewData["DefaultTransactionType"]?.ToString(), "Utang",
        StringComparison.OrdinalIgnoreCase) ? "Utang" : "Cash";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div id="txRoot"
     data-create-url="@Url.Action("Create", "Sales")"
     data-pay-url="@Url.Action("Pay", "Sales")"
     data-details-url="@Url.Action("Details", "Sales")"
     data-receipt-url="@Url.Action("Receipt", "Sales")"
     data-return="@returnTo">

    <!-- ================= NEW TRANSACTION ================= -->
    <div class="modal fade tx-modal" id="newSaleModal" tabindex="-1"
         aria-labelledby="newSaleModalLabel" aria-hidden="true"
         data-default-type="@defaultType">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <form id="saleForm" novalidate autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IdempotencyKey" id="txKey" />

                    <div class="modal-header tx-header">
                        <div class="tx-header-icon"><i class="bi bi-cart-plus"></i></div>
                        <div class="me-auto">
                            <h5 class="tx-title" id="newSaleModalLabel">New Transaction</h5>
                            <p class="tx-sub" id="txStepLabel">Step 1 of 2 · Build the order</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body tx-body">
                        <div id="txError" class="tx-alert" role="alert" hidden></div>

                        <!-- STEP 1 -->
                        <div id="txStepEdit" class="tx-grid">

                            <section class="tx-catalog">
                                <div class="tx-search">
                                    <i class="bi bi-search"></i>
                                    <input type="text" id="txSearch" placeholder="Search products…  (Enter adds the first match)" aria-label="Search products" />
                                </div>

                                <div class="tx-cats" id="txCats">
                                    <button type="button" class="tx-chip active" data-cat="all">All</button>
                                    @foreach (var c in Model.Categories)
                                    {
                                        <button type="button" class="tx-chip" data-cat="@c.CategoryId">@c.CategoryName</button>
                                    }
                                </div>

                                <div class="tx-products" id="txProducts">
                                    @foreach (var p in Model.Products)
                                    {
                                        <button type="button" class="tx-product"
                                                data-id="@p.ProductId"
                                                data-name="@p.ProductName"
                                                data-price="@p.Price.ToString("0.00", inv)"
                                                data-stock="@p.Quantity"
                                                data-cat="@p.CategoryId"
                                                data-search="@((p.ProductName + " " + p.Category?.CategoryName).ToLowerInvariant())">
                                            <span class="tx-product-name">@p.ProductName</span>
                                            <span class="tx-product-cat">@(p.Category?.CategoryName ?? "Uncategorized")</span>
                                            <span class="tx-product-foot">
                                                <strong>₱@p.Price.ToString("N2")</strong>
                                                <em class="@(p.Quantity <= 10 ? "is-low" : "")">@p.Quantity left</em>
                                            </span>
                                        </button>
                                    }
                                    <div class="tx-empty" id="txNoProducts" hidden>
                                        <i class="bi bi-search"></i>
                                        <span>No products match.</span>
                                    </div>
                                </div>
                            </section>

                            <section class="tx-order">

                                <div class="tx-section">
                                    <span class="tx-label">Transaction type</span>
                                    <div class="tx-type-grid">
                                        <label class="tx-type">
                                            <input type="radio" name="TransactionType" value="Cash" @(defaultType == "Cash" ? "checked" : "") />
                                            <span class="tx-type-card">
                                                <i class="bi bi-cash-coin"></i>
                                                <span><strong>Cash sale</strong><small>Paid in full now</small></span>
                                            </span>
                                        </label>
                                        <label class="tx-type">
                                            <input type="radio" name="TransactionType" value="Utang" @(defaultType == "Utang" ? "checked" : "") />
                                            <span class="tx-type-card">
                                                <i class="bi bi-wallet2"></i>
                                                <span><strong>Utang</strong><small>Pay later, on credit</small></span>
                                            </span>
                                        </label>
                                    </div>
                                </div>

                                <div class="tx-section">
                                    <label class="tx-label" for="txCustomer">Customer</label>
                                    <select id="txCustomer" name="CustomerId" class="form-select tx-input">
<option value="" id="txWalkIn">Walk-in customer</option>                                        @foreach (var c in Model.Customers)
                                        {
                                            <option value="@c.CustomerId">@c.CustomerName</option>
                                        }
                                    </select>
                                    <small class="tx-help" id="txCustomerHint">Optional for cash sales.</small>
                                </div>

                                <div class="tx-section">
                                    <span class="tx-label">Order</span>
                                    <div class="tx-cart" id="txCart">
                                        <div class="tx-cart-empty" id="txCartEmpty">
                                            <i class="bi bi-cart3"></i>
                                            <span>Tap a product to add it.</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="tx-section" id="txDueWrap" hidden>
                                    <label class="tx-label" for="txDue">Due date</label>
                                    <div class="tx-due">
                                        <input type="date" id="txDue" name="DueDate" class="form-control tx-input" />
                                        <button type="button" class="tx-chip" data-days="7">7 days</button>
                                        <button type="button" class="tx-chip" data-days="15">15 days</button>
                                        <button type="button" class="tx-chip" data-days="30">30 days</button>
                                    </div>
                                </div>

                                <div class="tx-pay-box">
    <div class="tx-row tx-row-total">
        <span>Total</span>
        <strong id="txTotal">₱0.00</strong>
    </div>

<label class="tx-label" for="txPaid" id="txPaidLabel">Amount paid (cash)</label> 
   <div class="tx-money">
        <span>₱</span>
        <input type="number" id="txPaid" name="AmountPaid" min="0" step="0.01" value="0" inputmode="decimal" />
    </div>
    <small class="tx-help" id="txPaidHint" hidden>Make a partial payment now. Leave it at 0 if the customer pays nothing today. The rest becomes the utang balance.</small>

    <div class="tx-quick" id="txQuick">
        <button type="button" class="tx-chip" data-quick="exact">Exact</button>
        <button type="button" class="tx-chip" data-quick="100">₱100</button>
        <button type="button" class="tx-chip" data-quick="500">₱500</button>
        <button type="button" class="tx-chip" data-quick="1000">₱1,000</button>
    </div>

    <div class="tx-row tx-row-result">
        <span id="txResultLabel">Change</span>
        <strong id="txResult">₱0.00</strong>
    </div>

    <div class="tx-note" id="txUtangNote" hidden>
        <i class="bi bi-info-circle"></i>
        <span>The remaining amount is recorded as the customer's utang balance.</span>
    </div>
</div>
                            </section>
                        </div>

                        <!-- STEP 2 -->
                        <div id="txStepReview" class="tx-review" hidden></div>
                    </div>

                    <div class="modal-footer tx-footer">
                        <button type="button" class="tx-btn tx-btn-ghost" data-bs-dismiss="modal" id="txCancel">Cancel</button>
                        <button type="button" class="tx-btn tx-btn-ghost" id="txBack" hidden><i class="bi bi-arrow-left"></i> Back</button>
                        <button type="button" class="tx-btn tx-btn-primary" id="txReview" disabled>Review order <i class="bi bi-arrow-right"></i></button>
                        <button type="button" class="tx-btn tx-btn-success" id="txConfirm" hidden><i class="bi bi-check2-circle"></i> Confirm &amp; save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ================= DETAILS (loaded by AJAX) ================= -->
    <div class="modal fade tx-modal" id="txDetailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content" id="txDetailsBody"></div>
        </div>
    </div>

    <!-- ================= RECEIPT (loaded by AJAX) ================= -->
    <div class="modal fade tx-modal" id="txReceiptModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content" id="txReceiptBody"></div>
        </div>
    </div>
</div>