
@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var isAdmin = User.IsInRole("Admin");
    var isStaff = User.IsInRole("Staff");
    var isCustomer = User.IsInRole("Customer");
    var isStoreUser = isAdmin || isStaff;

    var userName = User.Identity?.Name ?? "User";

    var userRole = isAdmin
        ? "Administrator"
        : isStaff
            ? "Staff"
            : isCustomer
                ? "Customer"
                : "User";

    var avatarLetter = string.IsNullOrWhiteSpace(userName)
        ? "U"
        : userName.Trim()[0].ToString().ToUpper();

    string Active(params string[] controllers) =>
        controllers.Contains(
            currentController,
            StringComparer.OrdinalIgnoreCase) ? "active" : "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Mini Store</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

      @await RenderSectionAsync("Styles", required: false)
<script>
    (function () {
        var KEY = 'ms-theme';
        var mq = window.matchMedia('(prefers-color-scheme: dark)');

        function stored() {
            try { return localStorage.getItem(KEY) || 'system'; } catch (e) { return 'system'; }
        }

        function apply(pref) {
            var theme = pref === 'system' ? (mq.matches ? 'dark' : 'light') : pref;
            var root = document.documentElement;
            root.setAttribute('data-theme', theme);
            root.setAttribute('data-bs-theme', theme);
        }

        apply(stored());

        function onSystemChange() { if (stored() === 'system') apply('system'); }
        if (mq.addEventListener) mq.addEventListener('change', onSystemChange);
        else if (mq.addListener) mq.addListener(onSystemChange);

        // keep other open tabs in sync
        window.addEventListener('storage', function (e) { if (e.key === 'ms-theme') apply(stored()); });

        window.msTheme = {
            get: stored,
            set: function (pref) {
                try { localStorage.setItem(KEY, pref); } catch (e) { }
                apply(pref);
            }
        };
    })();
</script>
</head>

<body>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="store-layout">

        <!-- ================= SIDEBAR ================= -->
        <aside class="sidebar" id="sidebar" aria-label="Main navigation">

<a asp-controller="@(isCustomer ? "CustomerPortal" : "Dashboard")"
   asp-action="Index"
   class="sidebar-brand">
    <div class="brand-icon">
        <i class="bi bi-shop"></i>
    </div>
    <div class="brand-text">
        <h5>Mini Store</h5>
        <small>@(isCustomer ? "Customer Portal" : "Management System")</small>
    </div>
</a>

<nav class="sidebar-nav">

 
@if (isCustomer)
{
    <div class="nav-section">My Account</div>

    <a asp-controller="CustomerPortal"
       asp-action="Index"
       class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CustomerPortal" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
        <span class="nav-icon">
            <i class="bi bi-house-door-fill"></i>
        </span>
        <span class="nav-label">Home</span>
    </a>

    <a asp-controller="CustomerPortal"
       asp-action="Products"
       class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CustomerPortal" && ViewContext.RouteData.Values["action"]?.ToString() == "Products" ? "active" : "")">
        <span class="nav-icon">
            <i class="bi bi-box-seam-fill"></i>
        </span>
        <span class="nav-label">Products</span>
    </a>

    <a asp-controller="CustomerPortal"
       asp-action="Purchases"
       class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CustomerPortal" && ViewContext.RouteData.Values["action"]?.ToString() == "Purchases" ? "active" : "")">
        <span class="nav-icon">
            <i class="bi bi-receipt"></i>
        </span>
        <span class="nav-label">My Purchases</span>
    </a>

    <a asp-controller="CustomerPortal"
       asp-action="Utang"
       class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CustomerPortal" && ViewContext.RouteData.Values["action"]?.ToString() == "Utang" ? "active" : "")">
        <span class="nav-icon">
            <i class="bi bi-wallet2"></i>
        </span>
               <span class="nav-label">My Credit</span>
    </a>

}
else if (isStoreUser)
{


          <div class="nav-section">Main</div>

                <a asp-controller="Dashboard" asp-action="Index"
                   class="sidebar-link @(Active("Dashboard"))">
                    <span class="nav-icon"><i class="bi bi-grid-1x2-fill"></i></span>
                    <span class="nav-label">Dashboard</span>
                </a>

                <div class="nav-section">Store</div>

                <a asp-controller="Sales" asp-action="Index"
                   class="sidebar-link @(Active("Sales"))">
                    <span class="nav-icon"><i class="bi bi-receipt"></i></span>
                    <span class="nav-label">Sales</span>
                </a>

                <a asp-controller="Customers" asp-action="Index"
                   class="sidebar-link @(Active("Customers"))">
                    <span class="nav-icon"><i class="bi bi-people-fill"></i></span>
                    <span class="nav-label">Customers</span>
                </a>

                <a asp-controller="Utang" asp-action="Index"
                   class="sidebar-link @(Active("Utang"))">
                    <span class="nav-icon"><i class="bi bi-cash-coin"></i></span>
                    <span class="nav-label">Credit Records</span>
                </a>

                @if (isAdmin)
                {
                    <div class="nav-section">Catalog</div>

                    <a asp-controller="Products" asp-action="Index"
                       class="sidebar-link @(Active("Products"))">
                        <span class="nav-icon"><i class="bi bi-box-seam-fill"></i></span>
                        <span class="nav-label">Products</span>
                    </a>

                    <a asp-controller="Categories" asp-action="Index"
                       class="sidebar-link @(Active("Categories"))">
                        <span class="nav-icon"><i class="bi bi-tags-fill"></i></span>
                        <span class="nav-label">Categories</span>
                    </a>

                    <a asp-controller="Inventory" asp-action="Index"
                       class="sidebar-link @(Active("Inventory"))">
                        <span class="nav-icon"><i class="bi bi-boxes"></i></span>
                        <span class="nav-label">Inventory</span>
                    </a>

                    <div class="nav-section">Administration</div>

                    <a asp-controller="Reports" asp-action="Index"
                       class="sidebar-link @(Active("Reports"))">
                        <span class="nav-icon"><i class="bi bi-bar-chart-line-fill"></i></span>
                        <span class="nav-label">Reports</span>
                    </a>

                    <a asp-controller="User" asp-action="Index"
                       class="sidebar-link @(Active("User"))">
                        <span class="nav-icon"><i class="bi bi-person-gear"></i></span>
                        <span class="nav-label">User Management</span>
                    </a>
                }
                }

            </nav>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="sidebar-footer">
                    <div class="user-card">
                        <div class="user-card-avatar">@avatarLetter</div>

                        <div class="user-card-info">
                            <strong title="@userName">@userName</strong>
                            <small>@userRole</small>
                        </div>

                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="user-card-logout" title="Logout" aria-label="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }

        </aside>


        <!-- ================= MAIN CONTENT ================= -->
        <main class="main-content">

            <!-- TOP BAR -->
            <header class="topbar" id="topbar">

                <div class="topbar-left">

                    <button class="sidebar-toggle" id="sidebarToggle" type="button"
                            aria-label="Toggle menu" aria-controls="sidebar" aria-expanded="false">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="page-heading">
                        <span class="page-label">Mini Store</span>
                        <h6>@ViewData["Title"]</h6>
                    </div>

                </div>

                <div class="topbar-right">

                    <div class="topbar-date">
                        <i class="bi bi-calendar3"></i>
                        <span>@DateTime.Now.ToString("ddd, MMM d, yyyy")</span>
                    </div>

@if (isStoreUser)
{
    @await Component.InvokeAsync("NotificationBell")
}
                  @if (isStoreUser){
 <a asp-controller="Settings" asp-action="Index" class="topbar-icon" title="Settings" aria-label="Settings">
    <i class="bi bi-gear-fill"></i>
</a>
}
                    <div class="topbar-divider"></div>

                    <!-- Profile dropdown -->
                    <div class="profile-dropdown">

                        <button type="button"
                                class="profile profile-button"
                                id="profileDropdownButton"
                                aria-haspopup="true"
                                aria-expanded="false">

                            <div class="profile-avatar">@avatarLetter</div>

                            <div class="profile-info">
                                <strong>@userName</strong>
                                <small>@userRole</small>
                            </div>

                            <i class="bi bi-chevron-down profile-arrow"></i>
                        </button>

                       <div class="profile-menu" id="profileMenu" role="menu">

    <div class="profile-menu-header">
        <div class="profile-avatar profile-avatar-lg">@avatarLetter</div>
        <div class="profile-menu-user">
            <strong title="@userName">@userName</strong>
            <small>@userRole</small>
        </div>
    </div>

          <a asp-controller="Profile" asp-action="Index"
       class="profile-menu-item" role="menuitem">
        <i class="bi bi-person-circle"></i>
        <span>My Profile</span>
    </a>

    @if (isStoreUser)
    {
        <a asp-controller="Settings" asp-action="Index"
           class="profile-menu-item" role="menuitem">
            <i class="bi bi-gear-fill"></i>
            <span>Settings</span>
        </a>
    }

    <div class="profile-menu-divider"></div>

    <form asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="profile-menu-item profile-logout" role="menuitem">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
        </button>
    </form>

</div>
                    </div>

                </div>

            </header>


            <!-- PAGE CONTENT -->
            <div class="content-container">

                @if (TempData["Success"] is string successMessage)
                {
                    <div class="flash flash-success" role="status">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>@successMessage</span>
                        <button type="button" class="flash-close" aria-label="Dismiss">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }

                @if (TempData["Error"] is string errorMessage)
                {
                    <div class="flash flash-error" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@errorMessage</span>
                        <button type="button" class="flash-close" aria-label="Dismiss">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }

                @RenderBody()

            </div>

@if (!isCustomer)
{
    <footer class="app-footer">
        <span>&copy; @DateTime.Now.Year Mini Store</span>
        <span>Management System</span>
    </footer>
}



        </main>

    </div>


    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            var sidebar  = document.getElementById('sidebar');
            var overlay  = document.getElementById('sidebarOverlay');
            var toggle   = document.getElementById('sidebarToggle');
            var topbar   = document.getElementById('topbar');
            var pdButton = document.getElementById('profileDropdownButton');
            var pdMenu   = document.getElementById('profileMenu');

            // ---- mobile sidebar ----
            function setSidebar(open) {
                sidebar.classList.toggle('open', open);
                overlay.classList.toggle('show', open);
                document.body.classList.toggle('no-scroll', open);
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            }

            toggle.addEventListener('click', function () {
                setSidebar(!sidebar.classList.contains('open'));
            });
            overlay.addEventListener('click', function () { setSidebar(false); });

            sidebar.querySelectorAll('.sidebar-link').forEach(function (link) {
                link.addEventListener('click', function () { setSidebar(false); });
            });

            // ---- profile dropdown ----
            function setMenu(open) {
                pdMenu.classList.toggle('show', open);
                pdButton.setAttribute('aria-expanded', open ? 'true' : 'false');
            }

            pdButton.addEventListener('click', function (e) {
                e.stopPropagation();
                setMenu(!pdMenu.classList.contains('show'));
            });

            document.addEventListener('click', function (e) {
                if (!pdMenu.contains(e.target)) setMenu(false);
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') { setMenu(false); setSidebar(false); }
            });

            // ---- topbar shadow on scroll ----
            function onScroll() { topbar.classList.toggle('scrolled', window.scrollY > 4); }
            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll();

            // ---- flash messages ----
            function dismiss(el) {
                el.classList.add('hide');
                setTimeout(function () { el.remove(); }, 300);
            }

            document.querySelectorAll('.flash').forEach(function (el) {
                el.querySelector('.flash-close').addEventListener('click', function () { dismiss(el); });
                if (el.classList.contains('flash-success')) {
                    setTimeout(function () { if (el.isConnected) dismiss(el); }, 5000);
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>