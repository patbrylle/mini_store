@model int

<a asp-controller="Notification"
   asp-action="Index"
   class="topbar-icon notification-button"
   title="Notifications">

    <i class="bi bi-bell"></i>

    @if (Model > 0)
    {
        <span class="notification-badge">
            @(Model > 99 ? "99+" : Model.ToString())
        </span>
    }

</a>
